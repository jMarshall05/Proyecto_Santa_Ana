<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Santa Ana a un Click</title>
    <link rel="icon" type="image/png" href="https://santaana.ed.cr/wp-content/uploads/LOGO-1.png" />
    <link href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" rel="stylesheet">

    <link href="~/Content/styles.css" rel="stylesheet" />
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    @RenderSection("styles", required: false)

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">

    <style>
        .sidebar {
            height: 100%;
            width: 0;
            position: fixed;
            z-index: 1000;
            top: 0;
            right: 0;
            background-color: #333;
            overflow-x: hidden;
            transition: 0.4s;
            padding-top: 60px;
        }

            .sidebar a {
                padding: 12px 24px;
                text-decoration: none;
                font-size: 18px;
                color: #f1f1f1;
                display: block;
                transition: 0.3s;
            }

                .sidebar a:hover {
                    background-color: #575757;
                }

            .sidebar .closebtn {
                position: absolute;
                top: 10px;
                right: 20px;
                font-size: 30px;
            }
    </style>
</head>

<body>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm" style="background-color: #F44336; border-color: #F44336; color: white;">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Index", "Home")">
                <img src="https://santaana.ed.cr/wp-content/uploads/LOGO-1.png" alt="Logo" style="height: 65px;" />
            </a>
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Alternar navegación" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">

                    @*@if (User.IsInRole("Administradores"))
        {*@
                    <li class="nav-item">@Html.ActionLink("Gestion de Usuarios", "ListarUsuarios", "Usuarios", null, new { @class = "nav-link", style = "color: white;" })</li>
                    <li class="nav-item">@Html.ActionLink("Gestion de Grupos", "ListarGrupos", "Grupos", null, new { @class = "nav-link", style = "color: white;" })</li>
                    <li class="nav-item">@Html.ActionLink("Administrar Anuncios", "ListarAnuncios", "Anuncios", null, new { @class = "nav-link", style = "color: white;" })</li>
                    <li class="nav-item">@Html.ActionLink("Administrar Cursos", "ListarCursos", "Cursos", null, new { @class = "nav-link", style = "color: white;" })</li>

                    @*}*@

                    @*@if (User.IsInRole("Profesores") || User.IsInRole("Administradores"))
        {*@
                    <li class="nav-item">@Html.ActionLink("Asignar Tarea", "ListarTareas", "Tareas", null, new { @class = "nav-link", style = "color: white;" })</li>
                    <li class="nav-item">@Html.ActionLink("Tareas recibidas", "Index", "Entregas", null, new { @class = "nav-link", style = "color: white;" })</li>
                    @*}*@

                    @if (User.IsInRole("Estudiantes"))
                    {
                        <li class="nav-item">@Html.ActionLink("Mis Tareas", "MisTareas", "Tareas", null, new { @class = "nav-link", style = "color: white;" })</li>
                    }
                </ul>

                <div class="d-flex align-items-center">

                    @Html.Partial("_LoginPartial")
                    @* Botón para abrir el sidebar *@
                    <div style="color: white; cursor: pointer; margin-left: 15px;" onclick="toggleSidebar()">
                        <i class="fa-solid fa-bars fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>
    </nav>
    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - Santa Ana a un Click</p>
        </footer>
    </div>

    @* Sidebar oculto *@
    <div id="mySidebar" class="sidebar">
        <a href="javascript:void(0)" class="closebtn" onclick="toggleSidebar()">&times;</a>
        <a href="@Url.Action("AnunciosEstudiantes", "Anuncios")">Anuncios</a>
        <a href="@Url.Action("MisCalificaciones", "Calificaciones")">Calificaciones</a>
        <a href="@Url.Action("Documentos", "Home")">Documentos</a>
        <a href="@Url.Action("VerDocentesAdministrativos", "Usuarios")">Contactos</a>
        <a href="@Url.Action("About", "Home")">Calendario</a>
        <a href="https://santaana.ed.cr/" target="_blank">Sobre Nosotros</a>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Scripts/datatable/dataTables.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.1/moment.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datetimepicker/4.17.47/js/bootstrap-datetimepicker.min.js"></script>

    <script>
        function toggleSidebar() {
            var sidebar = document.getElementById("mySidebar");
            sidebar.style.width = sidebar.style.width === "250px" ? "0" : "250px";
        }
    </script>

    @RenderSection("scripts", required: false)
</body>
</html>
