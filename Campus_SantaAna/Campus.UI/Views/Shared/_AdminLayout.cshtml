@* _AdminLayout.cshtml *@
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link rel="stylesheet" href="~/Content/bootstrap.min.css" />
    <style>
        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            box-sizing: border-box;
            font-family: sans-serif;
        }

        .admin-dashboard {
            display: flex;
            width: 100%;
            min-height: 100vh;
        }

        .sidebar-admin {
            width: 220px;
            background: #0D126E;
            color: white;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding-top: 20px;
            position: fixed;
            top: 0;
            left: 0;
            height: 100vh;
        }

            .sidebar-admin .logo {
                display: flex;
                flex-direction: column;
                align-items: center;
                text-align: center;
                margin-bottom: 20px;
            }

                .sidebar-admin .logo img {
                    width: 80px;
                    height: auto;
                    margin-bottom: 10px;
                }

            .sidebar-admin h4 {
                margin-bottom: 20px;
                text-align: center;
                font-size: 20px;
            }

            .sidebar-admin .menu {
                list-style: none;
                padding: 0;
                width: 100%;
            }

                .sidebar-admin .menu li a, .sidebar-admin .menu li button {
                    color: white;
                    padding: 15px;
                    display: block;
                    text-decoration: none;
                    font-size: 16px;
                    width: 100%;
                    text-align: left;
                    background: none;
                    border: none;
                }

                    .sidebar-admin .menu li a:hover, .sidebar-admin .menu li button:hover {
                        background: #1E2A8C;
                        cursor: pointer;
                    }

        .content-admin {
            margin-left: 220px;
            flex: 1;
            padding: 30px;
            min-height: 100vh;
            background: #f5f5f5;
        }

            .content-admin header {
                text-align: right;
                margin-bottom: 30px;
                font-size: 20px;
            }
    </style>
</head>
<body>
    <div class="admin-dashboard">
        <aside class="sidebar-admin">
            <div class="logo">
                <a href="@Url.Action("Index", "Home")">
                    <img src="https://santaana.ed.cr/wp-content/uploads/LOGO-1.png" alt="Logo" />
                </a>
                <h4>Panel Administrador</h4>
            </div>

            <ul class="menu">
                <li><a href="@Url.Action("ListarUsuarios", "Usuarios")"><i class="fas fa-user"></i> Usuarios</a></li>
                <li><a href="@Url.Action("ListarCursos", "Cursos")"><i class="fas fa-book"></i> Cursos</a></li>
                <li><a href="@Url.Action("ListarGrupos", "Grupos")"><i class="fas fa-users"></i> Grupos</a></li>
                <li><a href="@Url.Action("ListarAnuncios", "Anuncios")"><i class="fas fa-bullhorn"></i> Anuncios</a></li>
                <li><a href="@Url.Action("Documentos", "Home")"><i class="fas fa-file-alt"></i> Documentos</a></li>
                <li><a href="@Url.Action("VerDocentesAdministrativos", "Usuarios")"><i class="fas fa-phone"></i> Contactos</a></li>
                <li><a href="@Url.Action("About", "Home")"><i class="fas fa-calendar"></i> Calendario</a></li>
           
                @using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm" }))
                {
                    @Html.AntiForgeryToken()
                    <li>
                        <button type="submit"><i class="fas fa-sign-out-alt"></i> Cerrar sesión</button>
                    </li>
                }
            </ul>
        </aside>

        <main class="content-admin">
            <header>
                <h2>Hola @User.Identity.Name!</h2>
            </header>

            @RenderBody()
        </main>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Scripts/datatable/dataTables.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.1/moment.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datetimepicker/4.17.47/js/bootstrap-datetimepicker.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
