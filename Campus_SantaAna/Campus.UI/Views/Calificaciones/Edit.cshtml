@model Campus.Abstracciones.ModelosUI.CalificacionesDto

@{
    ViewBag.Title = "Editar Calificación";
}

<div class="card shadow-sm">
    <div class="card-header bg-warning text-white">
        <h3 class="card-title mb-0">
            <i class="fas fa-edit mr-2"></i> Editar Calificación
        </h3>
    </div>

    @using (Html.BeginForm("Edit", "Calificaciones", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        @Html.HiddenFor(m => m.id_calificacion)
        @Html.HiddenFor(m => m.id_entrega)
        @Html.HiddenFor(m => m.fecha_calificacion)
        <div class="card-body">

            <div class="mb-3">
                @Html.LabelFor(m => m.calificacion, new { @class = "form-label" })
                @Html.EditorFor(m => m.calificacion, new
                {
                    @class = "form-control",
                    type = "number",
                    min = "0",
                    max = "100",
                    required = "required"
                })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.comentario, new { @class = "form-label" })
                @Html.TextAreaFor(m => m.comentario, new { @class = "form-control", rows = "3" })
            </div>

        </div>

        <div class="card-footer bg-light d-flex justify-content-between">
            @Html.ActionLink("Volver al listado", "Index", "Entregas", null, new { @class = "btn btn-secondary" })

            <button type="submit" class="btn btn-success">
                <i class="fas fa-save me-1"></i> Guardar Cambios
            </button>
        </div>
    }
</div>
