@{
    ViewBag.Title = "Confirmación de contraseña olvidada";
}

<main aria-labelledby="title" class="forgot-password-confirmation">
    <div class="confirmation-container">
        <div class="icon-wrapper">
            <svg class="success-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
        </div>

        <hgroup class="title-group">
            <h1 id="title">@ViewBag.Title</h1>
            <p class="subtitle">Solicitud enviada correctamente</p>
        </hgroup>

        <div class="message-content">
            <p class="primary-message">
                Hemos enviado un enlace de restablecimiento a tu correo electrónico.
            </p>
            <p class="secondary-message">
                Por favor, revisa tu bandeja de entrada y sigue las instrucciones para crear una nueva contraseña.
            </p>
        </div>

        <div class="additional-info">
            <div class="info-card">
                <strong>¿No recibes el correo?</strong>
                <ul>
                    <li>Revisa tu carpeta de spam o correo no deseado</li>
                    <li>Verifica que la dirección de correo sea correcta</li>
                    <li>El enlace expirará en 24 horas</li>
                </ul>
            </div>
        </div>
    </div>
</main>

<style>
    .forgot-password-confirmation {
        max-width: 600px;
        margin: 3rem auto;
        padding: 2rem 1rem;
    }

    .confirmation-container {
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
        padding: 3rem 2rem;
        text-align: center;
    }

    .icon-wrapper {
        margin-bottom: 2rem;
    }

    .success-icon {
        width: 80px;
        height: 80px;
        color: #28a745;
        margin: 0 auto;
        animation: checkmark 0.5s ease-in-out;
    }

    @@keyframes checkmark {
        0% {
            transform: scale(0);
            opacity: 0;
        }
        50% {
            transform: scale(1.1);
        }
        100% {
            transform: scale(1);
            opacity: 1;
        }
    }

    .title-group {
        margin-bottom: 2rem;
    }

    .title-group h1 {
        font-size: 1.75rem;
        color: #333;
        margin-bottom: 0.5rem;
        font-weight: 600;
    }

    .subtitle {
        font-size: 1rem;
        color: #28a745;
        margin: 0;
        font-weight: 500;
    }

    .message-content {
        margin-bottom: 2rem;
        padding: 0 1rem;
    }

    .primary-message {
        font-size: 1.1rem;
        color: #495057;
        margin-bottom: 1rem;
        font-weight: 500;
        line-height: 1.6;
    }

    .secondary-message {
        font-size: 0.95rem;
        color: #6c757d;
        line-height: 1.6;
        margin: 0;
    }

    .additional-info {
        margin-top: 2.5rem;
    }

    .info-card {
        background: #f8f9fa;
        border-left: 4px solid #007bff;
        padding: 1.5rem;
        text-align: left;
        border-radius: 4px;
    }

    .info-card strong {
        display: block;
        margin-bottom: 0.75rem;
        color: #333;
        font-size: 1rem;
    }

    .info-card ul {
        margin: 0;
        padding-left: 1.25rem;
        list-style: none;
    }

    .info-card ul li {
        position: relative;
        padding-left: 1.5rem;
        margin-bottom: 0.5rem;
        color: #6c757d;
        font-size: 0.9rem;
        line-height: 1.5;
    }

    .info-card ul li:before {
        content: "•";
        position: absolute;
        left: 0;
        color: #007bff;
        font-weight: bold;
        font-size: 1.2rem;
    }

    .info-card ul li:last-child {
        margin-bottom: 0;
    }

    @@media (max-width: 576px) {
        .forgot-password-confirmation {
            margin: 1.5rem auto;
            padding: 1rem;
        }

        .confirmation-container {
            padding: 2rem 1.5rem;
        }

        .title-group h1 {
            font-size: 1.5rem;
        }

        .success-icon {
            width: 60px;
            height: 60px;
        }
    }
</style>