@model Campus.UI.Models.ResetPasswordViewModel
@{
    ViewBag.Title = "Restablecer contraseña";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title</title>
    <link rel="icon" type="image/png" href="~/Content/logo_SantaAna.ico" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>
        body, html {
            height: 100%;
            margin: 0;
            font-family: 'Segoe UI', sans-serif;
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        }

        .main-container {
            display: flex;
            min-height: 100vh;
        }

        .left-panel {
            flex: 1;
            background: linear-gradient(135deg, #F44336 0%, #d32f2f 100%);
            display: flex;
            justify-content: center;
            align-items: center;
        }

            .left-panel img {
                width: 280px;
                height: auto;
                transition: transform 0.3s ease;
            }

                .left-panel img:hover {
                    transform: scale(1.05);
                }

        .right-panel {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .reset-box {
            width: 85%;
            max-width: 450px;
            background-color: #ffffff;
            padding: 3rem;
            border-radius: 1.2rem;
            box-shadow: 0 20px 50px rgba(0,0,0,0.15);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

            .reset-box:hover {
                transform: translateY(-5px);
                box-shadow: 0 25px 60px rgba(0,0,0,0.2);
            }

            .reset-box h2 {
                text-align: center;
                font-weight: 700;
                color: #1a1a40;
                margin-bottom: 0.25rem;
                font-size: 1.85rem;
            }

        .subtitle {
            text-align: center;
            font-size: 0.95rem;
            color: #6c757d;
            margin-bottom: 2rem;
        }

        .form-label {
            font-weight: 600;
            color: #1a1a40;
            margin-bottom: 0.5rem;
        }

        .form-control {
            border-radius: 12px;
            border: 2px solid #1a1a40;
            padding: 0.75rem 1rem;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                border-color: #2c4bc4;
                box-shadow: 0 0 12px rgba(44, 75, 196, 0.3);
            }

        .password-container {
            position: relative;
        }

        .toggle-password {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            color: #6c757d;
            transition: color 0.3s ease;
        }

            .toggle-password:hover {
                color: #2c4bc4;
            }

        .password-requirements {
            background: #f8f9fa;
            border-left: 4px solid #2c4bc4;
            padding: 1rem;
            margin: 1.5rem 0;
            border-radius: 0.6rem;
        }

            .password-requirements strong {
                display: block;
                margin-bottom: 0.5rem;
                color: #1a1a40;
                font-size: 0.9rem;
            }

            .password-requirements ul {
                margin: 0;
                padding-left: 1rem;
            }

            .password-requirements li {
                position: relative;
                padding-left: 1.5rem;
                margin-bottom: 0.4rem;
                color: #6c757d;
                font-size: 0.85rem;
            }

                .password-requirements li:before {
                    content: "•";
                    position: absolute;
                    left: 0;
                    color: #2c4bc4;
                    font-weight: bold;
                }

        .btn-reset {
            width: 100%;
            background: linear-gradient(90deg, #2c4bc4, #1e3a9e);
            border: none;
            font-weight: bold;
            border-radius: 25px;
            padding: 12px;
            color: white;
            margin-top: 1rem;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

            .btn-reset:hover {
                transform: translateY(-3px);
                box-shadow: 0 8px 20px rgba(30,58,158,0.4);
                background: linear-gradient(90deg, #1e3a9e, #16286f);
            }

        .text-danger {
            font-size: 0.85rem;
            margin-top: 0.25rem;
        }

        .validation-summary-errors {
            background-color: #f8d7da;
            border: 1px solid #f5c2c7;
            border-radius: 0.5rem;
            padding: 1rem;
            margin-bottom: 1.5rem;
        }

            .validation-summary-errors ul {
                margin: 0;
                padding-left: 1.25rem;
            }

        .text-link {
            text-align: center;
            margin-top: 1rem;
            font-size: 0.9rem;
        }

            .text-link a {
                text-decoration: none;
                font-weight: 600;
                color: #F44336;
            }

                .text-link a:hover {
                    text-decoration: underline;
                }

        @@media (max-width: 768px) {
            .main-container {
                flex-direction: column;
            }

            .left-panel {
                flex: 0 0 30%;
            }

                .left-panel img {
                    width: 150px;
                }

            .reset-box {
                padding: 2rem 1.5rem;
            }

                .reset-box h2 {
                    font-size: 1.5rem;
                }
        }
    </style>
</head>
<body>
    <div class="main-container">
        <div class="left-panel">
            <img src="~/Content/logo_SantaAna.jpg" alt="Logo Colegio Santa Ana" />
        </div>

        <div class="right-panel">
            <div class="reset-box">
                <h2>@ViewBag.Title</h2>
                <p class="subtitle">Ingresa tu nueva contraseña</p>

                @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post, new { role = "form" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary("", new { @class = "text-danger validation-summary-errors" })
                    @Html.HiddenFor(model => model.Code)
                    @Html.HiddenFor(model => model.Id)

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Password, new { @class = "form-label" })
                        <div class="password-container">
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Nueva contraseña", id = "password" })
                            <i class="fas fa-eye toggle-password" id="togglePassword"></i>
                        </div>
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.ConfirmPassword, new { @class = "form-label" })
                        <div class="password-container">
                            @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Confirma tu contraseña", id = "confirmPassword" })
                            <i class="fas fa-eye toggle-password" id="toggleConfirmPassword"></i>
                        </div>
                        @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
                    </div>

                    <div class="password-requirements">
                        <strong>Requisitos de la contraseña:</strong>
                        <ul>
                            <li>Mínimo 15 caracteres</li>
                            <li>Al menos una letra mayúscula</li>
                            <li>Al menos una letra minúscula</li>
                            <li>Al menos un número</li>
                            <li>Al menos un carácter especial (@@, #, $, etc.)</li>
                        </ul>
                    </div>

                    <input type="submit" class="btn btn-reset" value="Restablecer contraseña" />

                    <div class="text-link">
                        ¿Recordaste tu contraseña? <a href="@Url.Action("Login", "Account")">Inicia sesión</a>
                    </div>
                }
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.12/dist/jquery.validate.unobtrusive.min.js"></script>

    <script>
        // Toggle password visibility
        function togglePassword(inputId, toggleId) {
            document.getElementById(toggleId).addEventListener('click', function () {
                const input = document.getElementById(inputId);
                const type = input.getAttribute('type') === 'password' ? 'text' : 'password';
                input.setAttribute('type', type);
                this.classList.toggle('fa-eye');
                this.classList.toggle('fa-eye-slash');
            });
        }
        togglePassword('password', 'togglePassword');
        togglePassword('confirmPassword', 'toggleConfirmPassword');
    </script>
</body>
</html>
