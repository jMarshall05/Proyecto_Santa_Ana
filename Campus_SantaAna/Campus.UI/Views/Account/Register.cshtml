@model Campus.UI.Models.RegisterViewModel

@{
    ViewBag.Title = "Registro de Usuarios";
    var fechaMaxima = DateTime.Now.ToString("yyyy-MM-dd");
    Layout = null;
    <link rel="icon" type="image/png" href="https://santaana.ed.cr/wp-content/uploads/LOGO-1.png" />
    @Styles.Render("~/Content/css")
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body, html {
            height: 100%;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        .main-container {
            display: flex;
            min-height: 100vh;
            align-items: center;
            justify-content: center;
            padding: 2rem;
        }

        .register-card {
            display: flex;
            max-width: 1100px;
            width: 100%;
            background: white;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        }

        .left-panel {
            flex: 1;
            background: linear-gradient(135deg, #F07059 0%, #e63946 100%);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 3rem;
            color: white;
            position: relative;
            overflow: hidden;
        }

        .left-panel::before {
            content: '';
            position: absolute;
            width: 300px;
            height: 300px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            top: -100px;
            right: -100px;
        }

        .left-panel::after {
            content: '';
            position: absolute;
            width: 200px;
            height: 200px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            bottom: -50px;
            left: -50px;
        }

        .left-panel img {
            width: 200px;
            height: auto;
            margin-bottom: 2rem;
            filter: drop-shadow(0 10px 20px rgba(0, 0, 0, 0.2));
            position: relative;
            z-index: 1;
        }

        .left-panel h1 {
            font-size: 2rem;
            font-weight: 700;
            text-align: center;
            margin-bottom: 1rem;
            position: relative;
            z-index: 1;
        }

        .left-panel p {
            text-align: center;
            opacity: 0.9;
            font-size: 1rem;
            position: relative;
            z-index: 1;
        }

        .right-panel {
            flex: 1.2;
            padding: 3rem;
            overflow-y: auto;
            max-height: 90vh;
        }

        .right-panel::-webkit-scrollbar {
            width: 8px;
        }

        .right-panel::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 10px;
        }

        .right-panel::-webkit-scrollbar-thumb {
            background: #F07059;
            border-radius: 10px;
        }

        .register-box {
            width: 100%;
        }

        .register-box h2 {
            color: #2d3748;
            font-weight: 700;
            margin-bottom: 0.5rem;
            font-size: 1.8rem;
            text-align: center;
        }

        .subtitle {
            color: #718096;
            margin-bottom: 2rem;
            font-size: 0.95rem;
            text-align: center;
        }

        .mb-3 {
            margin-bottom: 1.5rem;
        }

        label, h5 {
            display: block;
            margin-bottom: 0.5rem;
            color: #4a5568;
            font-weight: 600;
            font-size: 0.9rem;
        }

        .input-wrapper {
            position: relative;
        }

        .input-icon {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #a0aec0;
            pointer-events: none;
            z-index: 1;
        }

        .form-control {
            width: 100%;
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            padding: 12px 15px 12px 45px;
            font-size: 0.95rem;
            transition: all 0.3s ease;
            background-color: white;
        }

        .form-control:focus {
            border-color: #F07059;
            box-shadow: 0 0 0 3px rgba(240, 112, 89, 0.1);
            outline: none;
        }

        .form-control::placeholder {
            color: #a0aec0;
        }

        .phone-section {
            background: #f7fafc;
            padding: 1.5rem;
            border-radius: 12px;
            margin-bottom: 1.5rem;
        }

        .phone-section h5 {
            color: #2d3748;
            font-weight: 600;
            margin-bottom: 1rem;
            font-size: 1rem;
        }

        .row.mb-2 {
            margin-bottom: 10px;
        }

        .col-md-3 .form-control,
        .col-md-5 .form-control {
            padding: 10px 12px;
        }

        #addTelefono {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 10px;
            font-weight: 600;
            font-size: 0.9rem;
            cursor: pointer;
            transition: transform 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        #addTelefono:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
        }

        .btn-register {
            width: 100%;
            background: linear-gradient(135deg, #F07059 0%, #e63946 100%);
            border: none;
            color: white;
            padding: 14px;
            border-radius: 12px;
            font-weight: 700;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-top: 1rem;
        }

        .btn-register:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(240, 112, 89, 0.4);
        }

        .text-danger {
            color: #e53e3e;
            font-size: 0.85rem;
            margin-top: 0.3rem;
            display: block;
        }

        .validation-summary-errors {
            background-color: #fff5f5;
            border: 1px solid #fc8181;
            border-radius: 8px;
            padding: 1rem;
            margin-bottom: 1rem;
        }

        .validation-summary-errors ul {
            margin: 0;
            padding-left: 1.5rem;
        }

        .validation-summary-errors li {
            color: #e53e3e;
        }

        @@media (max-width: 968px) {
            .register-card {
                flex-direction: column;
            }

            .left-panel {
                padding: 2rem;
            }

            .left-panel h1 {
                font-size: 1.5rem;
            }

            .right-panel {
                padding: 2rem;
                max-height: none;
            }
        }

        @@media (max-width: 576px) {
            .main-container {
                padding: 1rem;
            }

            .right-panel {
                padding: 1.5rem;
            }

            .register-box h2 {
                font-size: 1.5rem;
            }
        }
    </style>
</head>

<body>
    <div class="main-container">
        <div class="register-card">
            <div class="left-panel">
                <img src="https://santaana.ed.cr/wp-content/uploads/LOGO-1.png" alt="Logo Colegio Santa Ana" />
                <h1>Bienvenido</h1>
                <p>Únete a nuestra comunidad educativa y comienza tu camino hacia el éxito</p>
            </div>

            <div class="right-panel">
                <div class="register-box">
                    <h2>@ViewBag.Title</h2>
                    <p class="subtitle">Completa el formulario para registrarte</p>

                    @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { role = "form" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary("", new { @class = "text-danger" })

                        <div class="mb-3">
                            <label>Nombre</label>
                            <div class="input-wrapper">
                                <i class="fas fa-user input-icon"></i>
                                @Html.TextBoxFor(m => m.Nombre, new
                                {
                                    @class = "form-control",
                                    placeholder = "Tu nombre",
                                    pattern = "^[a-zA-ZáéíóúÁÉÍÓÚñÑ\\s]+$",
                                    maxlength = "150",
                                    required = "required",
                                    oninput = "this.value = this.value.replace(/[^a-zA-ZáéíóúÁÉÍÓÚñÑ ]/g, '')"
                                })
                            </div>
                            @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            <label>Apellido</label>
                            <div class="input-wrapper">
                                <i class="fas fa-user input-icon"></i>
                                @Html.TextBoxFor(m => m.Apellido, new
                                {
                                    @class = "form-control",
                                    placeholder = "Tu apellido",
                                    pattern = "^[a-zA-ZáéíóúÁÉÍÓÚñÑ\\s]+$",
                                    maxlength = "150",
                                    required = "required",
                                    oninput = "this.value = this.value.replace(/[^a-zA-ZáéíóúÁÉÍÓÚñÑ ]/g, '')"
                                })
                            </div>
                            @Html.ValidationMessageFor(m => m.Apellido, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            <label>Correo Electrónico</label>
                            <div class="input-wrapper">
                                <i class="fas fa-envelope input-icon"></i>
                                @Html.TextBoxFor(m => m.Email, new
                                {
                                    @class = "form-control",
                                    type = "email",
                                    placeholder = "tu@email.com",
                                    maxlength = "150",
                                    required = "required"
                                })
                            </div>
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                        </div>

                        <div class="phone-section">
                            <h5><i class="fas fa-phone"></i> Teléfonos</h5>
                            <div id="telefonosContainer">
                                <div class="row mb-2">
                                    <input type="hidden" name="Telefonos[0].Id" value="0" />
                                    <div class="col-md-3">
                                        <input type="text" name="Telefonos[0].Codigo" class="form-control"
                                               maxlength="4" placeholder="Código País (ej: +506)"
                                               required oninput="let val=this.value.replace(/[^0-9]/g,''); this.value=val.length>0? '+'+val.substring(0,3):'';" />
                                    </div>
                                    <div class="col-md-5">
                                        <input type="text" name="Telefonos[0].Telefono" class="form-control"
                                               placeholder="Número" required
                                               oninput="this.value=this.value.replace(/[^0-9]/g,'')"
                                               minlenght="8"
                                               maxlength="8"/>
                                    </div>
                                    <div class="col-md-3">
                                        <select name="Telefonos[0].Tipo" class="form-control" required>
                                            <option value="">Seleccione un tipo</option>
                                            <option value="Personal">Personal</option>
                                            <option value="Trabajo">Trabajo</option>
                                            <option value="Hogar">Hogar</option>
                                            <option value="Encargado">Encargado</option>
                                            <option value="Otro">Otro</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <button type="button" id="addTelefono" class="btn btn-primary mt-2">
                                <i class="fas fa-plus"></i> Agregar Teléfono
                            </button>
                        </div>

                        <div class="mb-3">
                            <label>Cédula</label>
                            <div class="input-wrapper">
                                <i class="fas fa-id-card input-icon"></i>
                                @Html.TextBoxFor(m => m.Cedula, new
                                {
                                    @class = "form-control",
                                    minlength = "9",
                                    maxlength = "9",
                                    placeholder = "Número de cédula",
                                    oninput = "this.value = this.value.replace(/[^0-9]/g, '')"
                                })
                            </div>
                            @Html.ValidationMessageFor(m => m.Cedula, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            <label>Fecha de Nacimiento</label>
                            <div class="input-wrapper">
                                <i class="fas fa-calendar input-icon"></i>
                                @Html.TextBoxFor(m => m.FechaDeNacimiento, "{0:yyyy-MM-dd}", new
                                {
                                    @class = "form-control",
                                    type = "date",
                                    max = fechaMaxima,
                                    placeholder = "Fecha de Nacimiento"
                                })
                            </div>
                            @Html.ValidationMessageFor(m => m.FechaDeNacimiento, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            <label>Rol</label>
                            <div class="input-wrapper">
                                <i class="fas fa-user-tag input-icon"></i>
                                @Html.DropDownListFor(m => m.Rol, new List<SelectListItem>
                                {
                                    new SelectListItem { Text = "Estudiante", Value = "Estudiantes" },
                                    new SelectListItem { Text = "Profesor", Value = "Profesores" },
                                    new SelectListItem { Text = "Administrador", Value = "Administradores" }
                                }, "Seleccione un tipo de Rol", new { @class = "form-control", id = "Rol", required = "required" })
                            </div>
                            @Html.ValidationMessageFor(m => m.Rol, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            <label>Contraseña</label>
                            <div class="input-wrapper">
                                <i class="fas fa-lock input-icon"></i>
                                @Html.PasswordFor(m => m.Password, new
                                {
                                    @class = "form-control",
                                    placeholder = "Crea una contraseña segura"
                                })
                            </div>
                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            <label>Confirmar Contraseña</label>
                            <div class="input-wrapper">
                                <i class="fas fa-lock input-icon"></i>
                                @Html.PasswordFor(m => m.ConfirmPassword, new
                                {
                                    @class = "form-control",
                                    placeholder = "Confirma tu contraseña"
                                })
                            </div>
                            @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            <input type="submit" value="Registrarse" class="btn btn-register" />
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <script>
        let phoneIndex = 1; // ya tenemos un teléfono inicial

        document.getElementById('addTelefono').addEventListener('click', function () {
            const container = document.getElementById('telefonosContainer');

            const div = document.createElement('div');
            div.className = 'row mb-2';
            div.innerHTML = `
                    <input type="hidden" name="Telefonos[${phoneIndex}].Id" value="0" />
                    <div class="col-md-3">
                        <input type="text" name="Telefonos[${phoneIndex}].Codigo" class="form-control"
                               maxlength="4" placeholder="Código País (ej: +506)"
                               required oninput="let val=this.value.replace(/[^0-9]/g,''); this.value=val.length>0? '+'+val.substring(0,3):'';" />
                    </div>
                    <div class="col-md-5">
                        <input type="text" name="Telefonos[${phoneIndex}].Telefono" class="form-control"
                               placeholder="Número" required
                               oninput="this.value=this.value.replace(/[^0-9]/g,'')"
                               minlenght="8"
                                maxlength="8"/>
                    </div>
                    <div class="col-md-3">
                        <select name="Telefonos[${phoneIndex}].Tipo" class="form-control" required>
                            <option value="">Seleccione un tipo</option>
                            <option value="Personal">Personal</option>
                            <option value="Trabajo">Trabajo</option>
                            <option value="Hogar">Hogar</option>
                            <option value="Encargado">Encargado</option>
                            <option value="Otro">Otro</option>
                        </select>
                    </div>
                `;

            container.appendChild(div);
            phoneIndex++;
        });
    </script>
</body>
</html>