@model Campus.UI.Models.ForgotPasswordViewModel
@{
    ViewBag.Title = "¿Olvidó su contraseña?";
    Layout = null;
    <link rel="icon" type="image/png" href="https://santaana.ed.cr/wp-content/uploads/LOGO-1.png" />
    @Styles.Render("~/Content/css")
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>
        body, html {
            height: 100%;
            margin: 0;
            font-family: 'Segoe UI', sans-serif;
        }

        .main-container {
            display: flex;
            height: 100vh;
        }

        .left-panel {
            flex: 1;
            background-color: #F44336;
            display: flex;
            justify-content: center;
            align-items: center;
        }

            .left-panel img {
                width: 300px;
                height: auto;
            }

        .right-panel {
            flex: 1;
            background-color: #f9f9f9;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .login-box {
            width: 80%;
            max-width: 400px;
            background-color: #ffffff;
            padding: 2rem;
            border-radius: 1rem;
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.2);
            display: flex;
            flex-direction: column;
            align-items: center;
        }

            .login-box h2 {
                text-align: center;
                font-weight: bold;
                margin-bottom: 30px;
                color: black;
            }

        .form-control {
            border-radius: 10px;
            border: 2px solid #1a1a40;
        }

        .btn-login {
            width: 100%;
            background-color: #2c4bc4;
            border: none;
            font-weight: bold;
            border-radius: 20px;
            padding: 10px;
            color: white;
        }

            .btn-login:hover {
                background-color: #2c4bc4;
            }

        .text-link {
            text-align: center;
            margin-top: 10px;
            font-size: 0.9em;
        }

            .text-link a {
                text-decoration: none;
                font-weight: bold;
                color: #F44336;
            }

        .password-container {
            position: relative;
        }
    </style>
</head>
<body>
    <div class="main-container">
        <div class="left-panel">
            <img src="https://santaana.ed.cr/wp-content/uploads/LOGO-1.png" alt="Logo Colegio Santa Ana" />
        </div>

        <div class="right-panel">
            <div class="login-box">
                <h2>@ViewBag.Title</h2>

                @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { role = "form" }))
                {
                    @Html.AntiForgeryToken()
                    <p class="text-center">Especifique su correo electrónico.</p>
                    <hr />
                    @Html.ValidationSummary("", new { @class = "text-danger" })

                    <div class="mb-3">
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "Correo electrónico" })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                    </div>

                    <div class="mb-3">
                        <input type="submit" class="btn btn-login" value="Vínculo de correo electrónico" />
                    </div>

                    <div class="text-link">
                        ¿Ya tiene una cuenta? <a href="@Url.Action("Login", "Account")">Inicie sesión</a>
                    </div>
                }
            </div>
        </div>
    </div>

    @Scripts.Render("~/bundles/jqueryval")
</body>
</html>
