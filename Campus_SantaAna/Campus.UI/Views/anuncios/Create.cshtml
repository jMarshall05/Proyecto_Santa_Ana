@model Campus.Abstracciones.ModelosUI.AnuncioDto

@{
    ViewBag.Title = "Publicar Anuncio";
}

<div class="form-container">
    <h2>Publicar Nuevo Anuncio</h2>

    @using (Html.BeginForm("Create", "Anuncios", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="mb-3">
            @Html.TextBoxFor(m => m.Titulo, new { @class = "form-control", placeholder = "Título del Anuncio", required = "required" })
            @Html.ValidationMessageFor(m => m.Titulo, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            @Html.TextAreaFor(m => m.Descripcion, new { @class = "form-control", rows = 5, placeholder = "Descripción del Anuncio", required = "required" })
            @Html.ValidationMessageFor(m => m.Descripcion, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            <label>Fecha del Evento</label>
            @Html.TextBoxFor(m => m.FechaEvento, new { @class = "form-control", type = "datetime-local", required = "required" })
            @Html.ValidationMessageFor(m => m.FechaEvento, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            <label>Imagen del Anuncio</label>
            <input type="file" name="Imagen" class="form-control" accept=".jpg,.jpeg,.png,.gif" />
        </div>

        <button type="submit" class="btn btn-danger">Guardar</button>
        @Html.ActionLink("Cancelar", "ListarAnuncios", null, new { @class = "btn btn-secondary ms-2" })
    }
</div>
