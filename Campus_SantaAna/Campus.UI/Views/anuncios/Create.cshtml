@model Campus.Abstracciones.ModelosUI.AnuncioDto

@{
    ViewBag.Title = "Publicar Anuncio";
}

<div class="premium-form-container">
    <!-- Header del Formulario -->
    <div class="form-header">
        <div class="header-icon">
            <i class="fas fa-bullhorn"></i>
        </div>
        <div class="header-content">
            <h1>Publicar Nuevo Anuncio</h1>
            <p>Crea y publica un nuevo anuncio en el sistema</p>
        </div>
    </div>

    <!-- Formulario Premium -->
    <div class="premium-form-card">
        @using (Html.BeginForm("Create", "Anuncios", FormMethod.Post, new { enctype = "multipart/form-data", @class = "premium-form" }))
        {
            @Html.AntiForgeryToken()

            <div class="validation-summary">
                @Html.ValidationSummary(true, "", new { @class = "validation-errors" })
            </div>

            <!-- Sección de Información Básica -->
            <div class="form-section">
                <div class="section-header">
                    <i class="fas fa-info-circle"></i>
                    <h3>Información Básica</h3>
                </div>
                <div class="form-grid">
                    <div class="form-group full-width">
                        <label class="form-label">
                            <i class="fas fa-heading"></i>
                            Título del Anuncio
                        </label>
                        @Html.TextBoxFor(m => m.Titulo, new
                        {
                            @class = "form-input",
                            placeholder = "Ingresa un título llamativo para el anuncio",
                            required = "required"
                        })
                        @Html.ValidationMessageFor(m => m.Titulo, "", new { @class = "error-message" })
                    </div>

                    <div class="form-group full-width">
                        <label class="form-label">
                            <i class="fas fa-align-left"></i>
                            Descripción del Anuncio
                        </label>
                        @Html.TextAreaFor(m => m.Descripcion, new
                        {
                            @class = "form-textarea",
                            rows = 6,
                            placeholder = "Describe detalladamente el anuncio. Incluye toda la información relevante que los usuarios necesiten conocer.",
                            required = "required"
                        })
                        <div class="character-count">
                            <span id="descripcionCount">0</span> caracteres
                        </div>
                        @Html.ValidationMessageFor(m => m.Descripcion, "", new { @class = "error-message" })
                    </div>
                </div>
            </div>

            <!-- Sección de Fechas y Multimedia -->
            <div class="form-section">
                <div class="section-header">
                    <i class="fas fa-calendar-alt"></i>
                    <h3>Fechas y Multimedia</h3>
                </div>
                <div class="form-grid">
                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-calendar-day"></i>
                            Fecha del Evento
                        </label>
                        @Html.TextBoxFor(m => m.FechaEvento, new
                        {
                            @class = "form-input",
                            type = "datetime-local",
                            required = "required"
                        })
                        @Html.ValidationMessageFor(m => m.FechaEvento, "", new { @class = "error-message" })
                        <div class="form-hint">Selecciona la fecha y hora del evento</div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-image"></i>
                            Imagen del Anuncio
                        </label>
                        <div class="file-upload-container">
                            <input type="file" name="Imagen" class="file-input" id="imagenUpload" accept=".jpg,.jpeg,.png,.gif,.webp" />
                            <label for="imagenUpload" class="file-upload-label">
                                <i class="fas fa-cloud-upload-alt"></i>
                                <span class="file-text">Seleccionar imagen</span>
                            </label>
                            <div class="file-preview" id="filePreview"></div>
                        </div>
                        <div class="form-hint">Formatos soportados: JPG, PNG, GIF, WEBP (Max. 5MB)</div>
                    </div>
                </div>
            </div>

            <!-- Sección de Previsualización -->
            <div class="form-section">
                <div class="section-header">
                    <i class="fas fa-eye"></i>
                    <h3>Vista Previa</h3>
                </div>
                <div class="preview-container">
                    <div class="preview-card" id="anuncioPreview">
                        <div class="preview-header">
                            <div class="preview-icon">
                                <i class="fas fa-bullhorn"></i>
                            </div>
                            <div class="preview-title-section">
                                <h4 id="previewTitulo">Título del anuncio aparecerá aquí</h4>
                                <p id="previewFecha">Fecha del evento aparecerá aquí</p>
                            </div>
                        </div>
                        <div class="preview-body">
                            <p id="previewDescripcion">La descripción del anuncio aparecerá aquí...</p>
                        </div>
                        <div class="preview-image" id="previewImage">
                            <i class="fas fa-image"></i>
                            <span>Vista previa de la imagen</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Acciones del Formulario -->
            <div class="form-actions">
                <button type="submit" class="btn-submit">
                    <i class="fas fa-paper-plane"></i>
                    Publicar Anuncio
                </button>
                <a href="@Url.Action("ListarAnuncios", "Anuncios")" class="btn-cancel">
                    <i class="fas fa-times"></i>
                    Cancelar
                </a>
            </div>
        }
    </div>
</div>

<style>
    /* Variables CSS consistentes */
    :root {
        --primary: #6366f1;
        --primary-dark: #4f46e5;
        --secondary: #f8fafc;
        --accent: #06d6a0;
        --danger: #ef4444;
        --warning: #f59e0b;
        --text: #1e293b;
        --text-light: #64748b;
        --border: #e2e8f0;
        --shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
        --shadow-lg: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        --gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .premium-form-container {
        max-width: 1000px;
        margin: 0 auto;
        padding: 2rem;
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        min-height: 100vh;
    }

    /* Header del Formulario */
    .form-header {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        background: white;
        padding: 2rem;
        border-radius: 20px;
        box-shadow: var(--shadow);
        margin-bottom: 2rem;
        border: 1px solid var(--border);
    }

    .header-icon {
        width: 70px;
        height: 70px;
        background: var(--gradient);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.75rem;
    }

    .header-content h1 {
        font-size: 2rem;
        font-weight: 700;
        color: var(--text);
        margin: 0 0 0.5rem 0;
    }

    .header-content p {
        color: var(--text-light);
        font-size: 1rem;
        margin: 0;
    }

    /* Tarjeta del Formulario */
    .premium-form-card {
        background: white;
        border-radius: 20px;
        box-shadow: var(--shadow);
        border: 1px solid var(--border);
        overflow: hidden;
    }

    .premium-form {
        padding: 0;
    }

    /* Secciones del Formulario */
    .form-section {
        padding: 2rem;
        border-bottom: 1px solid var(--border);
    }

        .form-section:last-child {
            border-bottom: none;
        }

    .section-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

        .section-header i {
            color: var(--primary);
            font-size: 1.25rem;
            width: 24px;
        }

        .section-header h3 {
            margin: 0;
            font-size: 1.25rem;
            font-weight: 600;
            color: var(--text);
        }

    /* Grid del Formulario */
    .form-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1.5rem;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

        .form-group.full-width {
            grid-column: 1 / -1;
        }

    .form-label {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 600;
        color: var(--text);
        margin-bottom: 0.5rem;
        font-size: 0.95rem;
    }

        .form-label i {
            color: var(--primary);
            width: 16px;
        }

    .form-input, .form-textarea {
        padding: 0.75rem 1rem;
        border: 2px solid var(--border);
        border-radius: 12px;
        font-size: 1rem;
        transition: all 0.3s ease;
        background: white;
        font-family: inherit;
    }

        .form-input:focus, .form-textarea:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
        }

        .form-input::placeholder, .form-textarea::placeholder {
            color: var(--text-light);
        }

    .form-textarea {
        resize: vertical;
        min-height: 120px;
    }

    /* Upload de Archivos */
    .file-upload-container {
        position: relative;
    }

    .file-input {
        display: none;
    }

    .file-upload-label {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 1rem 1.5rem;
        border: 2px dashed var(--border);
        border-radius: 12px;
        background: var(--secondary);
        color: var(--text);
        cursor: pointer;
        transition: all 0.3s ease;
        text-align: center;
        justify-content: center;
    }

        .file-upload-label:hover {
            border-color: var(--primary);
            background: rgba(99, 102, 241, 0.05);
        }

        .file-upload-label i {
            font-size: 1.25rem;
            color: var(--primary);
        }

    .file-preview {
        margin-top: 1rem;
        display: none;
    }

        .file-preview img {
            max-width: 200px;
            max-height: 150px;
            border-radius: 8px;
            border: 2px solid var(--border);
        }

    /* Contador de Caracteres */
    .character-count {
        text-align: right;
        font-size: 0.8rem;
        color: var(--text-light);
        margin-top: 0.5rem;
    }

    /* Textos de Ayuda */
    .form-hint {
        font-size: 0.8rem;
        color: var(--text-light);
        margin-top: 0.5rem;
        font-style: italic;
    }

    /* Validación */
    .validation-summary {
        margin-bottom: 1.5rem;
    }

    .validation-errors {
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 12px;
        padding: 1rem 1.5rem;
        color: #dc2626;
        font-size: 0.9rem;
    }

    .error-message {
        color: #dc2626;
        font-size: 0.8rem;
        margin-top: 0.25rem;
        display: block;
    }

    /* Previsualización */
    .preview-container {
        background: var(--secondary);
        border-radius: 12px;
        padding: 1.5rem;
    }

    .preview-card {
        background: white;
        border-radius: 12px;
        border: 1px solid var(--border);
        overflow: hidden;
        box-shadow: var(--shadow);
    }

    .preview-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.5rem;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }

    .preview-icon {
        width: 50px;
        height: 50px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }

    .preview-title-section h4 {
        margin: 0 0 0.25rem 0;
        font-size: 1.1rem;
        font-weight: 600;
    }

    .preview-title-section p {
        margin: 0;
        font-size: 0.85rem;
        opacity: 0.9;
    }

    .preview-body {
        padding: 1.5rem;
        border-bottom: 1px solid var(--border);
    }

        .preview-body p {
            margin: 0;
            color: var(--text);
            line-height: 1.6;
        }

    .preview-image {
        padding: 2rem;
        text-align: center;
        color: var(--text-light);
        background: var(--secondary);
    }

        .preview-image i {
            font-size: 3rem;
            margin-bottom: 1rem;
            display: block;
        }

        .preview-image span {
            font-size: 0.9rem;
        }

    /* Acciones del Formulario */
    .form-actions {
        padding: 2rem;
        background: var(--secondary);
        display: flex;
        gap: 1rem;
        justify-content: flex-end;
        border-top: 1px solid var(--border);
    }

    .btn-submit, .btn-cancel {
        padding: 0.75rem 2rem;
        border: none;
        border-radius: 12px;
        font-weight: 600;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
        cursor: pointer;
        font-size: 1rem;
    }

    .btn-submit {
        background: var(--gradient);
        color: white;
        box-shadow: var(--shadow);
    }

        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
            color: white;
            text-decoration: none;
        }

    .btn-cancel {
        background: white;
        color: var(--text);
        border: 2px solid var(--border);
    }

        .btn-cancel:hover {
            background: var(--secondary);
            color: var(--text);
            text-decoration: none;
            border-color: var(--text-light);
        }

    /* RESPONSIVE DESIGN */
    @@media (max-width: 768px) {
        .premium-form-container {
            padding: 1rem;
        }

        .form-header {
            flex-direction: column;
            text-align: center;
            gap: 1rem;
            padding: 1.5rem;
        }

        .header-icon {
            width: 60px;
            height: 60px;
            font-size: 1.5rem;
        }

        .header-content h1 {
            font-size: 1.5rem;
        }

        .form-section {
            padding: 1.5rem;
        }

        .form-grid {
            grid-template-columns: 1fr;
            gap: 1rem;
        }

        .section-header {
            margin-bottom: 1rem;
        }

        .form-actions {
            flex-direction: column;
            padding: 1.5rem;
        }

        .btn-submit, .btn-cancel {
            justify-content: center;
        }

        .preview-header {
            flex-direction: column;
            text-align: center;
            gap: 0.75rem;
            padding: 1rem;
        }
    }

    @@media (max-width: 480px) {
        .premium-form-container {
            padding: 0.5rem;
        }

        .form-header {
            padding: 1rem;
            margin-bottom: 1rem;
        }

        .header-content h1 {
            font-size: 1.25rem;
        }

        .form-section {
            padding: 1rem;
        }

        .form-input, .form-textarea {
            padding: 0.6rem 0.8rem;
            font-size: 0.9rem;
        }

        .file-upload-label {
            padding: 0.75rem 1rem;
            font-size: 0.9rem;
        }
    }

    /* Estados de Interacción */
    .form-input:invalid, .form-textarea:invalid {
        border-color: #fca5a5;
    }

    .form-input:valid, .form-textarea:valid {
        border-color: #86efac;
    }

    /* Animaciones */
    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .form-section {
        animation: slideIn 0.5s ease-out;
    }

        .form-section:nth-child(1) {
            animation-delay: 0.1s;
        }

        .form-section:nth-child(2) {
            animation-delay: 0.2s;
        }

        .form-section:nth-child(3) {
            animation-delay: 0.3s;
        }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const tituloInput = document.getElementById('Titulo');
        const descripcionTextarea = document.getElementById('Descripcion');
        const fechaEventoInput = document.getElementById('FechaEvento');
        const imagenUpload = document.getElementById('imagenUpload');
        const descripcionCount = document.getElementById('descripcionCount');

        // Elementos de previsualización
        const previewTitulo = document.getElementById('previewTitulo');
        const previewDescripcion = document.getElementById('previewDescripcion');
        const previewFecha = document.getElementById('previewFecha');
        const previewImage = document.getElementById('previewImage');
        const filePreview = document.getElementById('filePreview');

        // Actualizar contador de caracteres
        if (descripcionTextarea && descripcionCount) {
            descripcionTextarea.addEventListener('input', function() {
                descripcionCount.textContent = this.value.length;
            });

            // Inicializar contador
            descripcionCount.textContent = descripcionTextarea.value.length;
        }

        // Previsualización en tiempo real
        if (tituloInput && previewTitulo) {
            tituloInput.addEventListener('input', function() {
                previewTitulo.textContent = this.value || 'Título del anuncio aparecerá aquí';
            });
        }

        if (descripcionTextarea && previewDescripcion) {
            descripcionTextarea.addEventListener('input', function() {
                previewDescripcion.textContent = this.value || 'La descripción del anuncio aparecerá aquí...';
            });
        }

        if (fechaEventoInput && previewFecha) {
            fechaEventoInput.addEventListener('change', function() {
                if (this.value) {
                    const fecha = new Date(this.value);
                    previewFecha.textContent = `Evento: ${fecha.toLocaleDateString('es-ES', {
                        weekday: 'long',
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit'
                    })}`;
                } else {
                    previewFecha.textContent = 'Fecha del evento aparecerá aquí';
                }
            });
        }

        // Previsualización de imagen
        if (imagenUpload) {
            imagenUpload.addEventListener('change', function(e) {
                const file = e.target.files[0];
                if (file) {
                    if (file.size > 5 * 1024 * 1024) {
                        alert('La imagen no puede ser mayor a 5MB');
                        this.value = '';
                        return;
                    }

                    const reader = new FileReader();
                    reader.onload = function(e) {
                        filePreview.innerHTML = `<img src="${e.target.result}" alt="Vista previa">`;
                        filePreview.style.display = 'block';

                        // Actualizar previsualización
                        previewImage.innerHTML = `<img src="${e.target.result}" alt="Vista previa" style="max-width: 100%; border-radius: 8px;">`;
                    };
                    reader.readAsDataURL(file);
                } else {
                    filePreview.style.display = 'none';
                    previewImage.innerHTML = '<i class="fas fa-image"></i><span>Vista previa de la imagen</span>';
                }
            });
        }

        // Validación adicional antes del envío
        const form = document.querySelector('.premium-form');
        if (form) {
            form.addEventListener('submit', function(e) {
                const titulo = tituloInput.value.trim();
                const descripcion = descripcionTextarea.value.trim();

                if (!titulo) {
                    e.preventDefault();
                    alert('Por favor, ingresa un título para el anuncio');
                    tituloInput.focus();
                    return;
                }

                if (!descripcion) {
                    e.preventDefault();
                    alert('Por favor, ingresa una descripción para el anuncio');
                    descripcionTextarea.focus();
                    return;
                }

                // Mostrar loading
                const submitBtn = document.querySelector('.btn-submit');
                if (submitBtn) {
                    submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Publicando...';
                    submitBtn.disabled = true;
                }
            });
        }
    });
</script>