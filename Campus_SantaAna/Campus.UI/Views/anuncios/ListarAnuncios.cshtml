@model IEnumerable<Campus.Abstracciones.ModelosUI.AnuncioDto>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Lista de Anuncios";
    var anunciosOrdenados = Model.OrderByDescending(a => a.FechaPublicacion).ToList();
}

<div class="admin-container-fluid">
    <!-- Header Premium -->
    <div class="admin-header">
        <div class="header-content">
            <div class="header-title">
                <div class="title-icon">
                    <i class="fas fa-bullhorn me-2"></i>
                </div>
                <div>
                    <h1>@ViewBag.Title</h1>
                    <p class="header-subtitle">Gestiona y visualiza todos los anuncios del sistema</p>
                </div>
            </div>
            <button class="btn-premium btn-Crear-Anuncio">
                <i class="fas fa-plus-circle me-2"></i>
                Nuevo Anuncio
            </button>
        </div>

        <!-- Stats Cards -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon groups-icon">
                    <i class="fas fa-users"></i>
                </div>
                <div class="stat-info">
                    <h3>@Model.Count()</h3>
                    <p>Total Anuncios</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon active-icon">
                    <i class="fas fa-user-check"></i>
                </div>
                <div class="stat-info">
                    <h3>@Model.Count(a => a.Estado)</h3>
                    <p>Anuncios Activos</p>
                </div>
            </div>
        </div>

    </div>


    <!-- Main Card -->
    <div class="premium-card">
        <div class="card-header-premium">
            <div class="header-actions">
                <div class="search-container">
                    <i class="fas fa-search search-icon"></i>
                    <input type="text" class="search-input" placeholder="Buscar anuncios..." id="searchInput">
                </div>
                <div class="filter-actions">
                    
                </div>
            </div>
        </div>

        <!--INICIO TABLA-->
        <div class="card-body-premium">
            <div class="table-container">
                <table class="premium-table" id="TablaDeAnuncios">
                    <thead>
                        <tr>
                            <th class="name-col">
                                <div class="th-content">
                                    <span>Título del Anuncio</span>
                                    <i class="fas fa-sort"></i>
                                </div>
                            </th>
                            <th class="desc-col">
                                <div class="th-content">
                                    <span>Descripción</span>
                                    <i class="fas fa-sort"></i>
                                </div>
                            </th>
                            <th class="creator-col">
                                <div class="th-content">
                                    <span>Fecha evento</span>
                                    <i class="fas fa-calendar-alt me-1"></i>
                                </div>
                            </th>
                            <th class="status-col">
                                <div class="th-content">
                                    <span>Publicación</span>
                                    <i class="fas fa-calendar-check me-1"></i>
                                </div>
                            </th>
                            <th class="actions-col">
                                <div class="th-content">
                                    <span>Acciones</span>
                                </div>
                            </th>
                        </tr>
                    </thead>
                    <tbody>

                        @if (!anunciosOrdenados.Any())
                        {
                            <div class="alert alert-info" role="alert">
                                <i class="fas fa-info-circle me-2"></i>
                                No hay anuncios publicados actualmente.
                            </div>
                        }
                        else
                        {
                            foreach (var anuncio in anunciosOrdenados)
                            {
                                <tr class="group-row">
                                    <td class="name-cell">
                                        <div class="group-info">
                                            <div class="group-icon">
                                                <i class="fa-solid fa-calendar"></i>
                                            </div>
                                            <div class="group-details">
                                                <span class="group-name">@anuncio.Titulo</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="desc-cell">
                                        <span class="group-description">@anuncio.Descripcion</span>
                                    </td>

                                    <td class="desc-cell">
                                        @if (anuncio.FechaEvento != null)
                                        {
                                            <span class="badge bg-info">
                                                @anuncio.FechaEvento.ToString("dd/MM/yyyy")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                    <td class="desc-cell">
                                        <span class="badge bg-info">
                                            @anuncio.FechaPublicacion.ToString("dd/MM/yyyy")
                                        </span>
                                    </td>
                                    <td class="actions-cell">
                                        <div class="d-flex justify-content-center gap-2">
                                            <!-- Botón Editar -->
                                            <button class="btn btn-outline-primary btn-sm btn-Editar-Anuncio"
                                                    data-id="@anuncio.IdAnuncio"
                                                    data-bs-toggle="tooltip"
                                                    title="Editar anuncio">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <!-- Botón Detalles -->
                                            <button class="btn btn-outline-dark btn-sm btn-Detalles-Anuncio"
                                                    data-id="@anuncio.IdAnuncio"
                                                    data-bs-toggle="tooltip"
                                                    title="Ver detalles">
                                                <i class="fas fa-eye"></i>
                                            </button>
                                        </div>
                                    </td>

                                </tr>
                            }
                        }
                    </tbody>
                </table>

            </div>

        </div>

    </div>


    <!-- Pagination -->
    <div class="card-footer-premium">
        <div class="pagination-info">
            Mostrando <strong>@anunciosOrdenados.Count()</strong> anuncio(s) ordenados por fecha de publicación
        </div>
        <div class="pagination-controls">
            <button class="pagination-btn disabled">
                <i class="fas fa-chevron-left"></i>
            </button>
            <button class="pagination-btn active">1</button>
            <button class="pagination-btn">
                <i class="fas fa-chevron-right"></i>
            </button>
        </div>
    </div>
</div>


<!-- Modal para Detalles/Edición -->
<div class="modal fade" id="AnuciosModal" tabindex="-1" aria-labelledby="AnunciosModalTittleLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content shadow-lg">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="UAnunciosModalTittleLabel">
                    <i class="fas fa-file-alt me-2"></i>Anuncio
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script>
        $(document).ready(function () {
            // Función para mostrar detalles del anuncio
            function DetallesAnuncio() {
                const id = $(this).data('id');
                const modal = $("#AnuciosModal");
                const modalBody = modal.find(".modal-body");
                const modalTitle = modal.find(".modal-title");
                const modalFooter = modal.find(".modal-footer");

                // Restaurar footer si no existe
                if (modalFooter.length === 0) {
                    modal.find(".modal-content").append(`
                                                <div class="modal-footer">
                                                    <button class="btn btn-secondary" data-bs-dismiss="modal">
                                                        <i class="fas fa-times me-1"></i>Cerrar
                                                    </button>
                                                </div>
                                            `);
                }

                // Mostrar spinner de carga
                modalBody.html(`
                                            <div class="text-center py-5">
                                                <div class="spinner-border text-primary" role="status">
                                                    <span class="visually-hidden">Cargando...</span>
                                                </div>
                                                <p class="mt-3 text-muted">Cargando detalles...</p>
                                            </div>
                                        `);

                modalTitle.html('<i class="fas fa-eye me-2"></i>Detalles del Anuncio');
                modal.modal("show");

                $.ajax({
                    url: "/Anuncios/DetailsParcial",
                    data: { id: id },
                    type: "GET",
                    success: function (data) {
                        modalBody.html(data);
                    },
                    error: function (xhr, status, error) {
                        console.error("Error al cargar detalles:", error);
                        modalBody.html(`
                                                    <div class="alert alert-danger" role="alert">
                                                        <i class="fas fa-exclamation-triangle me-2"></i>
                                                        <strong>Error:</strong> No se pudieron cargar los detalles del anuncio.
                                                        Por favor, intenta nuevamente.
                                                    </div>
                                                `);
                    }
                });
            }

            // Función para editar anuncio
            function EditarAnuncio() {
                const id = $(this).data('id');
                const modal = $("#AnuciosModal");
                const modalBody = modal.find(".modal-body");
                const modalTitle = modal.find(".modal-title");
                const modalFooter = modal.find(".modal-footer");

                // Mostrar spinner de carga
                modalBody.html(`
                                            <div class="text-center py-5">
                                                <div class="spinner-border text-warning" role="status">
                                                    <span class="visually-hidden">Cargando...</span>
                                                </div>
                                                <p class="mt-3 text-muted">Cargando formulario de edición...</p>
                                            </div>
                                        `);

                modalTitle.html('<i class="fas fa-edit me-2"></i>Editar Anuncio');
                modal.modal("show");

                $.ajax({
                    url: "/Anuncios/EditParcial",
                    data: { id: id },
                    type: "GET",
                    success: function (data) {
                        modalBody.html(data);
                        modalFooter.hide();
                    },
                    error: function (xhr, status, error) {
                        console.error("Error al cargar formulario:", error);
                        modalBody.html(`
                                                    <div class="alert alert-danger" role="alert">
                                                        <i class="fas fa-exclamation-triangle me-2"></i>
                                                        <strong>Error:</strong> No se pudo cargar el formulario de edición.
                                                        Por favor, intenta nuevamente.
                                                    </div>
                                                `);
                        modalFooter.show();
                    }
                });
            }
            function CrearAnuncio() {
                const id = $(this).data('id');
                const modal = $("#AnuciosModal");
                const modalBody = modal.find(".modal-body");
                const modalTitle = modal.find(".modal-title");
                const modalFooter = modal.find(".modal-footer");

                // Mostrar spinner de carga
                modalBody.html(`
                                <div class="text-center py-5">
                                    <div class="spinner-border text-warning" role="status">
                                        <span class="visually-hidden">Cargando...</span>
                                    </div>
                                    <p class="mt-3 text-muted">Cargando formulario de edición...</p>
                                </div>
                            `);

                modalTitle.html('<i class="fas fa-plus me-2"></i>Crear Anuncio');
                modal.modal("show");

                $.ajax({
                    url: "/Anuncios/CreateParcial",
                    data: {},
                    type: "GET",
                    success: function (data) {
                        modalBody.html(data);
                        modalFooter.hide();
                    },
                    error: function (xhr, status, error) {
                        console.error("Error al cargar formulario:", error);
                        modalBody.html(`
                                        <div class="alert alert-danger" role="alert">
                                            <i class="fas fa-exclamation-triangle me-2"></i>
                                            <strong>Error:</strong> No se pudo cargar el formulario de creacion.
                                            Por favor, intenta nuevamente.
                                        </div>
                                    `);
                        modalFooter.show();
                    }
                });
            }

            // Event listeners
            $(document).on('click', '.btn-Detalles-Anuncio', DetallesAnuncio);
            $(document).on('click', '.btn-Editar-Anuncio', EditarAnuncio);
            $(document).on('click', '.btn-Crear-Anuncio', CrearAnuncio);


            // Restaurar footer cuando se cierra el modal
            $('#AnuciosModal').on('hidden.bs.modal', function () {
                const modalFooter = $(this).find(".modal-footer");
                if (modalFooter.length === 0) {
                    $(this).find(".modal-content").append(`
                                                <div class="modal-footer">
                                                    <button class="btn btn-secondary" data-bs-dismiss="modal">
                                                        <i class="fas fa-times me-1"></i>Cerrar
                                                    </button>
                                                </div>
                                            `);
                } else {
                    modalFooter.show();
                }
            });
        });
    </script>

    <style>
        /* Mantenemos las variables CSS del diseño anterior */
        :root {
            --primary: #6366f1;
            --primary-dark: #4f46e5;
            --secondary: #f8fafc;
            --accent: #06d6a0;
            --danger: #ef4444;
            --warning: #f59e0b;
            --text: #1e293b;
            --text-light: #64748b;
            --border: #e2e8f0;
            --shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
            --gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        /* Estilos específicos para grupos */
        .groups-icon {
            background: linear-gradient(135deg, #f59e0b, #d97706);
        }

        .active-icon {
            background: linear-gradient(135deg, #10b981, #059669);
        }

        /* Group Table Styles */
        .group-row:hover {
            background: #f8fafc;
        }

        .name-col, .desc-col, .creator-col, .status-col {
            min-width: 200px;
        }

        .group-info, .creator-info {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .group-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            background: var(--secondary);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--warning);
        }

        .creator-avatar {
            width: 35px;
            height: 35px;
            border-radius: 8px;
            background: linear-gradient(135deg, #667eea, #764ba2);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 600;
            font-size: 0.7rem;
        }

        .group-details {
            display: flex;
            flex-direction: column;
        }

        .group-name {
            font-weight: 600;
            color: var(--text);
            font-size: 0.9rem;
        }

        .group-id {
            font-size: 0.75rem;
            color: var(--text-light);
        }

        .group-description {
            color: var(--text);
            font-size: 0.9rem;
            line-height: 1.4;
        }

        .creator-name {
            font-weight: 500;
            color: var(--text);
            font-size: 0.9rem;
        }

        .status-badge {
            padding: 0.4rem 0.8rem;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

            .status-badge.active {
                background: #dcfce7;
                color: #166534;
            }

            .status-badge.inactive {
                background: #fef2f2;
                color: #dc2626;
            }

        /* Resto de estilos se mantienen igual que en las vistas anteriores */
        .admin-container-fluid {
            min-height: 100vh;
            background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
            padding: 2rem;
        }

        .admin-header {
            margin-bottom: 2rem;
        }

        .header-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
        }

        .header-title {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .title-icon {
            width: 60px;
            height: 60px;
            background: var(--gradient);
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.5rem;
        }

        .header-title h1 {
            font-size: 2rem;
            font-weight: 700;
            color: var(--text);
            margin: 0;
        }

        .header-subtitle {
            color: var(--text-light);
            font-size: 0.9rem;
            margin: 0;
        }

        .btn-premium {
            background: var(--gradient);
            color: white;
            border: none;
            padding: 0.75rem 1.5rem;
            border-radius: 12px;
            font-weight: 600;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.3s ease;
            box-shadow: var(--shadow);
            cursor: pointer;
        }

            .btn-premium:hover {
                transform: translateY(-2px);
                box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2);
            }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .stat-card {
            background: white;
            padding: 1.5rem;
            border-radius: 16px;
            display: flex;
            align-items: center;
            gap: 1rem;
            box-shadow: var(--shadow);
            border: 1px solid var(--border);
            transition: transform 0.3s ease;
        }

            .stat-card:hover {
                transform: translateY(-5px);
            }

        .stat-icon {
            width: 60px;
            height: 60px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            color: white;
        }

        .stat-info h3 {
            font-size: 2rem;
            font-weight: 700;
            color: var(--text);
            margin: 0;
        }

        .stat-info p {
            color: var(--text-light);
            margin: 0;
            font-size: 0.9rem;
        }

        .premium-card {
            background: white;
            border-radius: 20px;
            box-shadow: var(--shadow);
            border: 1px solid var(--border);
            overflow: hidden;
        }

        .card-header-premium {
            padding: 1.5rem 2rem;
            background: var(--secondary);
            border-bottom: 1px solid var(--border);
        }

        .header-actions {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
        }

        .search-container {
            position: relative;
            flex: 1;
            max-width: 400px;
        }

        .search-icon {
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-light);
        }

        .search-input {
            width: 100%;
            padding: 0.75rem 1rem 0.75rem 3rem;
            border: 1px solid var(--border);
            border-radius: 12px;
            font-size: 0.9rem;
            transition: all 0.3s ease;
            background: white;
        }

            .search-input:focus {
                outline: none;
                border-color: var(--primary);
                box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
            }

        .filter-actions {
            display: flex;
            gap: 0.75rem;
        }

        .btn-filter {
            padding: 0.6rem 1.2rem;
            border: 1px solid var(--border);
            border-radius: 10px;
            background: white;
            color: var(--text);
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.3s ease;
            cursor: pointer;
        }

            .btn-filter:hover {
                border-color: var(--primary);
                color: var(--primary);
            }

        .card-body-premium {
            padding: 0;
        }

        .table-container {
            overflow-x: auto;
        }

        .premium-table {
            width: 100%;
            border-collapse: collapse;
        }

            .premium-table thead {
                background: var(--secondary);
            }

            .premium-table th {
                padding: 1.2rem 1rem;
                text-align: left;
                font-weight: 600;
                color: var(--text);
                font-size: 0.85rem;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                border-bottom: 1px solid var(--border);
            }

        .th-content {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .premium-table td {
            padding: 1.2rem 1rem;
            border-bottom: 1px solid var(--border);
            vertical-align: middle;
        }

        .actions-cell {
            min-width: 150px;
        }

        .card-footer-premium {
            padding: 1.5rem 2rem;
            background: var(--secondary);
            border-top: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .pagination-info {
            color: var(--text-light);
            font-size: 0.9rem;
        }

        .pagination-controls {
            display: flex;
            gap: 0.5rem;
        }

        .pagination-btn {
            width: 40px;
            height: 40px;
            border: 1px solid var(--border);
            border-radius: 10px;
            background: white;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 0.9rem;
        }

            .pagination-btn:hover:not(.disabled) {
                border-color: var(--primary);
                color: var(--primary);
            }

            .pagination-btn.active {
                background: var(--primary);
                color: white;
                border-color: var(--primary);
            }

            .pagination-btn.disabled {
                opacity: 0.5;
                cursor: not-allowed;
            }

        .premium-modal {
            border-radius: 20px;
            border: none;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        }

        .modal-header-premium {
            padding: 2rem;
            background: var(--gradient);
            color: white;
            border-radius: 20px 20px 0 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .modal-title-content {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .modal-icon {
            font-size: 1.5rem;
        }

        .modal-title {
            margin: 0;
            font-weight: 700;
        }

        .btn-close-premium {
            background: rgba(255, 255, 255, 0.2);
            border: none;
            width: 40px;
            height: 40px;
            border-radius: 10px;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
            cursor: pointer;
        }

            .btn-close-premium:hover {
                background: rgba(255, 255, 255, 0.3);
            }

        .modal-body-premium {
            padding: 2rem;
        }

        /* Responsive Design */
        @@media (max-width: 768px) {
            .admin-container-fluid {
                padding: 1rem;
            }

            .header-content {
                flex-direction: column;
                gap: 1rem;
                align-items: flex-start;
            }

            .header-title h1 {
                font-size: 1.5rem;
            }

            .stats-grid {
                grid-template-columns: 1fr;
            }

            .header-actions {
                flex-direction: column;
                gap: 1rem;
            }

            .search-container {
                max-width: 100%;
            }

            .premium-table {
                font-size: 0.8rem;
            }

            .group-info, .creator-info {
                flex-direction: column;
                align-items: flex-start;
                gap: 0.5rem;
            }

            .card-footer-premium {
                flex-direction: column;
                gap: 1rem;
                align-items: flex-start;
            }
        }

        @@media (max-width: 480px) {
            .admin-container-fluid {
                padding: 0.5rem;
            }

