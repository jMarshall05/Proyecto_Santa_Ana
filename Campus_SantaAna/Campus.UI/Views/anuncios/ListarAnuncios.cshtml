@model IEnumerable<Campus.Abstracciones.ModelosUI.AnuncioDto>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Lista de Anuncios";
}

<h2 class="container-title">Anuncios Públicados</h2>



<div class="d-flex justify-content-end mb-3">
    @Html.ActionLink("Publicar Anuncio", "Create", "Anuncios", null, new { @class = "btn btn-secondary" })
</div>




<table class="table table-striped table-bordered">
    <thead class="table-danger">
        <tr>
            <th>@Html.DisplayNameFor(model => model.Titulo)</th>
            <th>@Html.DisplayNameFor(model => model.Descripcion)</th>
            <th>@Html.DisplayNameFor(model => model.FechaEvento)</th>
            <th>@Html.DisplayNameFor(model => model.FechaPublicacion)</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var anuncio in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => anuncio.Titulo)</td>
                <td>@Html.DisplayFor(modelItem => anuncio.Descripcion)</td>
                <td>@Html.DisplayFor(modelItem => anuncio.FechaEvento)</td>
                <td>@Html.DisplayFor(modelItem => anuncio.FechaPublicacion)</td>
                <td>
                    <div class="btn-group" role="group">
                        <button class="btn btn-sm btn-warning btn-Editar-Anuncio" data-id="@anuncio.IdAnuncio">
                            <i class="fas fa-edit me-1"></i> Editar
                        </button>
                        <button class="btn btn-sm btn-primary btn-Detalles-Anuncio" data-id="@anuncio.IdAnuncio">
                            <i class="fas fa-eye me-1"></i> Detalles
                        </button>
                    </div>
                </td>

            </tr>
        }
    </tbody>
</table>

<div class="modal fade" id="AnuciosModal" tabindex="-1" aria-labelledby="AnunciosModalTittleLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content shadow-lg">
            <div class="modal-header bg-primary text-white">
                <h1 class="modal-title fs-5" id="UAnunciosModalTittleLabel">Agregar</h1>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
            </div>
            <div class="modal-footer">
               <button class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>
@section scripts{
    <script>
        function DetallesAnuncio(event) {
            var id = $(this).data('id');
            $.ajax({
                url: "/Anuncios/DetailsParcial",
                data: { id: id },
                type: "GET",
                success: function (data) {
                    $(".modal-body").html(data);
                    $(".modal-title").html("Detalles Anuncio");
                    $("#AnuciosModal").modal("show");
                },
                error: function (error) {
                    console.log(error);
                }
            });
        };
        function EditarAnuncio(event) {
            var id = $(this).data('id');
            $.ajax({
                url: "/Anuncios/EditParcial",
                data: { id: id },
                type: "GET",
                success: function (data) {
                    $(".modal-body").html(data);
                    $(".modal-title").html("Editar Anuncio");
                    $(".modal-footer").remove()
                    $("#AnuciosModal").modal("show");
                },
                error: function (error) {
                    console.log(error);
                }
            });
        };

        $(document).on('click', '.btn-Detalles-Anuncio', DetallesAnuncio)

        $(document).on('click', '.btn-Editar-Anuncio', EditarAnuncio)

    </script>
}




