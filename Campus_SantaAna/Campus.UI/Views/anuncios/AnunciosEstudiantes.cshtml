
@model IEnumerable<Campus.Abstracciones.ModelosUI.AnuncioDto>

@{
    ViewBag.Title = "Lista de Anuncios";
}

<div class="container">
    <h1 class="container-title">Próximos Eventos Escolares</h1>

    @if (!Model.Any())
    {
        <p class="text-center text-muted">No hay eventos disponibles por el momento. ¡Vuelve pronto!</p>
    }
    else
    {
        <div class="row">
            @foreach (var anuncio in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="event-card">

                        @* 🔹 Mostrar imagen si existe *@
                        @if (!string.IsNullOrEmpty(anuncio.ImagenRuta))
                        {
                            <div class="event-image text-center mb-2">
                                <img src="@Url.Content(anuncio.ImagenRuta)"
                                     alt="Imagen de @anuncio.Titulo"
                                     class="img-fluid rounded"
                                     style="max-height:200px; object-fit:cover;" />
                            </div>
                        }

                        <div class="event-title">@anuncio.Titulo</div>

                        <div class="event-date">
                            <strong>Evento:</strong> @anuncio.FechaEvento.ToString("dd MMM yyyy")<br />
                            <strong>Publicado:</strong> @anuncio.FechaPublicacion.ToString("dd MMM yyyy")
                        </div>

                        <div class="event-description">@anuncio.Descripcion</div>

                        <button class="btn btn-details btn-Detalles-Anuncio" data-id="@anuncio.IdAnuncio">
                            <i class="fas fa-edit me-1"></i> Detalles
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

<div class="modal fade" id="AnuciosModal" tabindex="-1" aria-labelledby="AnunciosModalTittleLabel" aria-hidden="true">
    <div class="modal-dialog modal-ms">
        <div class="modal-content shadow-lg">
            <div class="modal-header bg-primary text-white">
                <h1 class="modal-title fs-5" id="UAnunciosModalTittleLabel">Agregar</h1>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>
@section scripts{

    <script>
        $(document).ready(function () {
            $('.event-card').hide().each(function (index) {
                $(this).delay(150 * index).fadeIn(600);
            });
        });
    </script>
    <script>
        function DetallesAnuncio(event) {
            var id = $(this).data('id');
            $.ajax({
                url: "/Anuncios/DetailsParcial",
                data: { id: id },
                type: "GET",
                success: function (data) {
                    $(".modal-body").html(data);
                    $(".modal-title").html("Detalles Anuncio");
                    $("#AnuciosModal").modal("show");
                },
                error: function (error) {
                    console.log(error);
                }
            });
        };
        $(document).on('click', '.btn-Detalles-Anuncio', DetallesAnuncio)
    </script>
}
