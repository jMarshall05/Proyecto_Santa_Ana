@model Campus.Abstracciones.ModelosUI.AnuncioDto

@{
    ViewBag.Title = "Detalle del Evento";
}

<div class="event-detail-container">
    <div class="event-header">
        <h1 class="event-title">@Model.Titulo</h1>
        <div class="event-status">
            <span class="status-badge @(Model.Estado ? "active" : "inactive")">
                @(Model.Estado ? "Activo" : "Inactivo")
            </span>
        </div>
    </div>

    <div class="event-content">
        <div class="event-dates">
            <div class="date-card">
                <div class="date-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                </div>
                <div class="date-info">
                    <span class="date-label">Fecha del Evento</span>
                    <span class="date-value">@Model.FechaEvento.ToString("dd MMM yyyy")</span>
                </div>
            </div>
            <div class="date-card">
                <div class="date-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                </div>
                <div class="date-info">
                    <span class="date-label">Publicado el</span>
                    <span class="date-value">@Model.FechaPublicacion.ToString("dd MMM yyyy")</span>
                </div>
            </div>
        </div>

        <div class="event-description">
            <h3 class="section-title">Descripción</h3>
            <div class="description-content">
                @Model.Descripcion
            </div>
        </div>

        @if (Model.ImagenRuta != null)
        {
            <div class="event-image">
                <h3 class="section-title">Imagen del Evento</h3>
                <div class="image-container">
                    <img src="@Url.Content(Model.ImagenRuta)" alt="Imagen del evento @Model.Titulo" />
                </div>
                @Html.Hidden("ImagenActual", Model.ImagenRuta)
            </div>
        }
    </div>
</div>

<style>
    /* Variables de colores */
    :root {
        --primary-color: #4361ee;
        --secondary-color: #3f37c9;
        --success-color: #10b981;
        --danger-color: #ef4444;
        --light-color: #f8f9fa;
        --dark-color: #212529;
        --gray-color: #6c757d;
        --border-radius: 12px;
        --box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        --transition: all 0.3s ease;
    }

    /* Estilos generales */
    .event-detail-container {
        max-width: 900px;
        margin: 2rem auto;
        padding: 0 1rem;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: var(--dark-color);
    }

    /* Encabezado del evento */
    .event-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 2rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid #e9ecef;
    }

    .event-title {
        font-size: 2.2rem;
        font-weight: 700;
        color: var(--primary-color);
        margin: 0;
        line-height: 1.2;
        flex: 1;
        margin-right: 1rem;
    }

    .event-status {
        flex-shrink: 0;
    }

    /* Badge de estado */
    .status-badge {
        padding: 0.5rem 1.2rem;
        border-radius: 50px;
        font-size: 0.85rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        box-shadow: var(--box-shadow);
    }

    .status-badge.active {
        background: var(--success-color);
        color: white;
    }

    .status-badge.inactive {
        background: var(--danger-color);
        color: white;
    }

    /* Contenido del evento */
    .event-content {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    /* Fechas del evento */
    .event-dates {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
    }

    .date-card {
        display: flex;
        align-items: center;
        background: white;
        border-radius: var(--border-radius);
        padding: 1.5rem;
        box-shadow: var(--box-shadow);
        transition: var(--transition);
    }

    .date-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 15px rgba(0, 0, 0, 0.1);
    }

    .date-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 50px;
        height: 50px;
        background: rgba(67, 97, 238, 0.1);
        border-radius: 50%;
        margin-right: 1rem;
        color: var(--primary-color);
    }

    .date-info {
        display: flex;
        flex-direction: column;
    }

    .date-label {
        font-size: 0.9rem;
        color: var(--gray-color);
        margin-bottom: 0.3rem;
    }

    .date-value {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--dark-color);
    }

    /* Descripción del evento */
    .event-description {
        background: white;
        border-radius: var(--border-radius);
        padding: 2rem;
        box-shadow: var(--box-shadow);
    }

    .section-title {
        font-size: 1.4rem;
        font-weight: 600;
        color: var(--primary-color);
        margin-bottom: 1.2rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid rgba(67, 97, 238, 0.1);
    }

    .description-content {
        line-height: 1.7;
        font-size: 1.05rem;
        color: var(--dark-color);
    }

    /* Imagen del evento */
    .event-image {
        background: white;
        border-radius: var(--border-radius);
        padding: 2rem;
        box-shadow: var(--box-shadow);
    }

    .image-container {
        border-radius: var(--border-radius);
        overflow: hidden;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    .image-container img {
        width: 100%;
        height: auto;
        display: block;
        transition: var(--transition);
    }

    .image-container:hover img {
        transform: scale(1.02);
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .event-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .event-title {
            margin-bottom: 1rem;
            font-size: 1.8rem;
        }

        .event-dates {
            grid-template-columns: 1fr;
        }

        .event-description,
        .event-image {
            padding: 1.5rem;
        }
    }

    @@media (max-width: 480px) {
        .event-detail-container {
            margin: 1rem auto;
        }

        .event-title {
            font-size: 1.5rem;
        }

        .date-card {
            flex-direction: column;
            text-align: center;
            padding: 1.2rem;
        }

        .date-icon {
            margin-right: 0;
            margin-bottom: 0.8rem;
        }
    }
</style>