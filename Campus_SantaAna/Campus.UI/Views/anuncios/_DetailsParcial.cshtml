@model Campus.Abstracciones.ModelosUI.AnuncioDto

@{
    ViewBag.Title = "Detalle del Evento";
}


<div class="detalle-container">
    <div class="detalle-titulo">@Model.Titulo</div>

    <div class="detalle-fecha">
        <strong>Fecha del Evento:</strong> @Model.FechaEvento.ToString("dd MMM yyyy")<br />
        <strong>Publicado el:</strong> @Model.FechaPublicacion.ToString("dd MMM yyyy")
    </div>

    <div class="detalle-descripcion">
        <strong>Descripción:</strong><br />
        @Model.Descripcion
    </div>
    <div class="detalle-descripcion">
        <strong>Descripción:</strong><br />
        @Html.DisplayNameFor(m => m.Estado)
        <span class="status-badge @(Model.Estado ? "active" : "inactive")">
            @(Model.Estado ? "Activo" : "Inactivo")
        </span>

    </div>

</div>
<style>
    .status-badge {
        padding: 0.4rem 1rem;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

        .status-badge.active {
            background: #10b981;
            color: white;
        }

        .status-badge.inactive {
            background: #ef4444;
            color: white;
        }
</style>
