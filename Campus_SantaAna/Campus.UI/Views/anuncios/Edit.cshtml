@model Campus.Abstracciones.ModelosUI.AnuncioDto

@{
    ViewBag.Title = "Editar Anuncio";
}

<div class="form-container">
    <h2>Editar Anuncio</h2>

    @using (Html.BeginForm("Edit", "Anuncios", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(m => m.IdAnuncio)

        <div class="mb-3">
            <label for="Titulo">Título del Anuncio</label>
            @Html.TextBoxFor(m => m.Titulo, new { @class = "form-control", required = "required", placeholder = "Ingrese el título" })
            @Html.ValidationMessageFor(m => m.Titulo, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            <label for="Descripcion">Descripción</label>
            @Html.TextAreaFor(m => m.Descripcion, new { @class = "form-control", rows = 5, required = "required", placeholder = "Ingrese la descripción" })
            @Html.ValidationMessageFor(m => m.Descripcion, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            <label for="FechaEvento">Fecha del Evento</label>
            @Html.TextBoxFor(m => m.FechaEvento, "{0:yyyy-MM-ddTHH:mm}", new { @class = "form-control", type = "datetime-local", required = "required" })
            @Html.ValidationMessageFor(m => m.FechaEvento, "", new { @class = "text-danger" })
        </div>

        @* Imagen actual *@
        if (!string.IsNullOrEmpty(Model.ImagenRuta))
        {
            <div class="mb-3">
                <label>Imagen Actual</label>
                <img src="@Url.Content(Model.ImagenRuta)" class="img-fluid mb-2" />
                @Html.Hidden("ImagenActual", Model.ImagenRuta)
            </div>

            <div class="form-check mb-3">
                <input type="checkbox" class="form-check-input" name="EliminarImagen" value="true" id="EliminarImagen" />
                <label class="form-check-label" for="EliminarImagen">Eliminar imagen actual</label>
            </div>
        }

        <div class="mb-3">
            <label for="Imagen">Subir Nueva Imagen</label>
            <input type="file" name="Imagen" class="form-control" accept=".jpg,.jpeg,.png,.gif" />
        </div>

        <button type="submit" class="btn btn-danger">Guardar Cambios</button>
        @Html.ActionLink("Cancelar", "ListarAnuncios", null, new { @class = "btn btn-secondary ms-2" })
    }
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
