@model Campus.Abstracciones.ModelosUI.EntregasDto

<div class="container my-5">
    <h2 class="text-center mb-4 fw-bold text-primary">Detalle de la Entrega</h2>

    <div class="card premium-card shadow-lg mx-auto" style="max-width: 900px; width: 100%;">
        <div class="card-header premium-header text-white d-flex align-items-center">
            <i class="fas fa-info-circle me-2 icon-header"></i>
            Información de la Entrega
        </div>

        <div class="card-body">
            <ul class="list-group list-group-flush">

                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span><i class="fas fa-hashtag me-2 text-secondary"></i><strong>ID Entrega:</strong></span>
                    <span>@Model.id_entrega</span>
                </li>

                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span><i class="fas fa-user-graduate me-2 text-primary"></i><strong>Estudiante:</strong></span>
                    <span>
                        @(Model.Estudiante != null
                            ? Model.Estudiante.Nombre + " " + Model.Estudiante.Apellido
                            : Model.id_estudiante)
                    </span>
                </li>

                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span><i class="fas fa-tasks me-2 text-success"></i><strong>Tarea:</strong></span>
                    <span>@(Model.Tarea != null ? Model.Tarea.Titulo : "Sin Título")</span>
                </li>

                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span><i class="fas fa-file-upload me-2 text-warning"></i><strong>Archivo Entregado:</strong></span>
                    <span>
                        @if (!string.IsNullOrEmpty(Model.archivo_entregado))
                        {
                            <a href="@Url.Content(Model.archivo_entregado)" target="_blank" class="btn btn-sm btn-outline-primary ripple">
                                <i class="fas fa-eye me-1"></i> Ver archivo
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">No hay archivo</span>
                        }
                    </span>
                </li>

                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span><i class="fas fa-calendar-alt me-2 text-info"></i><strong>Fecha de Entrega:</strong></span>
                    <span>@Model.fecha_entrega.ToString("dd/MM/yyyy HH:mm")</span>
                </li>

                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span><i class="fas fa-check-circle me-2 text-success"></i><strong>Estado:</strong></span>
                    <span>
                        @if (Model.estado)
                        {
                            <span class="badge bg-success">Entregado</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Pendiente</span>
                        }
                    </span>
                </li>
            </ul>
        </div>

        <div class="card-footer text-center bg-light">
            <a href="@Url.Action("Index", "Entregas")" class="btn premium-btn-secondary ripple">
                <i class="fas fa-arrow-left me-1"></i> Volver
            </a>
        </div>
    </div>
</div>

@section styles {
    <style>
/* Card premium */
.premium-card {
    border-radius: 18px;
    overflow: hidden;
    background: #ffffff;
    animation: fadeInUp 0.5s ease;
    box-shadow: 0 12px 28px rgba(0,0,0,0.18);
}

/* Header premium */
.premium-header {
    background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);
    padding: 18px 25px;
    font-size: 1.3rem;
    font-weight: 600;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
    display: flex;
    align-items: center;
}

.icon-header {
    font-size: 1.5rem;
    opacity: 0.9;
}

/* Lista items */
.list-group-item {
    font-size: 1rem;
    padding: 16px 20px;
    transition: background 0.2s ease;
}
.list-group-item:hover {
    background: #f5f7ff;
}

/* Badges de estado */
.badge {
    font-size: 0.9rem;
    padding: 0.45em 0.75em;
}

/* Botón premium */
.premium-btn-secondary {
    background: #e7f0ff;
    color: #224abe;
    font-weight: 600;
    border-radius: 12px;
    padding: 12px 25px;
    border: none;
    transition: all 0.2s ease;
}
.premium-btn-secondary:hover {
    background: #d0e2ff;
}

/* Animación fadeInUp */
@@keyframes fadeInUp {
    from { opacity: 0; transform: translateY(15px);}
    to { opacity: 1; transform: translateY(0);}
}

/* Ripple */
.ripple { position: relative; overflow: hidden; }

.ripple-effect {
    position: absolute;
    border-radius: 50%;
    background: rgba(255,255,255,0.5);
    transform: scale(0);
    animation: ripple 0.6s linear;
    pointer-events: none;
    opacity: 0;
}

@@keyframes ripple {
    to { transform: scale(4); opacity: 0; }
}
    </style>
}

@section scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

    <script>
// Ripple effect
document.querySelectorAll('.ripple').forEach(btn => {
    btn.addEventListener('click', function (e) {
        let circle = document.createElement("span");
        const diameter = Math.max(this.clientWidth, this.clientHeight);
        const radius = diameter / 2;
        circle.style.width = circle.style.height = `${diameter}px`;
        circle.style.left = `${e.clientX - this.offsetLeft - radius}px`;
        circle.style.top = `${e.clientY - this.offsetTop - radius}px`;
        circle.classList.add("ripple-effect");
        this.appendChild(circle);
        setTimeout(() => circle.remove(), 600);
    });
});
    </script>
}
