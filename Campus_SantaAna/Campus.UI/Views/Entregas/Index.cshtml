@model IEnumerable<Campus.Abstracciones.ModelosUI.EntregasDto>

@if (ViewBag.Titulo != null)
{
    <h2 class="container-title">Lista de Entregas de @ViewBag.Titulo : Grupo @ViewBag.Grupo</h2>

}
else
{
    <h2 class="container-title">Lista de Entregas</h2>

}

<table class="table table-striped table-bordered">
    <thead class="table-danger">
        <tr>
            <th>ID Entrega</th>
            <th>Estudiante</th>
            <th>ID Tarea</th>
            <th>Fecha de Entrega</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var entrega in Model)
        {
            <tr>
                <td>@entrega.id_entrega</td>
                <td>@entrega.Estudiante.Nombre @entrega.Estudiante.Apellido</td>
                <td>@entrega.id_tarea</td>
                <td>@entrega.fecha_entrega.ToString("dd/MM/yyyy HH:mm")</td>
                <td>
                    <div class="btn-group" role="group">
                        <a href="@Url.Action("ObtenerEntregaPorID", "Entregas", new { id = entrega.id_entrega })" class="btn btn-sm btn-warning">
                            <i class="fas fa-info-circle me-1"></i> Ver Detalles
                        </a>
                        <a href="@Url.Action("Edit", "Entregas", new { id = entrega.id_entrega })" class="btn btn-primary">
                            <i class="fas fa-edit me-1"></i> Calificar
                        </a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
