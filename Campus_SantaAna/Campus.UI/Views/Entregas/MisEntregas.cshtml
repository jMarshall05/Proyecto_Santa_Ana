
@model List<Campus.Abstracciones.ModelosUI.EntregasDto>
@{
    List<Campus.Abstracciones.ModelosUI.MateriaDto> materias = ViewBag.Materias;
}

<div class="container my-4">
    <h2 class="fw-bold text-dark mb-4"><i class="fas fa-folder-open me-2"></i>Mis Entregas</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info shadow-sm">
            <i class="fas fa-info-circle me-2"></i>No tienes entregas registradas.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle shadow-sm rounded table-modern">
                <thead class="table-light">
                    <tr>
                        <th>Tarea</th>
                        <th>Materia</th>
                        <th>Archivo Entregado</th>
                        <th>Fecha Entrega</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var materia = materias.FirstOrDefault(i => i.Id_Materia == item.Tarea.IdMateria)?.Nombre ?? "Sin materia";
                        <tr>
                            <td class="fw-bold">@item.Tarea.Titulo</td>
                            <td>@materia</td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.archivo_entregado))
                                {
                                    <a href="@Url.Content(item.archivo_entregado)" target="_blank" class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-eye me-1"></i>Ver Archivo
                                    </a>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">No entregado</span>
                                }
                            </td>
                            <td>@item.fecha_entrega.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (item.estado)
                                {
                                    <span class="badge bg-success">Entregado</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Pendiente</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<style>
    .table-modern {
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid #d1d9e6;
        background-color: #ffffff;
        box-shadow: 0 8px 20px rgba(52, 152, 219, 0.1);
        transition: all 0.3s ease;
    }

        .table-modern thead th {
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 0.5px;
            background: linear-gradient(90deg, #3498db, #3b82f6);
            color: #fff;
            border-bottom: none;
            padding: 1rem;
        }

        .table-modern tbody tr:hover {
            background-color: rgba(52, 152, 219, 0.08);
            transition: all 0.3s;
        }

    .badge {
        font-weight: 600;
        font-size: 0.85rem;
        padding: 0.35rem 0.6rem;
        border-radius: 10px;
    }

    .bg-success {
        background-color: #2ecc71 !important;
        color: white !important;
    }

    .bg-warning {
        background-color: #f39c12 !important;
        color: black !important;
    }

    .btn-outline-primary {
        border-radius: 12px;
        font-weight: 600;
        color: #3498db;
        border: 2px solid #3498db;
        transition: all 0.2s;
    }

        .btn-outline-primary:hover {
            background: #3498db;
            color: white;
            box-shadow: 0 4px 12px rgba(52, 152, 219, 0.3);
        }
</style>
