@model Campus.Abstracciones.ModelosUI.EntregasDto

@{
    ViewBag.Title = "Editar Entrega";
}

<h2>Calificar Tarea</h2>

@using (Html.BeginForm("Edit", "Entregas", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.id_entrega)
    @Html.HiddenFor(m => m.id_tarea)
    @Html.HiddenFor(m => m.id_estudiante)

    <div class="form-group">
        <label>Estudiante</label>
        <p class="form-control-static">@Model.Estudiante?.Nombre @Model.Estudiante?.Apellido (@Model.id_estudiante)</p>
    </div>

    <div class="form-group">
        <label>Tarea</label>
        <p class="form-control-static">@Model.Tarea?.Titulo</p>
    </div>

    <div class="form-group">
        <label>Archivo Entregado</label>
        @if (!string.IsNullOrEmpty(Model.archivo_entregado))
        {
            <p><a href="@Url.Content(Model.archivo_entregado)" target="_blank" class="btn btn-link">Descargar</a></p>
        }
        else
        {
            <p class="text-muted">No se ha subido archivo</p>
        }
    </div>

    <div class="mb-3">
        @if (Model.Calificacion == null)
        {
            @Html.ActionLink("Añadir calificación", "Create", "Calificaciones", new { id = Model.id_entrega }, new { @class = "btn btn-primary" })
        }
        else
        {
            <p><strong>Calificación actual:</strong> @Model.Calificacion.calificacion</p>
            <p><strong>Comentario:</strong> @Model.Calificacion.comentario</p>

            <div class="btn-group" role="group">
                @Html.ActionLink("Editar calificación", "Edit", "Calificaciones", new { id = Model.Calificacion.id_calificacion }, new { @class = "btn btn-warning" })
                @Html.ActionLink("Eliminar calificación", "Delete", "Calificaciones", new { id = Model.Calificacion.id_calificacion }, new { @class = "btn btn-danger", onclick = "return confirm('¿Está seguro que desea eliminar esta calificación?');" })
            </div>
        }
    </div>



    <button type="submit" class="btn btn-success">Guardar Cambios</button>
    <a href="@Url.Action("Index", "Entregas")" class="btn btn-secondary">Cancelar</a>
}

