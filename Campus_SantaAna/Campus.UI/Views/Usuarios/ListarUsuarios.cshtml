@model IEnumerable<Campus.Abstracciones.ModelosUI.UsuariosDto>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Gestión de Usuarios";
}

<div class="admin-container-fluid">
    <!-- Header Premium -->
    <div class="admin-header">
        <div class="header-content">
            <div class="header-title">
                <div class="title-icon">
                    <i class="fas fa-users-crown"></i>
                </div>
                <div>
                    <h1>@ViewBag.Title</h1>
                    <p class="header-subtitle">Administra todos los usuarios del sistema</p>
                </div>
            </div>
            <a href="@Url.Action("Register", "Account")" class="btn-premium">
                <i class="fas fa-plus-circle me-2"></i>
                Nuevo Usuario
            </a>
        </div>

        <!-- Stats Cards -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon users-icon">
                    <i class="fas fa-users"></i>
                </div>
                <div class="stat-info">
                    <h3>@Model.ToList().Count()</h3>
                    <p>Total Usuarios</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon active-icon">
                    <i class="fas fa-user-check"></i>
                </div>
                <div class="stat-info">
                    <h3>@ViewBag.UsuariosInactivo</h3>
                    <p>Usuarios Activos</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Card -->
    <div class="premium-card">
        <div class="card-header-premium">
            <div class="header-actions">
                <div class="search-container">
                    <i class="fas fa-search search-icon"></i>
                    <input type="text" class="search-input" placeholder="Buscar usuarios..." id="searchInput">
                </div>
                <div class="filter-actions">
                    <button class="btn-filter" id="filterBtn">
                        <i class="fas fa-filter"></i>
                        Filtros
                    </button>
                    <a  href="@Url.Action("GenerarReportePDFGeneral","Usuarios")"class="btn-export" id="exportBtn" >
                        <i  class="fas fa-download" ></i>
                        Exportar
                    </a>
                </div>
            </div>
        </div>

        <div class="card-body-premium">
            <div class="table-container">
                <table class="premium-table" id="TablaDeUsuarios">
                    <thead>
                        <tr>
                            <th>Nombre Completo</th>
                            <th>@Html.DisplayNameFor(model => model.Email)</th>
                            <th>@Html.DisplayNameFor(model => model.Identificacion)</th>
                            <th>@Html.DisplayNameFor(model => model.Estado)</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    <i class="fas fa-users fa-2x mb-2"></i>
                                    <br>
                                    No hay usuarios registrados
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                <tr class="user-row">
                                    <td class="user-info-cell" data-label="Usuario">
                                        <div class="user-info">
                                            <div class="user-avatar">
                                                @{
                                                    var inicialNombre = !string.IsNullOrEmpty(item.Nombre) ? item.Nombre[0].ToString() : "U";
                                                    var inicialApellido = !string.IsNullOrEmpty(item.Apellido) ? item.Apellido[0].ToString() : "S";
                                                }
                                                <span class="avatar-text">@inicialNombre@inicialApellido</span>
                                            </div>
                                            <div class="user-details">
                                                <span class="user-name">@item.Nombre @item.Apellido</span>
                                                <span class="user-role">@item.Rol</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="email-cell" data-label="Email">
                                        <div class="email-content">
                                            <i class="fas fa-envelope email-icon"></i>
                                            <span class="email-text">@item.Email</span>
                                        </div>
                                    </td>
                                    <td class="id-cell" data-label="Cédula">
                                        <span class="id-badge">@item.Identificacion</span>
                                    </td>
                                    <td class="status-cell" data-label="Estado">
                                        @if (item.Estado)
                                        {<span class="status-badge active">Activo</span>}
                                        else
                                        { <span class="status-badge inactive">Inactivo</span>}

                                    </td>
                                    <td class="actions-cell" data-label="Acciones">
                                        <div class="actions-container">
                                            <!-- Botón Detalles -->
                                            <button class="btn btn-outline-dark btn-sm btn-Detalles" data-id="@item.IdUsuario" data-bs-toggle="tooltip" title="Ver Detalles">
                                                <i class="fas fa-eye"></i>
                                                <span class="action-text">Detalles</span>
                                            </button>
                                            <!-- Botón Editar -->
                                            <button class="btn btn-outline-primary btn-sm btn-Editar" data-id="@item.IdUsuario" data-bs-toggle="tooltip" title="Editar">
                                                <i class="fas fa-pen"></i>
                                                <span class="action-text">Editar</span>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination -->
        <div class="card-footer-premium">
            <div class="pagination-info">
                Mostrando <strong>@Model.Count()</strong> usuarios
            </div>
            <div class="pagination-controls">
                <button class="pagination-btn disabled">
                    <i class="fas fa-chevron-left"></i>
                </button>
                <button class="pagination-btn active">1</button>
                <button class="pagination-btn">
                    <i class="fas fa-chevron-right"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="UsuariosModal" tabindex="-1" aria-labelledby="UsuariosModalTittleLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content premium-modal">
            <div class="modal-header-premium">
                <div class="modal-title-content">
                    <i class="fas fa-users-crown modal-icon"></i>
                    <h1 class="modal-title" id="UsuariosModalTittleLabel">Gestión de Usuario</h1>
                </div>
                <button type="button" class="btn-close-premium" data-bs-dismiss="modal" aria-label="Cerrar">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="modal-body-premium"></div>
            <div class="modal-footer-premium"></div>
        </div>
    </div>
</div>

@section scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

    <style>
        /* Variables CSS consistentes */
        :root {
            --primary: #6366f1;
            --primary-dark: #4f46e5;
            --secondary: #f8fafc;
            --accent: #06d6a0;
            --danger: #ef4444;
            --warning: #f59e0b;
            --text: #1e293b;
            --text-light: #64748b;
            --border: #e2e8f0;
            --shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
            --gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        /* Estilos específicos para usuarios */
        .users-icon {
            background: linear-gradient(135deg, #6366f1, #4f46e5);
        }

        .active-icon {
            background: linear-gradient(135deg, #10b981, #059669);
        }

        /* User Table Styles */
        .user-row:hover {
            background: #f8fafc;
        }

        .user-col, .email-col, .phone-col, .id-col, .status-col {
            min-width: 180px;
        }

        .actions-col {
            min-width: 200px;
        }

        .user-info, .email-content, .phone-content {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            background: linear-gradient(135deg, #667eea, #764ba2);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 600;
            font-size: 0.8rem;
        }

        .user-details {
            display: flex;
            flex-direction: column;
        }

        .user-name {
            font-weight: 600;
            color: var(--text);
            font-size: 0.9rem;
        }

        .user-role {
            font-size: 0.75rem;
            color: var(--text-light);
        }

        .email-icon, .phone-icon {
            color: var(--text-light);
            width: 16px;
        }

        .email-text {
            color: var(--text);
            font-size: 0.9rem;
        }

        .has-phone {
            color: var(--text);
            font-size: 0.9rem;
        }

        .no-phone {
            color: var(--text-light);
            font-style: italic;
            font-size: 0.9rem;
        }

        .id-badge {
            background: var(--secondary);
            padding: 0.4rem 0.8rem;
            border-radius: 8px;
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--text);
            border: 1px solid var(--border);
        }

        .status-badge {
            padding: 0.4rem 0.8rem;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

            .status-badge.active {
                background: #dcfce7;
                color: #166534;
            }

            .status-badge.inactive {
                background: #fef2f2;
                color: #dc2626;
            }

        .actions-container {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
            justify-content: center;
        }

        .action-text {
            display: none;
        }

        /* Base Styles (igual que en grupos) */
        .admin-container-fluid {
            min-height: 100vh;
            background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
            padding: 2rem;
        }

        .admin-header {
            margin-bottom: 2rem;
        }

        .header-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
        }

        .header-title {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .title-icon {
            width: 60px;
            height: 60px;
            background: var(--gradient);
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.5rem;
        }

        .header-title h1 {
            font-size: 2rem;
            font-weight: 700;
            color: var(--text);
            margin: 0;
        }

        .header-subtitle {
            color: var(--text-light);
            font-size: 0.9rem;
            margin: 0;
        }

        .btn-premium {
            background: var(--gradient);
            color: white;
            border: none;
            padding: 0.75rem 1.5rem;
            border-radius: 12px;
            font-weight: 600;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.3s ease;
            box-shadow: var(--shadow);
            cursor: pointer;
        }

            .btn-premium:hover {
                transform: translateY(-2px);
                box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2);
                color: white;
                text-decoration: none;
            }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .stat-card {
            background: white;
            padding: 1.5rem;
            border-radius: 16px;
            display: flex;
            align-items: center;
            gap: 1rem;
            box-shadow: var(--shadow);
            border: 1px solid var(--border);
            transition: transform 0.3s ease;
        }

            .stat-card:hover {
                transform: translateY(-5px);
            }

        .stat-icon {
            width: 60px;
            height: 60px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            color: white;
        }

        .stat-info h3 {
            font-size: 2rem;
            font-weight: 700;
            color: var(--text);
            margin: 0;
        }

        .stat-info p {
            color: var(--text-light);
            margin: 0;
            font-size: 0.9rem;
        }

        .premium-card {
            background: white;
            border-radius: 20px;
            box-shadow: var(--shadow);
            border: 1px solid var(--border);
            overflow: hidden;
        }

        .card-header-premium {
            padding: 1.5rem 2rem;
            background: var(--secondary);
            border-bottom: 1px solid var(--border);
        }

        .header-actions {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
        }

        .search-container {
            position: relative;
            flex: 1;
            max-width: 400px;
        }

        .search-icon {
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-light);
        }

        .search-input {
            width: 100%;
            padding: 0.75rem 1rem 0.75rem 3rem;
            border: 1px solid var(--border);
            border-radius: 12px;
            font-size: 0.9rem;
            transition: all 0.3s ease;
            background: white;
        }

            .search-input:focus {
                outline: none;
                border-color: var(--primary);
                box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
            }

        .filter-actions {
            display: flex;
            gap: 0.75rem;
        }

        .btn-filter, .btn-export {
            padding: 0.6rem 1.2rem;
            border: 1px solid var(--border);
            border-radius: 10px;
            background: white;
            color: var(--text);
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.3s ease;
            cursor: pointer;
        }

            .btn-filter:hover, .btn-export:hover {
                border-color: var(--primary);
                color: var(--primary);
            }

        .card-body-premium {
            padding: 0;
        }

        .table-container {
            overflow-x: auto;
        }

        .premium-table {
            width: 100%;
            border-collapse: collapse;
            min-width: 800px;
        }

            .premium-table thead {
                background: var(--secondary);
            }

            .premium-table th {
                padding: 1.2rem 1rem;
                text-align: left;
                font-weight: 600;
                color: var(--text);
                font-size: 0.85rem;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                border-bottom: 1px solid var(--border);
            }

        .th-content {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .premium-table td {
            padding: 1.2rem 1rem;
            border-bottom: 1px solid var(--border);
            vertical-align: middle;
        }

        .card-footer-premium {
            padding: 1.5rem 2rem;
            background: var(--secondary);
            border-top: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .pagination-info {
            color: var(--text-light);
            font-size: 0.9rem;
        }

        .pagination-controls {
            display: flex;
            gap: 0.5rem;
        }

        .pagination-btn {
            width: 40px;
            height: 40px;
            border: 1px solid var(--border);
            border-radius: 10px;
            background: white;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 0.9rem;
        }

            .pagination-btn:hover:not(.disabled) {
                border-color: var(--primary);
                color: var(--primary);
            }

            .pagination-btn.active {
                background: var(--primary);
                color: white;
                border-color: var(--primary);
            }

            .pagination-btn.disabled {
                opacity: 0.5;
                cursor: not-allowed;
            }

        /* Modal Styles */
        .premium-modal {
            border-radius: 20px;
            border: none;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        }

        .modal-header-premium {
            padding: 2rem;
            background: var(--gradient);
            color: white;
            border-radius: 20px 20px 0 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .modal-title-content {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .modal-icon {
            font-size: 1.5rem;
        }

        .modal-title {
            margin: 0;
            font-weight: 700;
        }

        .btn-close-premium {
            background: rgba(255, 255, 255, 0.2);
            border: none;
            width: 40px;
            height: 40px;
            border-radius: 10px;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
            cursor: pointer;
        }

            .btn-close-premium:hover {
                background: rgba(255, 255, 255, 0.3);
            }

        .modal-body-premium {
            padding: 2rem;
        }

        /* RESPONSIVE DESIGN */
        @@media (max-width: 1200px) {
            .premium-table {
                min-width: 1000px;
            }
        }

        @@media (max-width: 768px) {
            .admin-container-fluid {
                padding: 1rem;
            }

            .header-content {
                flex-direction: column;
                gap: 1rem;
                align-items: flex-start;
            }

            .header-title {
                flex-direction: column;
                align-items: flex-start;
                gap: 0.5rem;
            }

                .header-title h1 {
                    font-size: 1.5rem;
                }

            .title-icon {
                width: 50px;
                height: 50px;
                font-size: 1.2rem;
            }

            .stats-grid {
                grid-template-columns: 1fr;
                gap: 1rem;
            }

            .stat-card {
                padding: 1rem;
            }

            .header-actions {
                flex-direction: column;
                gap: 1rem;
                width: 100%;
            }

            .search-container {
                max-width: 100%;
                width: 100%;
            }

            .filter-actions {
                width: 100%;
                justify-content: space-between;
            }

            .btn-filter, .btn-export {
                flex: 1;
                justify-content: center;
            }

            .card-footer-premium {
                flex-direction: column;
                gap: 1rem;
                align-items: flex-start;
            }

            .pagination-controls {
                align-self: flex-end;
            }
            /* Table responsive for mobile */
            .premium-table {
                min-width: unset;
            }

                .premium-table thead {
                    display: none;
                }

                .premium-table tbody tr {
                    display: block;
                    margin-bottom: 1rem;
                    border: 1px solid var(--border);
                    border-radius: 12px;
                    padding: 1rem;
                    background: white;
                    box-shadow: var(--shadow);
                }

                .premium-table td {
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                    padding: 0.75rem 0;
                    border: none;
                    border-bottom: 1px solid var(--border);
                }

                    .premium-table td:last-child {
                        border-bottom: none;
                    }

                    .premium-table td::before {
                        content: attr(data-label);
                        font-weight: 600;
                        color: var(--text);
                        font-size: 0.8rem;
                        text-transform: uppercase;
                        min-width: 80px;
                    }

            .user-info-cell::before,
            .email-cell::before,
            .phone-cell::before,
            .id-cell::before,
            .status-cell::before,
            .actions-cell::before {
                content: attr(data-label) !important;
            }

            .user-info, .email-content, .phone-content {
                justify-content: flex-end;
                text-align: right;
            }

            .actions-container {
                justify-content: flex-end;
                width: 100%;
            }

            .action-text {
                display: inline;
                margin-left: 0.5rem;
            }

            .btn-sm {
                padding: 0.5rem 1rem;
                font-size: 0.8rem;
            }

            .modal-body-premium {
                padding: 1rem;
            }
        }

        @@media (max-width: 480px) {
            .admin-container-fluid {
                padding: 0.5rem;
            }

            .header-title h1 {
                font-size: 1.25rem;
            }

            .header-subtitle {
                font-size: 0.8rem;
            }

            .btn-premium {
                padding: 0.6rem 1rem;
                font-size: 0.8rem;
                width: 100%;
                justify-content: center;
            }

            .stat-info h3 {
                font-size: 1.5rem;
            }

            .premium-table td {
                padding: 0.5rem 0;
                font-size: 0.8rem;
            }

            .actions-container {
                flex-direction: column;
                gap: 0.25rem;
            }

            .btn-sm {
                width: 100%;
                justify-content: center;
            }

            .pagination-controls {
                align-self: stretch;
                justify-content: space-between;
            }

            .pagination-btn {
                flex: 1;
            }
        }

        /* Custom Scrollbar */
        .table-container::-webkit-scrollbar {
            height: 8px;
        }

        .table-container::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 4px;
        }

        .table-container::-webkit-scrollbar-thumb {
            background: var(--primary);
            border-radius: 4px;
        }

            .table-container::-webkit-scrollbar-thumb:hover {
                background: var(--primary-dark);
            }
    </style>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Inicializar tooltips
            const tooltips = document.querySelectorAll('[data-bs-toggle="tooltip"]');
            tooltips.forEach(tooltip => {
                new bootstrap.Tooltip(tooltip);
            });

            // Búsqueda segura
            const searchInput = document.getElementById('searchInput');
            if (searchInput) {
                searchInput.addEventListener('input', function(e) {
                    const searchTerm = e.target.value.toLowerCase().trim();
                    const rows = document.querySelectorAll('.user-row');

                    rows.forEach(row => {
                        const text = row.textContent.toLowerCase();
                        if (searchTerm === '') {
                            row.style.display = '';
                        } else {
                            row.style.display = text.includes(searchTerm) ? '' : 'none';
                        }
                    });
                });
            }

            // Botones de acción
            document.querySelectorAll('.btn-Detalles').forEach(btn => {
                btn.addEventListener('click', function() {
                    const userId = this.getAttribute('data-id');
                    $('#UsuariosModal .modal-body-premium').load('@Url.Action("DetallesDeUsuarioParcial", "Usuarios")' + '?id=' + userId);
                    $('#UsuariosModal').modal('show');
                });
            });

            document.querySelectorAll('.btn-Editar').forEach(btn => {
                btn.addEventListener('click', function() {
                    const userId = this.getAttribute('data-id');
                    $('#UsuariosModal .modal-body-premium').load('@Url.Action("EditarUsuarioParcial", "Usuarios")' + '?id=' + userId);
                    $('#UsuariosModal').modal('show');
                });
            });

            // Botones de exportación y filtros

            document.getElementById('filterBtn')?.addEventListener('click', function() {
                alert('Funcionalidad de filtros será implementada próximamente');
            });

            // Manejar el envío del formulario
            $(document).on('submit', 'form', function(e) {
                e.preventDefault();

                var form = $(this);
                var url = form.attr('action');
                var formData = form.serialize();

                console.log('Enviando formulario a:', url);

                $.ajax({
                    type: "POST",
                    url: url,
                    data: formData,
                    success: function(response) {
                        if (typeof response === 'string' && response.includes('Redirecting')) {
                            location.reload();
                        }
                        else if (typeof response === 'string') {
                            $('#UsuariosModal .modal-body-premium').html(response);
                        }
                        else {
                            $('#UsuariosModal').modal('hide');
                            location.reload();
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('Error al editar:', error);
                        console.log('Respuesta del servidor:', xhr.responseText);

                        if (xhr.status === 302 || xhr.responseText.includes('Redirect')) {
                            location.reload();
                        } else {
                            alert('Error al guardar los cambios. Por favor, intente nuevamente.');
                        }
                    }
                });
            });
        });
    </script>
}