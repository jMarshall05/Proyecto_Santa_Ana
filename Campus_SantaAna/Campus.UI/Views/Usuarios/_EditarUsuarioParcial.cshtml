@model Campus.Abstracciones.ModelosUI.UsuariosDto
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="container mt-4">
        <div class="card shadow rounded-4">
            <div class="card-header bg-danger text-white rounded-top-4">
                <h4 class="mb-0">Gestión de Usuario</h4>
            </div>

            <div class="card-body">
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
                @Html.HiddenFor(model => model.IdUsuario)

                <div class="row mb-3">
                    <div class="col-md-6">
                        @Html.LabelFor(model => model.Nombre, htmlAttributes: new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(model => model.Nombre, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.Nombre, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(model => model.Apellido, htmlAttributes: new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(model => model.Apellido, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.Apellido, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        @Html.LabelFor(model => model.Email, htmlAttributes: new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(model => model.Email, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="row mb-3">
                    <h5>Teléfonos</h5>
                    <div id="telefonosContainer">
                        @for (int i = 0; i < Model.Telefonos.Count; i++)
                        {
                            <div class="row mb-2">
                                @Html.HiddenFor(m => m.Telefonos[i].Id)
                                <div class="col-md-3">
                                    @Html.TextBoxFor(m => m.Telefonos[i].Codigo, new
                                    {
                                        @class = "form-control",
                                        type = "text",
                                        maxlength = "4",
                                        placeholder = "Código de País (ej: +506)",
                                        required = "required",
                                        oninput = "let val = this.value.replace(/[^0-9]/g, ''); this.value = val.length > 0 ? '+' + val.substring(0, 3) : '';"
                                    })
                                    @Html.ValidationMessageFor(m => m.Telefonos[i].Codigo, "", new { @class = "text-danger" })
                                </div>
                                <div class="col-md-5">
                                    @Html.TextBoxFor(m => m.Telefonos[i].Telefono, new
                               {
                                   @class = "form-control",
                                   minlength = "8",
                                   maxlength = "8",
                                   placeholder = "Numero",
                                   required = "required",
                                   oninput = "this.value = this.value.replace(/[^0-9]/g, '')"
                               })
                                </div>
                                <div class="col-md-3">
                                    @Html.DropDownListFor(m => m.Telefonos[i].Tipo, new List<SelectListItem>
                                     {
                                         new SelectListItem { Text = "Personal", Value = "Personal" },
                                         new SelectListItem { Text = "Trabajo", Value = "Trabajo" },
                                         new SelectListItem { Text = "Hogar", Value = "Hogar" },
                                         new SelectListItem { Text = "Encargado", Value = "Encargado" },
                                         new SelectListItem { Text = "Otro", Value = "Otro" }
                                     }, "Seleccione un tipo de Teléfono", new { @class = "form-control", required = "required" })
                                    @Html.ValidationMessageFor(m => m.Telefonos[i].Tipo, "", new { @class = "text-danger" })
                                </div>
                                <div class="col-md-2 d-flex align-items-center">
                                    @Html.CheckBoxFor(m => m.Telefonos[i].Estado)
                                    @Html.Label("Activo", new { @class = "ms-1" })
                                </div>
                            </div>
                        }
                    </div>
                    <button type="button" id="addTelefono" class="btn btn-primary mt-2">Agregar Teléfono</button>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        @Html.LabelFor(model => model.FechaDeNacimiento, htmlAttributes: new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(model => model.FechaDeNacimiento, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                        @Html.ValidationMessageFor(model => model.FechaDeNacimiento, "", new { @class = "text-danger" })
                    </div>
                    @if (Model.Rol == "Estudiantes")
                    {
                        <div class="col-md-6">
                            @Html.Label("IdGrupo", "Grupo", new { @class = "form-label fw-bold" })

                            @Html.DropDownList(
                                "IdGrupo",
                                (IEnumerable<SelectListItem>)ViewBag.ListaDeGrupos,
                                "Modifique el grupo del estudiante",
                                new { @class = "form-control" }
                            )

                            @Html.ValidationMessage("IdGrupo", "", new { @class = "text-danger" })
                        </div>
                    }
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Rol, htmlAttributes: new { @class = "form-label fw-bold" })
                    @Html.DropDownListFor(m => m.Rol, new List<SelectListItem>
                    {
                        new SelectListItem { Text = "Estudiante", Value = "Estudiantes" },
                        new SelectListItem { Text = "Profesor", Value = "Profesores" },
                        new SelectListItem { Text = "Administrador", Value = "Administradores" }
                    }, "Seleccione un tipo", new { @class = "form-select", id = "Rol" })
                </div>

                <div class="form-check form-switch mb-3">
                    @Html.EditorFor(model => model.Estado, new { htmlAttributes = new { @class = "form-check-input" } })
                    @Html.LabelFor(model => model.Estado, htmlAttributes: new { @class = "form-check-label fw-bold" })
                    @Html.ValidationMessageFor(model => model.Estado, "", new { @class = "text-danger" })
                </div>

                <div class="d-flex justify-content-between">
                    <a class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-arrow-left me-1"></i> Volver a la lista
                    </a>
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-save me-1"></i> Guardar
                    </button>
                </div>
            </div>
        </div>
    </div>
}
<script>
    $(function () {
        let phoneIndex = @Model.Telefonos.Count;

        $('#addTelefono').click(function (e) {
            e.preventDefault();
            let html = `
            <div class="row mb-2">
                <input type="hidden" name="Telefonos[${phoneIndex}].Id" value="0" />
                <div class="col-md-3">
                    <input type="text" name="Telefonos[${phoneIndex}].Codigo"  class = "form-control",
                     type = "text",
                     maxlength = "4",
                     placeholder = "Código de País (ej: +506)",
                     required = "required",
                     oninput = "let val = this.value.replace(/[^0-9]/g, ''); this.value = val.length > 0 ? '+' + val.substring(0, 3) : '';" />
                </div>
                <div class="col-md-5">
                    <input type="text" name="Telefonos[${phoneIndex}].Telefono" class="form-control"  minlength="8", maxlength = "8",
                      placeholder = "Numero",
                      required = "required",
                      oninput = "this.value = this.value.replace(/[^0-9]/g, '')"/>
                </div>
                <div class="col-md-3">
                    <select name="Telefonos[${phoneIndex}].Tipo" class="form-control">
                        <option value="">Seleccione un tipo</option>
                        <option value="Personal">Personal</option>
                        <option value="Trabajo">Trabajo</option>
                        <option value="Hogar">Hogar</option>
                        <option value="Encargado">Encargado</option>
                        <option value="Otro">Otro</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-center">
                    <input type="checkbox" name="Telefonos[${phoneIndex}].Estado" value="true" checked />
                    <input type="hidden" name="Telefonos[${phoneIndex}].Estado" value="false" />
                    <label class="ms-1">Activo</label>
                </div>
            </div>`;

            $('#telefonosContainer').append(html);
            phoneIndex++;
        });
    });
</script>
