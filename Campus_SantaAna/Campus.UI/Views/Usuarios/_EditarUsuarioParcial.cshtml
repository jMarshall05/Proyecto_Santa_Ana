@model Campus.Abstracciones.ModelosUI.UsuariosDto

<!-- Header -->
<div class="edit-header">
    <div class="header-content">
        <div class="header-icon">
            <i class="fas fa-user-edit"></i>
        </div>
        <div>
            <h2 class="modal-title">Editar Usuario</h2>
            <p class="modal-subtitle">Actualiza la información del usuario</p>
        </div>
    </div>
</div>

@using (Html.BeginForm("EditarUsuarioParcial", "Usuarios", new { id = Model.IdUsuario }, FormMethod.Post, new { @class = "edit-form" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.IdUsuario)

    <div class="edit-content">
        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

        <!-- Información Básica -->
        <div class="form-section">
            <h3 class="section-title"><i class="fas fa-user me-2"></i>Información Básica</h3>
            <div class="form-grid">
                <div class="form-group">
                    @Html.LabelFor(model => model.Nombre, new { @class = "form-label" })
                    <div class="input-group">
                        <span class="input-icon"><i class="fas fa-user"></i></span>
                        @Html.TextBoxFor(model => model.Nombre, new { @class = "form-control", placeholder = "Ingrese el nombre", required = "required" })
                    </div>
                    @Html.ValidationMessageFor(model => model.Nombre, "", new { @class = "validation-message" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.Apellido, new { @class = "form-label" })
                    <div class="input-group">
                        <span class="input-icon"><i class="fas fa-user"></i></span>
                        @Html.TextBoxFor(model => model.Apellido, new { @class = "form-control", placeholder = "Ingrese el apellido", required = "required" })
                    </div>
                    @Html.ValidationMessageFor(model => model.Apellido, "", new { @class = "validation-message" })
                </div>
            </div>
        </div>

        <!-- Información de Contacto -->
        <div class="form-section">
            <h3 class="section-title"><i class="fas fa-address-book me-2"></i>Información de Contacto</h3>
            <div class="form-grid">

                <!-- Email -->
                <div class="form-group">
                    @Html.LabelFor(model => model.Email, new { @class = "form-label" })
                    <div class="input-group">
                        <span class="input-icon"><i class="fas fa-envelope"></i></span>
                        @Html.TextBoxFor(model => model.Email, new { @class = "form-control", placeholder = "correo@ejemplo.com", type = "email", required = "required" })
                    </div>
                    @Html.ValidationMessageFor(model => model.Email, "", new { @class = "validation-message" })
                </div>

                <!-- Teléfonos -->
                <div class="form-group">
                    @Html.Label("Teléfonos", new { @class = "form-label" })
                    <div id="telefonosContainer">
                        @if (Model.Telefonos != null && Model.Telefonos.Count > 0)
                        {
                            for (int i = 0; i < Model.Telefonos.Count; i++)
                            {
                                <div class="row mb-2 align-items-center telefono-item">
                                    @Html.HiddenFor(m => m.Telefonos[i].Id)

                                    <div class="col-md-3">
                                        @Html.TextBoxFor(m => m.Telefonos[i].Codigo, new
                                        {
                                            @class = "form-control",
                                            placeholder = "+506",
                                            maxlength = "4",
                                            required = "required",
                                            oninput = "let val = this.value.replace(/[^0-9]/g, ''); this.value = val.length > 0 ? '+' + val.substring(0, 3) : '';"
                                        })
                                    </div>

                                    <div class="col-md-5">
                                        @Html.TextBoxFor(m => m.Telefonos[i].Telefono, new
                                        {
                                            @class = "form-control",
                                            minlength = "8",
                                            maxlength = "8",
                                            placeholder = "Número",
                                            required = "required",
                                            oninput = "this.value = this.value.replace(/[^0-9]/g, '')"
                                        })
                                    </div>

                                    <div class="col-md-3">
                                        @Html.DropDownListFor(m => m.Telefonos[i].Tipo, new List<SelectListItem>
                                        {
                                            new SelectListItem { Text = "Personal", Value = "Personal", Selected = Model.Telefonos[i].Tipo == "Personal"},
                                            new SelectListItem { Text = "Trabajo", Value = "Trabajo", Selected = Model.Telefonos[i].Tipo == "Trabajo" },
                                            new SelectListItem { Text = "Hogar", Value = "Hogar", Selected = Model.Telefonos[i].Tipo == "Hogar" },
                                            new SelectListItem { Text = "Encargado", Value = "Encargado", Selected = Model.Telefonos[i].Tipo == "Encargado" },
                                            new SelectListItem { Text = "Otro", Value = "Otro" , Selected = Model.Telefonos[i].Tipo == "Otro"}
                                        }, "Seleccione un tipo", new { @class = "form-control", required = "required"})
                                    </div>

                                    <div class="col-md-1">
                                        <div class="toggle-group">
                                            <label class="toggle-label">
                                                @Html.CheckBoxFor(m => m.Telefonos[i].Estado, new { @class = "toggle-input" })
                                                <span class="toggle-slider"></span>
                                                <span class="toggle-text">@((Model.Telefonos[i].Estado) ? "Activo" : "Inactivo")</span>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted">No hay teléfonos registrados.</p>
                        }
                    </div>

                    <button type="button" id="addTelefono" class="btn btn-primary mt-2">
                        <i class="fas fa-plus me-1"></i>Agregar Teléfono
                    </button>
                </div>
            </div>
        </div>

        <!-- Información Adicional -->
        <div class="form-section">
            <h3 class="section-title"><i class="fas fa-info-circle me-2"></i>Información Adicional</h3>
            <div class="form-grid">
                <div class="form-group">
                    @Html.LabelFor(model => model.FechaDeNacimiento, new { @class = "form-label" })
                    <div class="input-group">
                        <span class="input-icon"><i class="fas fa-calendar"></i></span>
                        @Html.TextBoxFor(model => model.FechaDeNacimiento, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.Cedula, new { @class = "form-label" })
                    <div class="input-group">
                        <span class="input-icon"><i class="fas fa-id-card"></i></span>
                        @Html.TextBoxFor(model => model.Cedula, new { @class = "form-control", placeholder = "Número de cédula", required = "required" })
                    </div>
                </div>

                @if (Model.Rol == "Estudiantes")
                {
                    <div class="form-group">
                        @Html.Label("IdGrupo", "Grupo", new { @class = "form-label fw-bold" })
                        @Html.DropDownList("IdGrupo", (IEnumerable<SelectListItem>)ViewBag.ListaDeGrupos, "Seleccione un grupo", new { @class = "form-control" })
                    </div>
                }
            </div>
        </div>

        <!-- Configuración -->
        <div class="form-section">
            <h3 class="section-title"><i class="fas fa-cog me-2"></i>Configuración</h3>
            <div class="form-grid">
                <div class="form-group">
                    @Html.LabelFor(m => m.Rol, new { @class = "form-label" })
                    @Html.DropDownListFor(m => m.Rol, new List<SelectListItem>
                    {
                        new SelectListItem { Text = "Estudiante", Value = "Estudiantes" },
                        new SelectListItem { Text = "Profesor", Value = "Profesores" },
                        new SelectListItem { Text = "Administrador", Value = "Administradores" }
                    }, new { @class = "form-control", required = "required" })
                </div>
                <br />
                <div class="toggle-group mt-2">
                    <label class="toggle-label">
                        <input type="checkbox"
                               class="toggle-input"
                               name="estado"
                               id="estado"
                               value=@Model.Estado
                               @(Model.Estado ? "checked=\"checked\"" : "") />
                        <span class="toggle-slider"></span>
                        <span class="toggle-text">@(Model.Estado ? "Activo" : "Inactivo")</span>
                    </label>
                </div>
                <br />

            </div>
        </div>

        <!-- Footer -->
        <div class="edit-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                <i class="fas fa-times me-2"></i>Cancelar
            </button>
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save me-2"></i>Guardar Cambios
            </button>
        </div>
    </div>
}

<!-- CSS Reutilizable -->
<style>
    .toggle-group {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .toggle-label {
        display: inline-flex;
        align-items: center;
        cursor: pointer;
        user-select: none;
        gap: 10px;
    }

    .toggle-input {
        display: none;
    }

    .toggle-slider {
        position: relative;
        width: 50px;
        height: 25px;
        background-color: #ccc;
        border-radius: 25px;
        transition: all 0.3s ease;
    }

        .toggle-slider::before {
            content: "";
            position: absolute;
            width: 21px;
            height: 21px;
            left: 2px;
            top: 2px;
            background-color: white;
            border-radius: 50%;
            transition: all 0.3s ease;
        }

    .toggle-input:checked + .toggle-slider {
        background-color: #10b981;
    }

        .toggle-input:checked + .toggle-slider::before {
            transform: translateX(25px);
        }

    .toggle-text {
        font-weight: 600;
        color: #1e293b;
        min-width: 70px;
        transition: color 0.3s ease;
    }
</style>

<!-- JS Reutilizable -->
<script>
    $(function () {
        // Toggle principal y de teléfonos
        $(document).on('change', '.toggle-input', function () {
            const $text = $(this).siblings('.toggle-text');
            if (this.checked) {
                $text.text('Activo').css('color', '#10b981');
            } else {
                $text.text('Inactivo').css('color', '#ef4444');
            }
        });

        // Teléfonos dinámicos
        let phoneIndex = @(Model.Telefonos != null ? Model.Telefonos.Count : 0);
        $('#addTelefono').on('click', function (e) {
            e.preventDefault();

            const html = `
            <div class="row mb-2 align-items-center telefono-item">
                <input type="hidden" name="Telefonos[${phoneIndex}].Id" value="0" />
                <div class="col-md-3">
                    <input type="text" name="Telefonos[${phoneIndex}].Codigo" class="form-control"
                           maxlength="4" placeholder="+506" required
                           oninput="let val = this.value.replace(/[^0-9]/g, ''); this.value = val.length > 0 ? '+' + val.substring(0, 3) : '';">
                </div>
                <div class="col-md-5">
                    <input type="text" name="Telefonos[${phoneIndex}].Telefono" class="form-control"
                           minlength="8" maxlength="8" placeholder="Número" required
                           oninput="this.value = this.value.replace(/[^0-9]/g, '')">
                </div>
                <div class="col-md-3">
                    <select name="Telefonos[${phoneIndex}].Tipo" class="form-control" required>
                        <option value="">Seleccione un tipo</option>
                        <option value="Personal">Personal</option>
                        <option value="Trabajo">Trabajo</option>
                        <option value="Hogar">Hogar</option>
                        <option value="Encargado">Encargado</option>
                        <option value="Otro">Otro</option>
                    </select>
                </div>
                <div class="col-md-1">
                    <div class="toggle-group">
                        <label class="toggle-label">
                            <input type="checkbox" name="Telefonos[${phoneIndex}].Estado" class="toggle-input" checked />
                            <span class="toggle-slider"></span>
                            <span class="toggle-text">Activo</span>
                        </label>
                    </div>
                </div>
            </div>`;

            $('#telefonosContainer').append(html);
            phoneIndex++;
        });
    });
</script>
