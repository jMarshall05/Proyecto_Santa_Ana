@model Campus.UI.Models.IndexViewModel
@{
    ViewBag.Title = "Administrar Cuenta";
    <link rel="icon" type="image/png" href="~/Content/logo_SantaAna.ico" />
    @Styles.Render("~/Content/css")
    if (User.IsInRole("Administradores"))
    { Layout = "~/Views/Shared/_AdminLayout.cshtml"; }
    else if (User.IsInRole("Profesores") && User.IsInRole("Estudiantes"))
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
}

<main aria-labelledby="title" class="container mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">

            <h2 class="container-title mb-4">
                <i class="bi bi-person-badge me-2"></i>
                Mi cuenta
            </h2>

            @if (!string.IsNullOrEmpty(ViewBag.StatusMessage))
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    @ViewBag.StatusMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Card de Información General -->
            <div class="card shadow-lg mb-4 border-0 rounded-4">
                <div class="card-header border-0 rounded-top-4 d-flex align-items-center">
                    <h5 class="mb-0 fw-bold text-dark">
                        <i class="bi bi-info-circle me-2"></i>
                        Información General
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form id="formEditar" method="post" action="@Url.Action("EditarUsuario", "Usuarios")">
                        @Html.HiddenFor(m => m.Id)
                        <table class="table table-bordered table-striped align-middle premium-table">
                            <tbody>
                                <tr>
                                    <th class="fw-semibold" style="width: 30%;">
                                        <i class="bi bi-person me-2 text-dark"></i>
                                        @Html.DisplayNameFor(model => model.Nombre)
                                    </th>
                                    <td class="valor" data-campo="Nombre">@Model.Nombre</td>
                                </tr>
                                <tr>
                                    <th class="fw-semibold">
                                        <i class="bi bi-person me-2 text-dark"></i>
                                        @Html.DisplayNameFor(model => model.Apellido)
                                    </th>
                                    <td class="valor" data-campo="Apellido">@Model.Apellido</td>
                                </tr>
                                <tr>
                                    <th class="fw-semibold">@Html.DisplayNameFor(model => model.Telefonos)</th>
                                    <td class="valor" data-campo="Telefonos">
                                        @foreach (var telefono in Model.Telefonos)
                                        {
                                            <div class="telefono-item d-flex align-items-center justify-content-between py-1 px-2 mb-1 rounded shadow-sm bg-light">
                                                <span>(+@telefono.Codigo) @(telefono.Telefono.ToString().Insert(4, "-")): @telefono.Tipo</span>
                                                @if (telefono.Estado)
                                                {
                                                    <span class="badge bg-success fw-bold">Activo</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger fw-bold">Inactivo</span>
                                                }
                                            </div>
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <th class="fw-semibold">
                                        <i class="bi bi-envelope me-2 text-dark"></i>
                                        @Html.DisplayNameFor(model => model.Email)
                                    </th>
                                    <td>@Html.DisplayFor(model => model.Email)</td>
                                </tr>
                                <tr>
                                    <th class="fw-semibold">
                                        <i class="bi bi-card-text me-2 text-dark"></i>
                                        @Html.DisplayNameFor(model => model.Cedula)
                                    </th>
                                    <td>@Html.DisplayFor(model => model.Cedula)</td>
                                </tr>
                            </tbody>
                        </table>
                    </form>

                    <div class="d-flex justify-content-between mt-3 gap-2 flex-wrap">
                        <div>
                            @if (Model.HasPassword)
                            {
                                @Html.ActionLink("Cambiar contraseña", "ChangePassword", null, new { @class = "btn btn-gradient-warning fw-semibold shadow-sm" })
                            }
                            else
                            {
                                @Html.ActionLink("Crear contraseña", "SetPassword", null, new { @class = "btn btn-gradient-success fw-semibold shadow-sm" })
                            }
                        </div>
                        <div>
                            <button type="button" id="btnEditar" class="btn btn-gradient-primary fw-semibold shadow-sm">
                                <i class="bi bi-pencil-square me-2"></i>
                                Editar datos
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Card Autenticación 2FA -->
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-success bg-opacity-10 border-0 rounded-top-4 d-flex align-items-center">
                    <h5 class="mb-0 fw-bold text-success">
                        <i class="bi bi-shield-lock me-2"></i>
                        Autenticación en Dos Pasos (2FA)
                    </h5>
                </div>
                <div class="card-body p-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-3 mb-2 mb-sm-0 fw-semibold">Estado actual:</dt>
                        <dd class="col-sm-9">
                            @if (Model.TwoFactor)
                            {
                                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                                    <div>
                                        <span class="badge bg-success fs-6 me-2 shadow-sm">
                                            <i class="bi bi-check-circle-fill me-1"></i>
                                            Habilitado
                                        </span>
                                        <small class="text-muted d-block mt-1">
                                            Tu cuenta está protegida con verificación en dos pasos
                                        </small>
                                    </div>
                                    <a href="@Url.Action("DisableAuthenticator","Account")" class="btn btn-outline-danger btn-sm fw-semibold shadow-sm">
                                        <i class="bi bi-shield-x me-1"></i>
                                        Deshabilitar
                                    </a>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning mb-0 shadow-sm" role="alert">
                                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                                        <div>
                                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                            <strong>Deshabilitado</strong>
                                            <p class="mb-0 mt-1 small">
                                                Te recomendamos activar 2FA para mayor seguridad
                                            </p>
                                        </div>
                                        <a href="@Url.Action("EnableAuthenticator","Account")" class="btn btn-outline-danger btn-sm fw-semibold shadow-sm">
                                            <i class="bi bi-shield-x me-1"></i>
                                            Habilitar
                                        </a>
                                    </div>
                                </div>
                            }
                        </dd>
                    </dl>
                </div>
            </div>

        </div>
    </div>
</main>

@section scripts{
    <script src="~/Scripts/Manage/ManageScript.js"></script>
}

<style>
    /* Cards premium */
    .card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border: none;
    }

        .card:hover {
            transform: translateY(-4px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.12);
        }

    /* Títulos */
    .container-title {
        font-weight: 700;
        color: #1e3a8a;
        font-size: 1.8rem;
        letter-spacing: -0.5px;
    }

    /* Card Header negro */
    .card-header h5 {
        color: #000 !important;
    }

    /* Tablas premium sin color, letras negras */
    .premium-table {
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid #d1d9e6;
        background: #fff;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.05);
    }

        .premium-table th {
            font-weight: 600;
            text-transform: none; /* sin mayúsculas */
            font-size: 0.85rem;
            letter-spacing: 0.2px;
            background: #fff; /* sin color */
            color: #000 !important; /* letras negras */
            border-bottom: 1px solid #d1d9e6;
            padding: 1rem;
        }

        .premium-table td {
            vertical-align: middle;
            padding: 0.75rem 1rem;
            font-size: 0.95rem;
            color: #000 !important; /* letras negras */
            background: #fff;
        }

    .telefono-item {
        transition: 0.2s ease;
    }

        .telefono-item:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(52, 152, 219, 0.15);
        }

    /* Botones gradiente */
    .btn-gradient-primary {
        background: linear-gradient(135deg, #3498db, #3b82f6);
        color: white !important;
        border: none;
        border-radius: 12px;
        font-weight: 600;
        transition: all 0.3s;
    }

        .btn-gradient-primary:hover {
            background: linear-gradient(135deg, #1e40af, #2563eb);
            box-shadow: 0 4px 12px rgba(52, 152, 219, 0.3);
        }

    .btn-gradient-success {
        background: linear-gradient(135deg, #2ecc71, #27ae60);
        color: white !important;
        border: none;
        border-radius: 12px;
        font-weight: 600;
        transition: all 0.3s;
    }

        .btn-gradient-success:hover {
            background: linear-gradient(135deg, #27ae60, #1e8449);
            box-shadow: 0 4px 12px rgba(39, 174, 96, 0.3);
        }

    .btn-gradient-warning {
        background: linear-gradient(135deg, #f39c12, #f1c40f);
        color: white !important;
        border: none;
        border-radius: 12px;
        font-weight: 600;
        transition: all 0.3s;
    }

        .btn-gradient-warning:hover {
            background: linear-gradient(135deg, #d68910, #f39c12);
            box-shadow: 0 4px 12px rgba(243, 156, 18, 0.3);
        }

    /* Badges premium */
    .badge {
        font-weight: 600;
        font-size: 0.85rem;
        padding: 0.35rem 0.6rem;
        border-radius: 10px;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .container-title {
            font-size: 1.5rem;
        }

        .premium-table th, .premium-table td {
            font-size: 0.85rem;
            padding: 0.6rem 0.8rem;
        }

        .d-flex.justify-content-between {
            flex-direction: column;
            gap: 0.5rem;
        }

            .d-flex.justify-content-between > div {
                width: 100%;
            }

            .d-flex.justify-content-between .btn {
                width: 100%;
            }
    }

    @@media (max-width: 576px) {
        .container-title {
            font-size: 1.3rem;
        }

        .premium-table th, .premium-table td {
            font-size: 0.8rem;
            padding: 0.5rem 0.6rem;
        }
    }
</style>
