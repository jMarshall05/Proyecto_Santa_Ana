@model Campus.UI.Models.ChangePasswordViewModel
@{
    ViewBag.Title = "Cambiar contraseña";

    if (User.IsInRole("Administradores"))
    { Layout = "~/Views/Shared/_AdminLayout.cshtml"; }
    else
    { Layout = "~/Views/Shared/_Layout.cshtml"; }
}

<main aria-labelledby="title" class="container mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <h2 class="container-title mb-4">
                <i class="bi bi-person-badge me-2"></i>
                Cambiar contraseña
            </h2>

            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header border-0 rounded-top-4 d-flex align-items-center">
                    <h5 class="mb-0 fw-bold text-dark">
                        <i class="bi bi-lock-fill me-2"></i>
                        Seguridad de la cuenta
                    </h5>
                </div>

                <div class="card-body p-4">

                    @using (Html.BeginForm("ChangePassword", "Manage", FormMethod.Post, new { role = "form" }))
                    {
                        @Html.AntiForgeryToken()

                        @Html.ValidationSummary("", new { @class = "text-danger text-center mb-3" })

                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-unlock me-2"></i>
                                Contraseña actual
                            </label>
                            @Html.PasswordFor(m => m.OldPassword, new
                            {
                                @class = "form-control rounded-3",
                                placeholder = "Ingrese su contraseña actual"
                            })
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-lock me-2"></i>
                                Nueva contraseña
                            </label>
                            @Html.PasswordFor(m => m.NewPassword, new
                            {
                                @class = "form-control rounded-3",
                                placeholder = "Ingrese la nueva contraseña"
                            })
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-lock-check me-2"></i>
                                Confirmar contraseña
                            </label>
                            @Html.PasswordFor(m => m.ConfirmPassword, new
                            {
                                @class = "form-control rounded-3",
                                placeholder = "Confirme la nueva contraseña"
                            })
                        </div>

                        <div class="d-flex justify-content-between flex-wrap gap-2">
                            <a href="@Url.Action("Index","Manage")"
                               class="btn btn-outline-secondary fw-semibold shadow-sm">
                                <i class="bi bi-arrow-left me-1"></i>
                                Volver
                            </a>

                            <input type="submit"
                                   value="Cambiar contraseña"
                                   class="btn btn-gradient-warning fw-semibold shadow-sm px-4" />
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
</main>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

<style>
    /* Cards premium */
    .card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border: none;
    }

        .card:hover {
            transform: translateY(-4px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.12);
        }

    /* Títulos */
    .container-title {
        font-weight: 700;
        color: #1e3a8a;
        font-size: 1.8rem;
        letter-spacing: -0.5px;
    }

    /* Card Header negro */
    .card-header h5 {
        color: #000 !important;
    }

    /* Tablas premium sin color, letras negras */
    .premium-table {
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid #d1d9e6;
        background: #fff;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.05);
    }

        .premium-table th {
            font-weight: 600;
            text-transform: none; /* sin mayúsculas */
            font-size: 0.85rem;
            letter-spacing: 0.2px;
            background: #fff; /* sin color */
            color: #000 !important; /* letras negras */
            border-bottom: 1px solid #d1d9e6;
            padding: 1rem;
        }

        .premium-table td {
            vertical-align: middle;
            padding: 0.75rem 1rem;
            font-size: 0.95rem;
            color: #000 !important; /* letras negras */
            background: #fff;
        }

    .telefono-item {
        transition: 0.2s ease;
    }

        .telefono-item:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(52, 152, 219, 0.15);
        }

    /* Botones gradiente */
    .btn-gradient-primary {
        background: linear-gradient(135deg, #3498db, #3b82f6);
        color: white !important;
        border: none;
        border-radius: 12px;
        font-weight: 600;
        transition: all 0.3s;
    }

        .btn-gradient-primary:hover {
            background: linear-gradient(135deg, #1e40af, #2563eb);
            box-shadow: 0 4px 12px rgba(52, 152, 219, 0.3);
        }

    .btn-gradient-success {
        background: linear-gradient(135deg, #2ecc71, #27ae60);
        color: white !important;
        border: none;
        border-radius: 12px;
        font-weight: 600;
        transition: all 0.3s;
    }

        .btn-gradient-success:hover {
            background: linear-gradient(135deg, #27ae60, #1e8449);
            box-shadow: 0 4px 12px rgba(39, 174, 96, 0.3);
        }

    .btn-gradient-warning {
        background: linear-gradient(135deg, #f39c12, #f1c40f);
        color: white !important;
        border: none;
        border-radius: 12px;
        font-weight: 600;
        transition: all 0.3s;
    }

        .btn-gradient-warning:hover {
            background: linear-gradient(135deg, #d68910, #f39c12);
            box-shadow: 0 4px 12px rgba(243, 156, 18, 0.3);
        }

    /* Badges premium */
    .badge {
        font-weight: 600;
        font-size: 0.85rem;
        padding: 0.35rem 0.6rem;
        border-radius: 10px;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .container-title {
            font-size: 1.5rem;
        }

        .premium-table th, .premium-table td {
            font-size: 0.85rem;
            padding: 0.6rem 0.8rem;
        }

        .d-flex.justify-content-between {
            flex-direction: column;
            gap: 0.5rem;
        }

            .d-flex.justify-content-between > div {
                width: 100%;
            }

            .d-flex.justify-content-between .btn {
                width: 100%;
            }
    }

    @@media (max-width: 576px) {
        .container-title {
            font-size: 1.3rem;
        }

        .premium-table th, .premium-table td {
            font-size: 0.8rem;
            padding: 0.5rem 0.6rem;
        }
    }
</style>
