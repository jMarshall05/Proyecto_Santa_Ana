@model IEnumerable<Campus.Abstracciones.ModelosUI.TareaDto>

@{
    ViewBag.Title = "Listado de Tareas";

    if (User.Identity.IsAuthenticated)
    {
        if (User.IsInRole("Administradores"))
        {
            Layout = "~/Views/Shared/_AdminLayout.cshtml";
        }
        else
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
        }
    }
}

<div class="container-fluid px-lg-4 py-4">
    <!-- Header mejorado -->
    <div class="row mb-4 align-items-center">
        <div class="col-md-6">
            <div class="d-flex align-items-center">
                <div class="icon-container bg-primary rounded-circle p-3 me-3 shadow-sm">
                    <i class="fas fa-tasks text-white fs-4"></i>
                </div>
                <div>
                    @if (ViewBag.Grupo == null)
                    {
                        <h1 class="h3 mb-0 fw-bold text-dark">@ViewBag.Title</h1>
                    }
                    else
                    {
                        <h1 class="h3 mb-0 fw-bold text-dark">@ViewBag.Title del grupo @ViewBag.Grupo</h1>
                        <p class="text-muted mb-0">@ViewBag.Materia</p>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="d-flex justify-content-end">
                @if (ViewBag.Grupo == null)
                {
                    <a href="@Url.Action("Create")" class="btn btn-primary btn-lg shadow-sm d-flex align-items-center">
                        <i class="fas fa-plus-circle me-2"></i> Nueva Tarea
                    </a>
                }
                else
                {
                    <a class="btn btn-primary btn-lg shadow-sm d-flex align-items-center btn-createParcial"
                       data-idmateria="@ViewBag.materiaId" data-idgrupo="@ViewBag.grupoId">
                        <i class="fas fa-plus-circle me-2"></i> Nueva Tarea
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- Alertas mejoradas -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2 fs-5"></i>
            <div class="flex-grow-1">@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Tarjeta de estadísticas -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body py-3">
                    <div class="row text-center">
                        <div class="col-md-3 border-end">
                            <div class="d-flex flex-column">
                                <span class="fs-4 fw-bold text-primary">@Model.Count()</span>
                                <span class="text-muted small">Total Tareas</span>
                            </div>
                        </div>
                        <div class="col-md-3 border-end">
                            <div class="d-flex flex-column">
                                <span class="fs-4 fw-bold text-warning">@Model.Count(t => t.FechaEntrega.Date == DateTime.Today)</span>
                                <span class="text-muted small">Para Hoy</span>
                            </div>
                        </div>
                        <div class="col-md-3 border-end">
                            <div class="d-flex flex-column">
                                <span class="fs-4 fw-bold text-info">@Model.Count(t => t.FechaEntrega > DateTime.Now)</span>
                                <span class="text-muted small">Pendientes</span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="d-flex flex-column">
                                <span class="fs-4 fw-bold text-success">@Model.Count(t => !string.IsNullOrEmpty(t.ArchivoAdjunto))</span>
                                <span class="text-muted small">Con Archivos</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla mejorada -->
    <div class="card border-0 shadow-lg overflow-hidden">
        <div class="card-header bg-white py-3 border-bottom">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <h5 class="mb-0 fw-bold text-dark">
                        <i class="fas fa-list-alt me-2 text-primary"></i>Detalles de Tareas
                    </h5>
                </div>
                <div class="col-md-6">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light border-0">
                            <i class="fas fa-search text-muted"></i>
                        </span>
                        <input type="text" id="searchInput" class="form-control border-0 bg-light" placeholder="Buscar tareas...">
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0" id="tareasTable">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4 py-3 text-uppercase fw-semibold small border-0">Título</th>
                            <th class="py-3 text-uppercase fw-semibold small border-0">Grupo</th>
                            <th class="py-3 text-uppercase fw-semibold small border-0">Fecha Entrega</th>
                            <th class="py-3 text-uppercase fw-semibold small border-0">Archivo</th>
                            <th class="pe-4 py-3 text-uppercase fw-semibold small border-0 text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="border-bottom">
                                <td class="ps-4 py-3 align-middle">
                                    <div class="d-flex align-items-center">
                                        <div class="icon-sm bg-light-primary rounded-circle d-flex align-items-center justify-content-center me-3">
                                            <i class="fas fa-clipboard-list text-primary fs-6"></i>
                                        </div>
                                        <div>
                                            <h6 class="mb-0 fw-semibold">@Html.DisplayFor(modelItem => item.Titulo)</h6>
                                            @if (!string.IsNullOrEmpty(item.Descripcion) && item.Descripcion.Length > 50)
                                            {
                                                <small class="text-muted">@item.Descripcion.Substring(0, 50)...</small>
                                            }
                                            else if (!string.IsNullOrEmpty(item.Descripcion))
                                            {
                                                <small class="text-muted">@item.Descripcion</small>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3 align-middle">
                                    @if (item.Id_grupo > 0)
                                    {
                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-3 py-2">
                                            <i class="fas fa-users me-1"></i> @item.Nombre_grupo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border px-3 py-2">
                                            <i class="fas fa-ban me-1"></i> Sin grupo
                                        </span>
                                    }
                                </td>
                                <td class="py-3 align-middle">
                                    <div class="d-flex flex-column">
                                        <span class="fw-semibold">@item.FechaEntrega.ToString("dd/MM/yyyy")</span>
                                        <small class="text-muted">@item.FechaEntrega.ToString("HH:mm") hrs</small>
                                    </div>
                                </td>
                                <td class="py-3 align-middle">
                                    @if (!string.IsNullOrEmpty(item.ArchivoAdjunto))
                                    {
                                        <a href="@Url.Content(item.ArchivoAdjunto)" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                            <i class="fas fa-download me-1"></i> Descargar
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Sin archivo</span>
                                    }
                                </td>
                                <td class="pe-4 py-3 align-middle text-end">
                                    <div class="btn-group" role="group">
                                        <a href="@Url.Action("Edit", new { id = item.IdTarea })"
                                           class="btn btn-sm btn-outline-warning rounded-start-pill px-3"
                                           data-bs-toggle="tooltip" title="Editar tarea">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a href="@Url.Action("Details", new { id = item.IdTarea })"
                                           class="btn btn-sm btn-outline-info rounded-0 px-3"
                                           data-bs-toggle="tooltip" title="Ver detalles">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="@Url.Action("Index","Entregas", new { idTarea = item.IdTarea })"
                                           class="btn btn-sm btn-outline-success rounded-0 px-3"
                                           data-bs-toggle="tooltip" title="Ver entregas">
                                            <i class="fas fa-download"></i>
                                        </a>
                                        @using (Html.BeginForm("Delete", "Tareas", new { id = item.IdTarea }, FormMethod.Post, new { onsubmit = "return confirm('¿Estás seguro de que deseas eliminar esta tarea?');", @class = "d-inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-end-pill px-3"
                                                    data-bs-toggle="tooltip" title="Eliminar tarea">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white py-3 border-top">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <p class="mb-0 text-muted small">
                        Mostrando <span class="fw-semibold">@Model.Count()</span> tareas
                    </p>
                </div>
                <div class="col-md-6 d-flex justify-content-end">
                    <nav aria-label="Navegación de tareas">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item disabled">
                                <a class="page-link" href="#" tabindex="-1" aria-disabled="true">Anterior</a>
                            </li>
                            <li class="page-item active"><a class="page-link" href="#">1</a></li>
                            <li class="page-item"><a class="page-link" href="#">2</a></li>
                            <li class="page-item"><a class="page-link" href="#">3</a></li>
                            <li class="page-item">
                                <a class="page-link" href="#">Siguiente</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal mejorado -->
<div class="modal fade" id="TareasModal" tabindex="-1" aria-labelledby="TareasModalTittleLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header bg-gradient-primary text-white">
                <h1 class="modal-title fs-5 d-flex align-items-center" id="TareasModalTittleLabel">
                    <i class="fas fa-tasks me-2"></i>
                    <span>Agregar Nueva Tarea</span>
                </h1>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
            </div>
            <div class="modal-footer bg-light">
                <button class="btn btn-secondary px-4 rounded-pill" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

@section styles {
    <style>
        :root {
            --primary-color: #4e73df;
            --primary-dark: #224abe;
            --success-color: #1cc88a;
            --warning-color: #f6c23e;
            --info-color: #36b9cc;
            --danger-color: #e74a3b;
            --light-color: #f8f9fc;
            --dark-color: #5a5c69;
        }

        .icon-container {
            width: 60px;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .icon-sm {
            width: 40px;
            height: 40px;
        }

        .bg-light-primary {
            background-color: rgba(78, 115, 223, 0.1) !important;
        }

        .bg-gradient-primary {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%) !important;
        }

        .btn {
            border-radius: 10px;
            font-weight: 500;
            transition: all 0.3s ease;
        }

            .btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
            }

        .btn-primary {
            background: var(--primary-color);
            border-color: var(--primary-color);
        }

            .btn-primary:hover {
                background: var(--primary-dark);
                border-color: var(--primary-dark);
            }

        .table th {
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-top: none;
            color: var(--dark-color);
        }

        .table tbody tr {
            transition: all 0.2s ease;
        }

            .table tbody tr:hover {
                background-color: rgba(78, 115, 223, 0.03);
                transform: translateY(-1px);
                box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
            }

        .badge {
            font-size: 0.75rem;
            padding: 0.35em 0.65em;
            font-weight: 500;
        }

        .card {
            border-radius: 15px;
            overflow: hidden;
        }

        .card-header {
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        }

        .input-group-text {
            border-radius: 10px 0 0 10px;
        }

        .form-control {
            border-radius: 0 10px 10px 0;
        }

            .form-control:focus {
                box-shadow: none;
                border-color: var(--primary-color);
            }

        .pagination .page-link {
            border-radius: 8px;
            margin: 0 2px;
            border: none;
            color: var(--dark-color);
        }

        .pagination .page-item.active .page-link {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
        }

        /* Mejoras al Modal */
        #TareasModal .modal-content {
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2);
            border: none;
        }

        #TareasModal .modal-header {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
            border-bottom: none;
            padding: 1.5rem 2rem;
            position: relative;
        }

            #TareasModal .modal-header::after {
                content: '';
                position: absolute;
                bottom: 0;
                left: 0;
                right: 0;
                height: 3px;
                background: rgba(255, 255, 255, 0.2);
            }

        #TareasModal .modal-title {
            font-size: 1.3rem;
            font-weight: 600;
            letter-spacing: 0.3px;
        }

            #TareasModal .modal-title i {
                font-size: 1.2rem;
                opacity: 0.9;
            }

        #TareasModal .btn-close {
            opacity: 0.8;
            transition: all 0.3s ease;
            filter: brightness(0) invert(1);
        }

            #TareasModal .btn-close:hover {
                opacity: 1;
                transform: rotate(90deg) scale(1.1);
            }

        #TareasModal .modal-body {
            padding: 2.5rem 2rem;
            max-height: 70vh;
            overflow-y: auto;
            background: var(--light-color);
        }

            /* Scrollbar personalizado para el modal */
            #TareasModal .modal-body::-webkit-scrollbar {
                width: 8px;
            }

            #TareasModal .modal-body::-webkit-scrollbar-track {
                background: #f1f1f1;
                border-radius: 10px;
            }

            #TareasModal .modal-body::-webkit-scrollbar-thumb {
                background: linear-gradient(to bottom, var(--primary-color), var(--primary-dark));
                border-radius: 10px;
            }

                #TareasModal .modal-body::-webkit-scrollbar-thumb:hover {
                    background: linear-gradient(to bottom, var(--primary-dark), #1a3a8f);
                }

            /* Input dentro del filtro */
            .filter-card input {
                border: none;
                outline: none;
                box-shadow: none;
                width: 100%;
            }

        /* Botones premium */
        .premium-btn-primary {
            background: linear-gradient(90deg, #4e73df, #224abe);
            color: #fff;
            border-radius: 10px;
            font-weight: 500;
            letter-spacing: 0.3px;
            transition: all 0.3s ease;
            border: 2px solid #858796;
            padding: 0.7rem 1.5rem;
            background: #fff;
            color: #858796;
        }

            #TareasModal .btn-secondary:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(133, 135, 150, 0.3);
                background: #858796;
                color: white;
            }

            .premium-btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(34,74,190,0.4);
            }

        /* Ripple effect */
        .ripple {
            position: relative;
            overflow: hidden;
        }

        .ripple-effect {
            position: absolute;
            border-radius: 50%;
            background: rgba(255,255,255,0.5);
            transform: scale(0);
            animation: ripple 0.6s linear;
            pointer-events: none;
        }

        @@keyframes ripple {
            to {
                transform: scale(4);
                opacity: 0;
            }

            .btn-group .btn {
                padding: 0.375rem 0.5rem;
                font-size: 0.75rem;
            }
        }

        /* Estados de las tareas */
        .task-pending {
            border-left: 4px solid var(--warning-color);
        }

        .task-completed {
            border-left: 4px solid var(--success-color);
        }

        .task-overdue {
            border-left: 4px solid var(--danger-color);
        }
    </style>
}

@section scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <script src="~/Scripts/Tareas/ScriptTareas.js"></script>
    <script>
        // Inicializar tooltips
        document.addEventListener('DOMContentLoaded', function () {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl)
            });

            // Funcionalidad de búsqueda
            const searchInput = document.getElementById('searchInput');
            if (searchInput) {
                searchInput.addEventListener('keyup', function () {
                    const filter = this.value.toLowerCase();
                    const rows = document.querySelectorAll('#tareasTable tbody tr');

                    rows.forEach(row => {
                        const text = row.textContent.toLowerCase();
                        row.style.display = text.includes(filter) ? '' : 'none';
                    });
                });
            }
        });
    </script>
}
