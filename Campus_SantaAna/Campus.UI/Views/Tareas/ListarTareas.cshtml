@model IEnumerable<Campus.Abstracciones.ModelosUI.TareaDto>

@{
    ViewBag.Title = "Listado de Tareas";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-md-6">
            <h2>@ViewBag.Title</h2>
        </div>
        <div class="col-md-6">
            <div class="d-flex justify-content-end">
                <a href="@Url.Action("Create")" class="btn btn-primary">
                    <i class="fas fa-plus mr-2"></i>Nueva Tarea
                </a>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover table-striped">
                    <thead class="thead-light">
                        <tr>
                            <th>Título</th>
                            <th>Grupo</th>
                            <th>Fecha Entrega</th>
                            <th>Archivo</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@Html.DisplayFor(modelItem => item.Titulo)</td>
                                <td>
                                    @if (item.Id_grupo > 0)
                                    {
                                        <span class="badge bg-primary">
                                            <i class="fas fa-users me-1"></i> @item.Nombre_grupo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Sin grupo</span>
                                    }
                                </td>
                                <td>@item.FechaEntrega.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.ArchivoAdjunto))
                                    {
                                        <a href="@Url.Content(item.ArchivoAdjunto)" target="_blank" class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-download"></i>
                                        </a>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a href="@Url.Action("Edit", new { id = item.IdTarea })" class="btn btn-sm btn-outline-warning">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a href="@Url.Action("Details", new { id = item.IdTarea })" class="btn btn-sm btn-outline-info">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        @using (Html.BeginForm("Delete", "Tareas", new { id = item.IdTarea }, FormMethod.Post, new { onsubmit = "return confirm('¿Estás seguro de que deseas eliminar esta tarea?');", @class = "d-inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        }


                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section styles {
    <style>
        .table th {
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 0.5px;
            border-top: none;
        }

        .badge {
            font-size: 0.75rem;
            padding: 0.35em 0.65em;
        }

        .btn-group .btn {
            padding: 0.25rem 0.5rem;
        }

        .table-responsive {
            overflow-x: auto;
        }
    </style>
}

@section scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <script>
        // Cerrar automáticamente los mensajes de alerta después de 5 segundos
        $(document).ready(function () {
            setTimeout(function () {
                $('.alert').alert('close');
            }, 5000);
        });
    </script>
}
