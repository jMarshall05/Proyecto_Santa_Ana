@model Campus.Abstracciones.ModelosUI.TareaDto
@{
    ViewBag.Title = "Editar Tarea";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-gradient-primary text-white">
            <h3 class="card-title mb-0">
                <i class="fas fa-edit mr-2"></i>Editar Tarea
            </h3>
        </div>

        <div class="card-body py-4">
            @using (Html.BeginForm(null, null, FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary("", new { @class = "text-danger" })
                @Html.HiddenFor(model => model.IdTarea)
                <div class="row">
                    <!-- Columna Izquierda - Título y Descripción -->
                    <div class="col-md-6">
                        <!-- Título -->
                        <div class="form-group mb-4">
                            @Html.LabelFor(model => model.Titulo, new { @class = "font-weight-bold text-primary mb-2" })
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-light h-100">
                                        <i class="fas fa-heading text-primary"></i>
                                    </span>
                                </div>
                                @Html.EditorFor(model => model.Titulo, new
                                {
                                    htmlAttributes = new
                                    {
                                        @class = "form-control",
                                        placeholder = "Ej: Presentación final del proyecto"
                                    }
                                })
                            </div>
                            @Html.ValidationMessageFor(model => model.Titulo, "", new { @class = "text-danger small" })
                        </div>

                        <!-- Descripción -->
                        <div class="form-group mb-4">
                            @Html.LabelFor(model => model.Descripcion, new { @class = "font-weight-bold text-primary mb-2" })
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-light h-100 align-items-start pt-3">
                                        <i class="fas fa-align-left text-primary"></i>
                                    </span>
                                </div>
                                @Html.TextAreaFor(model => model.Descripcion, new
                                {
                                    @class = "form-control",
                                    rows = 4,
                                    placeholder = "Describa los detalles de la tarea..."
                                })
                            </div>
                            @Html.ValidationMessageFor(model => model.Descripcion, "", new { @class = "text-danger small" })
                        </div>
                    </div>

                    <!-- Columna Derecha - Grupo y Fechas -->
                    <div class="col-md-6">
                        <!-- Grupo -->
                        <div class="form-group mb-4">
                            @Html.LabelFor(model => model.id_grupo, "Grupo", new { @class = "font-weight-bold text-primary mb-2" })
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-light h-100">
                                        <i class="fas fa-users text-primary"></i>
                                    </span>
                                </div>
                                @Html.DropDownListFor(model => model.id_grupo, (IEnumerable<SelectListItem>)ViewBag.Grupos, "Seleccione un grupo", new { @class = "form-control" })

                            </div>
                            @Html.ValidationMessageFor(model => model.id_grupo, "", new { @class = "text-danger small" })
                        </div>

                        <!-- Campo oculto para fecha de modificación (para que no sea null si el back lo usa directamente) -->
                        @Html.HiddenFor(model => model.FechaModificacion, new { Value = DateTime.Now.ToString("yyyy-MM-ddTHH:mm:ss") })


                        <!-- Fecha de Entrega -->
                        <div class="form-group mb-4">
                            @Html.LabelFor(model => model.FechaEntrega, new { @class = "font-weight-bold text-primary mb-2" })
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-light h-100">
                                        <i class="far fa-calendar-alt text-primary"></i>
                                    </span>
                                </div>
                                @Html.EditorFor(model => model.FechaEntrega, new
                                {
                                    htmlAttributes = new
                                    {
                                        @class = "form-control",
                                        type = "datetime-local"
                                    }
                                })
                            </div>
                            @Html.ValidationMessageFor(model => model.FechaEntrega, "", new { @class = "text-danger small" })
                        </div>

                        <!-- Fecha de Publicación -->
                        <div class="form-group mb-4">
                            @Html.LabelFor(model => model.FechaPublicacion, new { @class = "font-weight-bold text-primary mb-2" })
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-light h-100">
                                        <i class="far fa-calendar-check text-primary"></i>
                                    </span>
                                </div>
                                @Html.EditorFor(model => model.FechaPublicacion, new
                                {
                                    htmlAttributes = new
                                    {
                                        @class = "form-control",
                                        type = "datetime-local"
                                    }
                                })
                            </div>
                            @Html.ValidationMessageFor(model => model.FechaPublicacion, "", new { @class = "text-danger small" })
                        </div>
                    </div>
                </div>

                <!-- Archivo Adjunto -->
                <div class="form-group mb-4">
                    @Html.Label("Archivo Adjunto", new { @class = "font-weight-bold text-primary mb-2" })

                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text bg-light h-100">
                                <i class="fas fa-paperclip text-primary"></i>
                            </span>
                        </div>
                        <input type="file" name="Archivo" class="form-control" id="archivoInput" />
                    </div>

                    @if (Model != null && !string.IsNullOrEmpty(Model.ArchivoAdjunto))
                    {
                        <div id="archivoActual" class="mt-2 d-flex align-items-center">
                            <a href="@Url.Content(Model.ArchivoAdjunto)"
                               class="btn btn-outline-primary btn-sm"
                               target="_blank">
                                <i class="fas fa-download mr-1"></i> @Path.GetFileName(Model.ArchivoAdjunto)
                            </a>

                            <button type="button" class="btn btn-sm btn-danger ms-2" id="quitarArchivo">
                                <i class="fas fa-times"></i> Quitar
                            </button>
                        </div>

                        <input type="hidden" name="ArchivoAdjuntoActual" value="@Model.ArchivoAdjunto" />
                        <input type="hidden" name="EliminarArchivo" id="EliminarArchivo" value="false" />
                    }
                </div>

                <!-- Botones -->
                <div class="row justify-content-center mt-3">
                    <div class="col-md-8 text-center">
                        <button type="submit" class="btn btn-primary btn-lg px-4 mr-4">
                            <i class="fas fa-save mr-2"></i>Guardar Cambios
                        </button>
                        <a href="@Url.Action("ListarTareas")" class="btn btn-danger btn-lg px-4">
                            <i class="fas fa-times mr-2"></i>Cancelar
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card {
            border-radius: 15px;
            overflow: hidden;
            border: none;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        }

        .card-header {
            border-radius: 15px 15px 0 0 !important;
            background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);
        }

        .form-control, .input-group-text {
            border-radius: 8px;
            transition: all 0.3s;
            height: calc(2.25rem + 8px);
        }

            .form-control:focus {
                box-shadow: 0 0 0 0.2rem rgba(78, 115, 223, 0.25);
                border-color: #a1b5f1;
            }

        .input-group-text {
            background-color: #f8f9fc;
            border-right: none;
            width: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .input-group-text i {
                font-size: 1.1rem;
            }

        textarea.form-control {
            height: auto !important;
            min-height: 120px;
        }

        .btn-primary {
            background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);
            border: none;
            box-shadow: 0 4px 6px rgba(50, 50, 93, 0.11);
        }

            .btn-primary:hover {
                transform: translateY(-1px);
                box-shadow: 0 7px 14px rgba(50, 50, 93, 0.1);
            }

        .btn-danger {
            background: linear-gradient(135deg, #e74a3b 0%, #be2617 100%);
            border: none;
            box-shadow: 0 4px 6px rgba(231, 74, 59, 0.11);
        }

            .btn-danger:hover {
                background: linear-gradient(135deg, #be2617 0%, #9c1c10 100%);
                transform: translateY(-1px);
                box-shadow: 0 7px 14px rgba(231, 74, 59, 0.1);
            }

        label {
            font-size: 0.9rem;
            letter-spacing: 0.5px;
            margin-bottom: 0.5rem;
        }

        .mr-4 {
            margin-right: 1.5rem !important;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }
    </style>
}

@section Scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

    <script>
        $(document).ready(function () {
            // Formatear fechas para datetime-local
            function formatDateForInput(date) {
                if (!date) return '';
                const d = new Date(date);
                return d.toISOString().slice(0, 16);
            }

            // Evento para ocultar el archivo y marcar eliminación
            $('#quitarArchivo').on('click', function () {
                $('#archivoActual').hide().css('display', 'none');
                $('#EliminarArchivo').val("true");

                // Opcional: Limpiar el input de archivo
                $('#archivoInput').val('');

                // Mostrar mensaje de confirmación
                $(this).closest('.form-group').append(
                    '<div class="alert alert-info mt-2" id="mensajeArchivo">' +
                    '<i class="fas fa-info-circle mr-2"></i>El archivo será eliminado al guardar los cambios.' +
                    '</div>'
                );
            });

            // Evento para cuando se selecciona un nuevo archivo
            $('#archivoInput').on('change', function () {
                if (this.files && this.files.length > 0) {
                    // Si hay un archivo actual, ocultarlo
                    $('#archivoActual').hide().css('display', 'none');
                    $('#EliminarArchivo').val("true");

                    // Remover mensaje anterior si existe
                    $('#mensajeArchivo').remove();

                    // Mostrar información del nuevo archivo
                    var fileName = this.files[0].name;
                    var fileSize = (this.files[0].size / 1024 / 1024).toFixed(2);

                    $(this).closest('.form-group').append(
                        '<div class="alert alert-success mt-2" id="mensajeArchivo">' +
                        '<i class="fas fa-check-circle mr-2"></i>Nuevo archivo seleccionado: ' + fileName + ' (' + fileSize + ' MB)' +
                        '</div>'
                    );
                }
            });
        });
    </script>
}