@model Campus.Abstracciones.ModelosUI.TareaDto
@{
    ViewBag.Title = "Editar Tarea";
    if (User.Identity.IsAuthenticated)
    {
        if (User.IsInRole("Administradores"))
        {
            Layout = "~/Views/Shared/_AdminLayout.cshtml";
        }
        else
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
        }
    }
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <!-- Centrado horizontal -->
        <div class="col-lg-10">
            <!-- Ancho de la tarjeta -->
            <div class="card shadow-lg border-0">
                <div class="card-header bg-gradient-primary text-white">
                    <h3 class="card-title mb-0">
                        <i class="fas fa-plus-circle mr-2"></i>@ViewBag.Title
                    </h3>
                </div>

                <div class="card-body py-4">
                    @using (Html.BeginForm("Edit", "Tareas", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary("", new { @class = "text-danger" })
                        @Html.HiddenFor(model => Model.FechaPublicacion)
                        <input type="hidden" name="archivoAdjuntoActual" id="archivoAdjuntoActual" value="@Model.ArchivoAdjunto" />
                        <input type="hidden" name="eliminarArchivo" id="eliminarArchivo" value="false" />

                        <div class="row">
                            <div class="col-md-6">
                                <!-- Título -->
                                <div class="form-group mb-4">
                                    @Html.LabelFor(model => model.Titulo, new { @class = "font-weight-bold text-primary mb-2" })
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text bg-light h-100">
                                                <i class="fas fa-heading text-primary"></i>
                                            </span>
                                        </div>
                                        @Html.EditorFor(model => model.Titulo, new
                                        {
                                            htmlAttributes = new
                                            {
                                                @class = "form-control",
                                                placeholder = "Ej: Presentación final del proyecto"
                                            }
                                        })
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Titulo, "", new { @class = "text-danger small" })
                                </div>
                            </div>

                            <!-- Materia -->
                            <div class="col-md-6">
                                <div class="form-group mb-4">
                                    @Html.LabelFor(model => model.IdMateria, "Materia", new { @class = "font-weight-bold text-primary mb-2" })
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text bg-light h-100">
                                                <i class="fas fa-users text-primary"></i>
                                            </span>
                                        </div>
                                        @Html.DropDownListFor(model => model.IdMateria,
                                            (SelectList)ViewBag.Materia,
                                            "Seleccione una materia",
                                            new { @class = "form-control" })
                                    </div>
                                    @Html.ValidationMessageFor(model => model.IdMateria, "", new { @class = "text-danger small" })
                                </div>
                            </div>
                        </div>


                        <div class="row">
                            <!-- Descripción -->
                            <div class="col-md-6">
                                <div class="form-group mb-4">
                                    @Html.LabelFor(model => model.Descripcion, new { @class = "font-weight-bold text-primary mb-2" })
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text bg-light h-100 align-items-start pt-3">
                                                <i class="fas fa-align-left text-primary"></i>
                                            </span>
                                        </div>
                                        @Html.TextAreaFor(model => model.Descripcion, new
                                        {
                                            @class = "form-control",
                                            rows = 4,
                                            placeholder = "Describa los detalles de la tarea..."
                                        })
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Descripcion, "", new { @class = "text-danger small" })
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group mb-4">
                                    @Html.LabelFor(model => model.Id_grupo, "Grupo", new { @class = "font-weight-bold text-primary mb-2" })
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text bg-light h-100">
                                                <i class="fas fa-users text-primary"></i>
                                            </span>
                                        </div>
                                        @Html.DropDownListFor(model => model.Id_grupo,
                                            (SelectList)ViewBag.Grupos,
                                            "Seleccione un grupo",
                                            new { @class = "form-control" })
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Id_grupo, "", new { @class = "text-danger small" })
                                </div>
                            </div>

                        </div>




                        <div class="row">
                            <!-- Archivo Adjunto -->
                            <div class="col-md-6">
                                <div class="form-group mb-4">
                                    @Html.LabelFor(model => model.Archivo, new { @class = "font-weight-bold text-primary mb-2" })

                                    <!-- Mostrar archivo actual si existe -->
                                    @if (!string.IsNullOrEmpty(Model.ArchivoAdjunto))
                                    {
                                        <div class="alert alert-info d-flex justify-content-between align-items-center mb-3" id="archivoActual">
                                            <div>
                                                <i class="fas fa-paperclip mr-2"></i>
                                                <span>Archivo actual: @System.IO.Path.GetFileName(Model.ArchivoAdjunto)</span>
                                            </div>
                                            <button type="button" class="btn btn-sm btn-outline-danger" id="quitarArchivo">
                                                <i class="fas fa-times"></i> Quitar
                                            </button>
                                        </div>
                                    }

                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text bg-light h-100">
                                                <i class="fas fa-paperclip text-primary"></i>
                                            </span>
                                        </div>
                                        @Html.TextBoxFor(model => model.Archivo, new
                                        {
                                            type = "file",
                                            @class = "form-control",
                                            id = "archivoInput"
                                        })
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Archivo, "", new { @class = "text-danger small" })
                                </div>
                            </div>
                            <!-- Fecha de Entrega -->
                            <div class="col-md-6">
                                <div class="form-group mb-4">
                                    @Html.LabelFor(model => model.FechaEntrega, new { @class = "font-weight-bold text-primary mb-2" })
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text bg-light h-100">
                                                <i class="far fa-calendar-alt text-primary"></i>
                                            </span>
                                        </div>
                                        @Html.EditorFor(model => model.FechaEntrega, new
                                        {
                                            htmlAttributes = new
                                            {
                                                @class = "form-control",
                                                type = "datetime-local"
                                            }
                                        })
                                    </div>
                                    @Html.ValidationMessageFor(model => model.FechaEntrega, "", new { @class = "text-danger small" })
                                </div>
                            </div>
                        </div>



                        <div class="form-group mt-5">
                            <div class="d-flex justify-content-center">
                                <button type="submit" class="btn btn-primary btn-lg mr-3 px-4">
                                    <i class="fas fa-save mr-2"></i>Guardar Tarea
                                </button>
                                <a href="@Url.Action("ListarTareas")" class="btn btn-outline-secondary btn-lg px-4 ml-3">
                                    <i class="fas fa-times mr-2"></i>Cancelar
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card {
            border-radius: 15px;
            overflow: hidden;
            border: none;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        }

        .card-header {
            border-radius: 15px 15px 0 0 !important;
            background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);
        }

        .form-control, .input-group-text {
            border-radius: 8px;
            transition: all 0.3s;
            height: calc(2.25rem + 8px);
        }

            .form-control:focus {
                box-shadow: 0 0 0 0.2rem rgba(78, 115, 223, 0.25);
                border-color: #a1b5f1;
            }

        .input-group-text {
            background-color: #f8f9fc;
            border-right: none;
            width: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .input-group-text i {
                font-size: 1.1rem;
            }

        textarea.form-control {
            height: auto !important;
            min-height: 120px;
        }

        .btn-primary {
            background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);
            border: none;
            box-shadow: 0 4px 6px rgba(50, 50, 93, 0.11);
        }

            .btn-primary:hover {
                transform: translateY(-1px);
                box-shadow: 0 7px 14px rgba(50, 50, 93, 0.1);
            }

        .btn-danger {
            background: linear-gradient(135deg, #e74a3b 0%, #be2617 100%);
            border: none;
            box-shadow: 0 4px 6px rgba(231, 74, 59, 0.11);
        }

            .btn-danger:hover {
                background: linear-gradient(135deg, #be2617 0%, #9c1c10 100%);
                transform: translateY(-1px);
                box-shadow: 0 7px 14px rgba(231, 74, 59, 0.1);
            }

        label {
            font-size: 0.9rem;
            letter-spacing: 0.5px;
            margin-bottom: 0.5rem;
        }

        .mr-4 {
            margin-right: 1.5rem !important;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }
    </style>
}

@section Scripts {
    <script>
        $(document).ready(function () {
            // Evento para quitar archivo actual
            $('#quitarArchivo').on('click', function () {
                $('#archivoActual').hide();
                $('#eliminarArchivo').val("true");
                $('#archivoInput').val('');

                // Mostrar mensaje
                $(this).closest('.form-group').append(
                    '<div class="alert alert-warning mt-2" id="mensajeArchivo">' +
                    '<i class="fas fa-exclamation-triangle mr-2"></i>El archivo será eliminado al guardar los cambios.' +
                    '</div>'
                );
            });

            // Evento cuando se selecciona nuevo archivo
            $('#archivoInput').on('change', function () {
                if (this.files && this.files.length > 0) {
                    // Ocultar archivo actual y marcar para eliminar
                    $('#archivoActual').hide();
                    $('#eliminarArchivo').val("true");
                    $('#mensajeArchivo').remove();

                    // Mostrar info del nuevo archivo
                    var fileName = this.files[0].name;
                    $(this).closest('.form-group').append(
                        '<div class="alert alert-success mt-2" id="mensajeArchivo">' +
                        '<i class="fas fa-check-circle mr-2"></i>Nuevo archivo seleccionado: ' + fileName +
                        '</div>'
                    );
                }
            });
        });
    </script>
}