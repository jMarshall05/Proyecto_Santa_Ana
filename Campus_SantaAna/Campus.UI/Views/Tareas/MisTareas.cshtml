@model IEnumerable<Campus.Abstracciones.ModelosUI.TareaDto>

@{
    ViewBag.Title = "Mis Tareas";
}

<h2>Mis Tareas Asignadas</h2>

@if (!Model.Any())
{
    <p>No tienes tareas asignadas.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Título</th>
                <th>Descripción</th>
                <th>Fecha Entrega</th>
                <th>Archivo Adjunto</th>
                <th>Calificación</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var tarea in Model)
            {
                <tr>
                    <td>@tarea.Titulo</td>
                    <td>@tarea.Descripcion</td>
                    <td>@tarea.FechaEntrega.ToString("dd/MM/yyyy")</td>
                    <td>
                        @if (!string.IsNullOrEmpty(tarea.ArchivoAdjunto))
                        {
                            <a href="@Url.Content(tarea.ArchivoAdjunto)" target="_blank">Ver archivo</a>
                        }
                        else
                        {
                            <span>No disponible</span>
                        }
                    </td>
                    <td>
                        @if (tarea.Calificacion != null)
                        {
                            <span class="badge @(tarea.Calificacion.calificacion >= 3.0m ? "bg-success" : "bg-danger")">
                                @tarea.Calificacion.calificacion.ToString("0.0")
                            </span>
                            if (!string.IsNullOrEmpty(tarea.Calificacion.comentario))
                            {
                                <br />
                                <small class="text-muted">@tarea.Calificacion.comentario</small>
                            }
                        }
                        else
                        {
                            <span class="badge bg-secondary">Pendiente</span>
                        }
                    </td>
                    <td>
                        @Html.ActionLink("Detalles", "Details", "Tareas", new { id = tarea.IdTarea }, new { @class = "btn btn-info btn-sm", style = "margin-right:5px;" })
                        @Html.ActionLink("Entregar", "SubirEntrega", "Entregas", new { idTarea = tarea.IdTarea }, new { @class = "btn btn-success btn-sm" })
                    </td>
                </tr>
            }
        </tbody>
    </table>
}