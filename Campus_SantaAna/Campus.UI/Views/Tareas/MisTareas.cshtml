@model IEnumerable<Campus.Abstracciones.ModelosUI.TareaDto>

@{
    ViewBag.Title = "Mis Tareas";
    Layout = User.Identity.IsAuthenticated
        ? (User.IsInRole("Administradores") ? "~/Views/Shared/_AdminLayout.cshtml" : "~/Views/Shared/_Layout.cshtml")
        : null;
}

<div class="container mt-4">
    <h2 class="fw-bold mb-4 text-dark"><i class="fas fa-tasks me-2"></i>Mis Tareas Asignadas</h2>


    @if (!Model.Any())
    {
        <div class="alert alert-info shadow-sm">
            <i class="fas fa-info-circle me-2"></i>No tienes tareas asignadas.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var tarea in Model)
            {
                var fechaVencida = tarea.FechaEntrega < DateTime.Now;
                bool tieneEntrega = tarea.Calificacion?.Entrega != null && !string.IsNullOrEmpty(tarea.Calificacion.Entrega.archivo_entregado);

                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card shadow hover-card h-100 border-0">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title text-truncate fw-bold" title="@tarea.Titulo">@tarea.Titulo</h5>
                                <span class="badge @(fechaVencida ? "bg-warning text-dark" : "bg-primary text-white")">
                                    @tarea.FechaEntrega.ToString("dd/MM/yyyy")
                                </span>
                            </div>

                            <p class="card-text text-truncate mb-3" style="max-height: 3rem;" title="@tarea.Descripcion">
                                @tarea.Descripcion
                            </p>

                            <div class="mt-auto d-flex flex-wrap gap-2">
                                <!-- Archivo de la tarea -->
                                @if (!string.IsNullOrEmpty(tarea.ArchivoAdjunto))
                                {
                                    <a href="@Url.Content(tarea.ArchivoAdjunto)" target="_blank" class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-eye me-1"></i>Ver Tarea
                                    </a>
                                }

                                <!-- Entrega del estudiante -->
                                @if (tieneEntrega)
                                {
                                    <a href="@Url.Content(tarea.Calificacion.Entrega.archivo_entregado)" target="_blank" class="btn btn-sm btn-outline-success">
                                        <i class="fas fa-upload me-1"></i>Ver Entrega
                                    </a>
                                }
                                else
                                {
                                    <a href="@Url.Action("SubirEntrega", "Entregas", new { idTarea = tarea.IdTarea })" class="btn btn-sm btn-success">
                                        <i class="fas fa-file-upload me-1"></i>Subir Entrega
                                    </a>
                                }

                                <!-- Calificación -->
                                @if (tarea.Calificacion?.calificacion != null)
                                {
                                    <div class="d-flex align-items-center fw-bold">
                                        <span class="text-dark me-1">Calificación:</span>
                                        <i class="fas fa-star text-warning me-1"></i>
                                        <span>@tarea.Calificacion.calificacion.ToString("0.0")</span>
                                    </div>
                                }
                            </div>

                            <div class="mt-3 d-flex justify-content-end gap-2">
                                <a href="@Url.Action("Details", "Tareas", new { id = tarea.IdTarea })" class="btn btn-sm btn-info" title="Detalles">
                                    <i class="fas fa-info-circle"></i>
                                </a>
                                @if (tieneEntrega)
                                {
                                    <a href="@Url.Action("Delete", "Entregas", new { id = tarea.Calificacion.Entrega.id_entrega })" class="btn btn-sm btn-danger" title="Eliminar Entrega">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    h2.titulo-mis-tareas {
        color: #000; 
    }

    .hover-card {
        border-radius: 12px;
        transition: transform 0.2s, box-shadow 0.25s;
        background: linear-gradient(135deg, #ffffff, #f8f9fa);
    }

        .hover-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 15px 25px rgba(0,0,0,0.15);
        }

    .card-title {
        font-size: 1.1rem;
        color: #343a40;
    }

    .card-text {
        font-size: 0.9rem;
        color: #495057;
    }

    .badge {
        font-size: 0.75rem;
        font-weight: 600;
        padding: 0.35em 0.65em;
    }

    .btn-sm {
        font-size: 0.8rem;
        padding: 0.35rem 0.65rem;
    }

    .text-truncate {
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
    }

    .btn-outline-primary:hover {
        background-color: #0d6efd;
        color: white;
        border-color: #0d6efd;
    }

    .btn-outline-success:hover {
        background-color: #198754;
        color: white;
        border-color: #198754;
    }
</style>

