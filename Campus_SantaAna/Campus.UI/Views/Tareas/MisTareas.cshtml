@model IEnumerable<Campus.Abstracciones.ModelosUI.TareaDto>

@{
    ViewBag.Title = "Mis Tareas";
    if (User.Identity.IsAuthenticated)
    {
        if (User.IsInRole("Administradores"))
        {
            Layout = "~/Views/Shared/_AdminLayout.cshtml";
        }
        else
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
        }
    }
}

<div class="container mt-4">
    <div class="card shadow-lg">
        <div class="card-header bg-primary text-white">
            <h2 class="h4 mb-0"><i class="fas fa-tasks me-2"></i>Mis Tareas Asignadas</h2>
        </div>

        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="alert alert-info mb-0">
                    <i class="fas fa-info-circle me-2"></i>No tienes tareas asignadas.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th><i class="fas fa-heading me-2"></i>Título</th>
                                <th><i class="fas fa-align-left me-2"></i>Descripción</th>
                                <th><i class="fas fa-calendar-alt me-2"></i>Fecha Entrega</th>
                                <th><i class="fas fa-paperclip me-2"></i>Archivo</th>
                                <th><i class="fas fa-star me-2"></i>Calificación</th>
                                <th><i class="fas fa-cogs me-2"></i>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var tarea in Model)
                            {
                                <tr>
                                    <td class="fw-bold">@tarea.Titulo</td>
                                    <td class="text-truncate" style="max-width: 200px;" title="@tarea.Descripcion">@tarea.Descripcion</td>
                                    <td>
                                        <span class="badge @(tarea.FechaEntrega < DateTime.Now ? "bg-warning text-dark" : "bg-light text-dark")">
                                            @tarea.FechaEntrega.ToString("dd/MM/yyyy")
                                        </span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(tarea.ArchivoAdjunto))
                                        {
                                            <a href="@Url.Content(tarea.ArchivoAdjunto)" target="_blank" class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-eye me-1"></i>Ver
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted">No disponible</span>
                                        }
                                    </td>
                                    <td>
                                        @if (tarea.Calificacion != null)
                                        {
                                            <div class="d-flex flex-column">
                                                <span class="badge @(tarea.Calificacion.calificacion >= 3.0m ? "bg-success" : "bg-danger")">
                                                    @tarea.Calificacion.calificacion.ToString("0.0")
                                                </span>
                                                @if (!string.IsNullOrEmpty(tarea.Calificacion.comentario))
                                                {
                                                    <small class="text-muted mt-1" style="font-size: 0.8rem;">
                                                        <i class="fas fa-comment me-1"></i>@tarea.Calificacion.comentario
                                                    </small>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Pendiente</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <a href="@Url.Action("Details", "Tareas", new { id = tarea.IdTarea })" class="btn btn-sm btn-info" title="Detalles">
                                                <i class="fas fa-info-circle"></i>
                                            </a>

                                            <a href="@Url.Action("SubirEntrega", "Entregas", new { idTarea = tarea.IdTarea })" class="btn btn-sm btn-success" title="Entregar">
                                                <i class="fas fa-file-upload"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="card-footer bg-light">
            <small class="text-muted"><i class="fas fa-info-circle me-1"></i>Total de tareas: @Model.Count()</small>
        </div>
    </div>
</div>

<style>
    .card {
        border: none;
        border-radius: 12px;
        overflow: hidden;
    }

    .card-header {
        border-radius: 12px 12px 0 0 !important;
    }

    .table th {
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 0.5px;
        border-top: none;
    }

    .table-hover tbody tr:hover {
        background-color: rgba(13, 110, 253, 0.05);
    }

    .text-truncate {
        max-width: 200px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .badge {
        padding: 0.35em 0.65em;
        font-size: 0.75em;
        font-weight: 600;
    }

    .btn-sm {
        padding: 0.25rem 0.5rem;
        font-size: 0.75rem;
    }
</style>