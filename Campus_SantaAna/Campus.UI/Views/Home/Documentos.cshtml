@{
    if (User.Identity.IsAuthenticated)
    {
        if (User.IsInRole("Administradores"))
        {
            Layout = "~/Views/Shared/_AdminLayout.cshtml";
        }
        else
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
        }
    }
    ViewBag.Title = "Documentos";
}

<main class="documentos-main">
    <div class="container-fluid px-4">
        <!-- Header Section -->
        <div class="page-header">
            <div class="header-content">
                <div class="header-text">
                    <h1 class="page-title">
                        <i class="fas fa-folder-open"></i>
                        Documentos y Normativas
                    </h1>
                    <p class="page-subtitle">Gestiona y consulta documentos importantes del centro educativo</p>
                </div>
                @if (User.IsInRole("Administradores"))
                {
                    <div class="header-actions">
                        <button class="btn-add-document" data-bs-toggle="modal" data-bs-target="#agregarDocumentoModal">
                            <i class="fas fa-plus-circle"></i>
                            <span>Agregar Documento</span>
                        </button>
                    </div>
                }
            </div>
        </div>

        <!-- Documentos Oficiales (Fijos) -->
        <div class="documents-section">
            <div class="section-header">
                <div class="section-title-wrapper">
                    <i class="fas fa-star section-icon"></i>
                    <h2 class="section-title">Documentos Oficiales</h2>
                </div>
                <span class="section-badge">Documentos Institucionales</span>
            </div>

            <div class="row g-4 mb-5">
                <!-- Normativa Interna -->
                <div class="col-12 col-lg-6" data-aos="fade-up">
                    <div class="document-card official-doc">
                        <div class="document-badge">
                            <i class="fas fa-certificate"></i>
                            <span>Oficial</span>
                        </div>
                        <div class="document-header">
                            <div class="document-icon normativa">
                                <i class="fas fa-file-contract"></i>
                            </div>
                            <div class="document-info">
                                <h3 class="document-title">Normativa Interna</h3>
                                <p class="document-meta">
                                    <i class="far fa-calendar-alt"></i>
                                    <span>Actualizado 2025</span>
                                </p>
                            </div>
                        </div>
                        <div class="document-body">
                            <p class="document-description">
                                Consulta las reglas y lineamientos internos del centro educativo.
                                Este documento contiene todas las normativas vigentes para el correcto funcionamiento institucional.
                            </p>

                        </div>
                        <div class="document-footer">
                            <div class="qr-container">
                                <img src="/Home/GenerarQR?url=https://santaana.ed.cr/normativa/"
                                     alt="QR Normativa" class="qr-code">
                                <span class="qr-label">Escanea para ver</span>
                            </div>
                            <div class="document-actions">
                                <a href="https://santaana.ed.cr/normativa/"
                                   class="btn-document btn-primary"
                                   target="_blank">
                                    <i class="fas fa-external-link-alt"></i>
                                    Ver Documento
                                </a>
                                <button class="btn-document btn-secondary" onclick="compartirDocumento('Normativa Interna', 'https://santaana.ed.cr/normativa/')">
                                    <i class="fas fa-share-alt"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Reglamento de Evaluación -->
                <div class="col-12 col-lg-6" data-aos="fade-up" data-aos-delay="100">
                    <div class="document-card official-doc">
                        <div class="document-badge">
                            <i class="fas fa-certificate"></i>
                            <span>Oficial</span>
                        </div>
                        <div class="document-header">
                            <div class="document-icon reglamento">
                                <i class="fas fa-clipboard-check"></i>
                            </div>
                            <div class="document-info">
                                <h3 class="document-title">Reglamento de Evaluación</h3>
                                <p class="document-meta">
                                    <i class="far fa-calendar-alt"></i>
                                    <span>Actualizado 2025</span>
                                </p>
                            </div>
                        </div>
                        <div class="document-body">
                            <p class="document-description">
                                Revisa los criterios y procesos de evaluación vigentes.
                                Incluye lineamientos sobre calificaciones, exámenes y evaluación continua del desempeño estudiantil.
                            </p>

                        </div>
                        <div class="document-footer">
                            <div class="qr-container">
                                <img src="/Home/GenerarQR?url=https://santaana.ed.cr/reglamento/"
                                     alt="QR Reglamento" class="qr-code">
                                <span class="qr-label">Escanea para ver</span>
                            </div>
                            <div class="document-actions">
                                <a href="https://santaana.ed.cr/reglamento/"
                                   class="btn-document btn-primary"
                                   target="_blank">
                                    <i class="fas fa-external-link-alt"></i>
                                    Ver Documento
                                </a>
                                <button class="btn-document btn-secondary" onclick="compartirDocumento('Reglamento de Evaluación', 'https://santaana.ed.cr/reglamento/')">
                                    <i class="fas fa-share-alt"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Documentos Adicionales -->
        <div class="documents-section">
            <div class="section-header">
                <div class="section-title-wrapper">
                    <i class="fas fa-folder section-icon"></i>
                    <h2 class="section-title">Documentos Adicionales</h2>
                </div>
                @using System.Linq
                <span class="section-badge">
                    @(ViewBag.DocumentosAdicionales != null ? ((IEnumerable<object>)ViewBag.DocumentosAdicionales).Count() : 0) Documentos
                </span>
            </div>

            <div class="row g-4" id="documentosAdicionalesContainer">
                @* Aquí se renderizarán los documentos adicionales *@
                @if (ViewBag.DocumentosAdicionales != null && ((IEnumerable<dynamic>)ViewBag.DocumentosAdicionales).Any())
                {
                    foreach (var doc in ViewBag.DocumentosAdicionales)
                    {
                        <div class="col-12 col-md-6 col-xl-4" data-aos="fade-up">
                            <div class="document-card">
                                <div class="document-header">
                                    <div class="document-icon adicional">
                                        <i class="fas fa-file-alt"></i>
                                    </div>
                                    <div class="document-info">
                                        <h3 class="document-title">@doc.Titulo</h3>
                                        <p class="document-meta">
                                            <i class="far fa-calendar-alt"></i>
                                            <span>@doc.FechaRegistro.ToString("dd/MM/yyyy")</span>
                                        </p>
                                    </div>
                                    @if (User.IsInRole("Administradores"))
                                    {
                                        <div class="document-menu">
                                            <button class="btn-menu" onclick="toggleMenu(this)">
                                                <i class="fas fa-ellipsis-v"></i>
                                            </button>
                                            <div class="menu-dropdown">
                                                <a href="#" onclick="editarDocumento(this, @doc.Id)">
                                                    <i class="fas fa-edit"></i> Editar
                                                </a>

                                                <a href="#" onclick="confirmarEliminar(@doc.Id)">
                                                    <i class="fas fa-trash"></i> Eliminar
                                                </a>

                                            </div>
                                        </div>
                                    }
                                </div>
                                <div class="document-body">
                                    <p class="document-description">@doc.Descripcion</p>
                                </div>
                                <div class="document-footer">
                                    <div class="document-actions full-width">
                                        <a href="@doc.RutaArchivo"
                                           class="btn-document btn-primary"
                                           target="_blank">
                                            <i class="fas fa-external-link-alt"></i>
                                            Ver Documento
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12">
                        <div class="empty-state">
                            <div class="empty-icon">
                                <i class="fas fa-folder-open"></i>
                            </div>
                            <h3>No hay documentos adicionales</h3>
                            <p>Los documentos que se agreguen aparecerán aquí</p>
                            @if (User.IsInRole("Administradores"))
                            {
                                <button class="btn-add-document" data-bs-toggle="modal" data-bs-target="#agregarDocumentoModal">
                                    <i class="fas fa-plus-circle"></i>
                                    <span>Agregar Primer Documento</span>
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</main>

<!-- Modal Agregar Documento -->
<div class="modal fade" id="agregarDocumentoModal" tabindex="-1" aria-labelledby="agregarDocumentoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="agregarDocumentoLabel">
                    <i class="fas fa-file-upload me-2"></i>
                    Agregar Nuevo Documento
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formAgregarDocumento" method="post" action="@Url.Action("AgregarDocumento", "Home")" enctype="multipart/form-data">
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="tituloDocumento" class="form-label">
                            <i class="fas fa-heading"></i> Título del Documento
                        </label>
                        <input type="text" class="form-control" id="tituloDocumento" name="Titulo" required
                               placeholder="Ej: Manual de Convivencia">
                    </div>
                    <div class="mb-3">
                        <label for="descripcionDocumento" class="form-label">
                            <i class="fas fa-align-left"></i> Descripción
                        </label>
                        <textarea class="form-control" id="descripcionDocumento" name="Descripcion" rows="3" required
                                  placeholder="Describe brevemente el contenido del documento"></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="archivoDocumento" class="form-label">
                            <i class="fas fa-file-upload"></i> Archivo del Documento
                        </label>
                        <input type="file" class="form-control" id="archivoDocumento" name="Archivo" required
                               accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx">
                        <div class="form-text">
                            Formatos permitidos: PDF, Word, Excel, PowerPoint (Máx. 10MB)
                        </div>
                        <div id="archivoPreview" class="file-preview mt-2" style="display: none;">
                            <div class="file-preview-item">
                                <i class="fas fa-file-pdf file-preview-icon"></i>
                                <div class="file-preview-info">
                                    <span class="file-preview-name"></span>
                                    <span class="file-preview-size"></span>
                                </div>
                                <button type="button" class="btn-remove-file" onclick="removerArchivo()">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="categoriaDocumento" class="form-label">
                            <i class="fas fa-tag"></i> Categoría
                        </label>
                        <select class="form-select" id="categoriaDocumento" name="Categoria">
                            <option value="Normativa">Normativa</option>
                            <option value="Reglamento">Reglamento</option>
                            <option value="Manual">Manual</option>
                            <option value="Guía">Guía</option>
                            <option value="Circular">Circular</option>
                            <option value="Formato">Formato</option>
                            <option value="Otro">Otro</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times"></i> Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Guardar Documento
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
<div class="modal fade" id="editarDocumentoModal" tabindex="-1" aria-labelledby="editarDocumentoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editarDocumentoLabel">
                    <i class="fas fa-edit me-2"></i>
                    Editar Documento
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formEditarDocumento" method="post" action="@Url.Action("EditarDocumento", "Home")" enctype="multipart/form-data">
                <input type="hidden" id="editIdDocumento" name="idDocumento">
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="editTituloDocumento" class="form-label">
                            <i class="fas fa-heading"></i> Título del Documento
                        </label>
                        <input type="text" class="form-control" id="editTituloDocumento" name="Titulo" required
                               placeholder="Ej: Manual de Convivencia">
                    </div>
                    <div class="mb-3">
                        <label for="editDescripcionDocumento" class="form-label">
                            <i class="fas fa-align-left"></i> Descripción
                        </label>
                        <textarea class="form-control" id="editDescripcionDocumento" name="Descripcion" rows="3" required
                                  placeholder="Describe brevemente el contenido del documento"></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="editArchivoDocumento" class="form-label">
                            <i class="fas fa-file-upload"></i> Archivo del Documento
                        </label>
                        <input type="file" class="form-control" id="editArchivoDocumento" name="Archivo"
                               accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx">
                        <div class="form-text">
                            <i class="fas fa-info-circle"></i> Deja vacío si no deseas cambiar el archivo actual. Formatos permitidos: PDF, Word, Excel, PowerPoint (Máx. 10MB)
                        </div>
                        <div id="editArchivoActual" class="file-current mt-2" style="display: none;">
                            <div class="alert alert-info d-flex align-items-center gap-2 mb-0">
                                <i class="fas fa-file-alt"></i>
                                <div class="flex-grow-1">
                                    <strong>Archivo actual:</strong>
                                    <span id="editArchivoActualNombre"></span>
                                </div>
                            </div>
                        </div>
                        <div id="editArchivoPreview" class="file-preview mt-2" style="display: none;">
                            <div class="file-preview-item">
                                <i class="fas fa-file-pdf file-preview-icon"></i>
                                <div class="file-preview-info">
                                    <span class="file-preview-name"></span>
                                    <span class="file-preview-size"></span>
                                </div>
                                <button type="button" class="btn-remove-file" onclick="removerArchivoEditar()">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="editCategoriaDocumento" class="form-label">
                            <i class="fas fa-tag"></i> Categoría
                        </label>
                        <select class="form-select" id="editCategoriaDocumento" name="Categoria">
                            <option value="Normativa">Normativa</option>
                            <option value="Reglamento">Reglamento</option>
                            <option value="Manual">Manual</option>
                            <option value="Guía">Guía</option>
                            <option value="Circular">Circular</option>
                            <option value="Formato">Formato</option>
                            <option value="Otro">Otro</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times"></i> Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Guardar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section scripts{
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            AOS.init({
                duration: 800,
                once: true
            });
        });

        function compartirDocumento(titulo, url) {
            if (navigator.share) {
                navigator.share({
                    title: titulo,
                    url: url
                }).catch(err => console.log('Error al compartir:', err));
            } else {
                // Fallback: copiar al portapapeles
                navigator.clipboard.writeText(url);
                alert('Link copiado al portapapeles');
            }
        }

        function toggleMenu(button) {
            const menu = button.nextElementSibling;
            menu.classList.toggle('show');

            // Cerrar otros menús abiertos
            document.querySelectorAll('.menu-dropdown.show').forEach(m => {
                if (m !== menu) m.classList.remove('show');
            });
        }

        // Cerrar menús al hacer clic fuera
        document.addEventListener('click', function (e) {
            if (!e.target.closest('.document-menu')) {
                document.querySelectorAll('.menu-dropdown.show').forEach(m => {
                    m.classList.remove('show');
                });
            }
        });

       function editarDocumento(btn, id) {

    document.getElementById('editIdDocumento').value = id;

    const documentCard = btn.closest('.document-card');
    if (!documentCard) return;

    document.getElementById('editTituloDocumento').value =
        documentCard.querySelector('.document-title').textContent;

    document.getElementById('editDescripcionDocumento').value =
        documentCard.querySelector('.document-description').textContent;

    document.getElementById('editCategoriaDocumento').value = 'Otro';

    const rutaArchivo = documentCard
        .querySelector('.btn-document.btn-primary')
        ?.getAttribute('href');

    if (rutaArchivo) {
        document.getElementById('editArchivoActualNombre').textContent =
            rutaArchivo.split('/').pop();
        document.getElementById('editArchivoActual').style.display = 'block';
    }

    new bootstrap.Modal(
        document.getElementById('editarDocumentoModal')
    ).show();
}



        function eliminarDocumento(id) {
            if (confirm('¿Estás seguro de que deseas eliminar este documento?')) {
                // Implementar lógica de eliminación
                console.log('Eliminar documento:', id);
            }
        }

        // Preview de archivo seleccionado
        document.getElementById('archivoDocumento')?.addEventListener('change', function (e) {
            const file = e.target.files[0];
            if (file) {
                const preview = document.getElementById('archivoPreview');
                const fileName = preview.querySelector('.file-preview-name');
                const fileSize = preview.querySelector('.file-preview-size');
                const icon = preview.querySelector('.file-preview-icon');

                // Cambiar icono según el tipo de archivo
                const ext = file.name.split('.').pop().toLowerCase();
                const iconMap = {
                    'pdf': 'fa-file-pdf',
                    'doc': 'fa-file-word',
                    'docx': 'fa-file-word',
                    'xls': 'fa-file-excel',
                    'xlsx': 'fa-file-excel',
                    'ppt': 'fa-file-powerpoint',
                    'pptx': 'fa-file-powerpoint'
                };

                icon.className = 'fas ' + (iconMap[ext] || 'fa-file') + ' file-preview-icon';
                fileName.textContent = file.name;
                fileSize.textContent = formatFileSize(file.size);
                preview.style.display = 'block';
            }
        });

        function removerArchivo() {
            document.getElementById('archivoDocumento').value = '';
            document.getElementById('archivoPreview').style.display = 'none';
        }

        function formatFileSize(bytes) {
            if (bytes === 0) return '0 Bytes';
            const k = 1024;
            const sizes = ['Bytes', 'KB', 'MB', 'GB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return Math.round(bytes / Math.pow(k, i) * 100) / 100 + ' ' + sizes[i];
        }
        // Función para cargar datos del documento en el modal de edición
        function editarDocumento(id) {
            // Buscar el documento en el DOM para obtener sus datos
            const documentCard = event.target.closest('.document-card');
            if (!documentCard) return;

            const titulo = documentCard.querySelector('.document-title').textContent;
            const descripcion = documentCard.querySelector('.document-description').textContent;
            const rutaArchivo = documentCard.querySelector('.btn-document.btn-primary').getAttribute('href');

            // Cargar los datos en el formulario
            document.getElementById('editIdDocumento').value = id;
            document.getElementById('editTituloDocumento').value = titulo;
            document.getElementById('editDescripcionDocumento').value = descripcion;

            // Intentar obtener la categoría (si está disponible en el DOM)
            // Por defecto, establecer en "Otro"
            document.getElementById('editCategoriaDocumento').value = 'Otro';

            // Mostrar archivo actual
            if (rutaArchivo) {
                const archivoActual = document.getElementById('editArchivoActual');
                const archivoActualNombre = document.getElementById('editArchivoActualNombre');
                const nombreArchivo = rutaArchivo.split('/').pop();
                archivoActualNombre.textContent = nombreArchivo || 'documento_actual';
                archivoActual.style.display = 'block';
            }

            // Limpiar preview de nuevo archivo
            document.getElementById('editArchivoPreview').style.display = 'none';
            document.getElementById('editArchivoDocumento').value = '';

            // Abrir el modal
            const modal = new bootstrap.Modal(document.getElementById('editarDocumentoModal'));
            modal.show();
        }

        // Preview de archivo seleccionado en el modal de edición
        document.getElementById('editArchivoDocumento')?.addEventListener('change', function (e) {
            const file = e.target.files[0];
            if (file) {
                // Validar tamaño (10MB máximo)
                if (file.size > 10485760) {
                    alert('El archivo es demasiado pesado. Máximo 10MB permitido.');
                    this.value = '';
                    return;
                }

                const preview = document.getElementById('editArchivoPreview');
                const fileName = preview.querySelector('.file-preview-name');
                const fileSize = preview.querySelector('.file-preview-size');
                const icon = preview.querySelector('.file-preview-icon');

                // Validar extensión
                const ext = file.name.split('.').pop().toLowerCase();
                const extensionesPermitidas = ['pdf', 'doc', 'docx', 'xls', 'xlsx', 'ppt', 'pptx'];

                if (!extensionesPermitidas.includes(ext)) {
                    alert('Tipo de archivo no permitido. Solo se aceptan: PDF, Word, Excel, PowerPoint');
                    this.value = '';
                    return;
                }

                // Cambiar icono según el tipo de archivo
                const iconMap = {
                    'pdf': 'fa-file-pdf',
                    'doc': 'fa-file-word',
                    'docx': 'fa-file-word',
                    'xls': 'fa-file-excel',
                    'xlsx': 'fa-file-excel',
                    'ppt': 'fa-file-powerpoint',
                    'pptx': 'fa-file-powerpoint'
                };

                icon.className = 'fas ' + (iconMap[ext] || 'fa-file') + ' file-preview-icon';
                fileName.textContent = file.name;
                fileSize.textContent = formatFileSize(file.size);
                preview.style.display = 'block';

                // Ocultar el archivo actual
                document.getElementById('editArchivoActual').style.display = 'none';
            }
        });

        function removerArchivoEditar() {
            document.getElementById('editArchivoDocumento').value = '';
            document.getElementById('editArchivoPreview').style.display = 'none';
            document.getElementById('editArchivoActual').style.display = 'block';
        }

        // Limpiar el formulario al cerrar el modal
        document.getElementById('editarDocumentoModal')?.addEventListener('hidden.bs.modal', function () {
            document.getElementById('formEditarDocumento').reset();
            document.getElementById('editArchivoPreview').style.display = 'none';
            document.getElementById('editArchivoActual').style.display = 'none';
        });

        // Validación del formulario antes de enviar
        document.getElementById('formEditarDocumento')?.addEventListener('submit', function (e) {
            const titulo = document.getElementById('editTituloDocumento').value.trim();
            const descripcion = document.getElementById('editDescripcionDocumento').value.trim();

            if (!titulo || !descripcion) {
                e.preventDefault();
                alert('Por favor, completa todos los campos requeridos.');
                return false;
            }

            // Mostrar indicador de carga
            const submitBtn = this.querySelector('button[type="submit"]');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Guardando...';
        });

        function confirmarEliminar(id) {
    if (confirm('¿Estás segura de que deseas eliminar este documento?')) {
