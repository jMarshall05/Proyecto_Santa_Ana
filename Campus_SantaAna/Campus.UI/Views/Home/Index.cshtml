@model IEnumerable<Campus.Abstracciones.ModelosUI.CursoDto>
@{
    if (User.Identity.IsAuthenticated)
    {
        if (User.IsInRole("Administradores"))
        {
            Layout = "~/Views/Shared/_AdminLayout.cshtml";
        }
        else
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
        }
    }

    ViewBag.Title = "Bienvenidos a Santa Ana a un Click";
}

@* Diccionario de imágenes de materias *@
@{
    var imageMap = new Dictionary<string, string>
{
        {"Matemáticas", "https://cdn-icons-png.freepik.com/256/13576/13576532.png"},
        {"Estudios Sociales", "https://cdn-icons-png.freepik.com/256/2436/2436874.png"},
        {"Español", "https://cdn-icons-png.freepik.com/256/2784/2784403.png"},
        {"Ciencias", "https://cdn-icons-png.freepik.com/256/1126/1126012.png"},
        {"Inglés", "https://cdn-icons-png.freepik.com/256/299/299688.png"},
        {"Física", "https://cdn-icons-png.freepik.com/256/4727/4727266.png"}
    };
    string defaultImage = "https://cdn-icons-png.freepik.com/256/13576/13576532.png";
}

<main class="main-content">
    @if (User.Identity.IsAuthenticated)
    {
        if (User.IsInRole("Profesores") || User.IsInRole("Estudiantes"))
        {
            <div class="section-header">
                <p class="lead">Mis Cursos</p>
            </div>
            <div class="row cursos-grid">
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <div class="col-12 col-sm-6 col-lg-4 col-xl-3 mb-4">
                            <div class="card curso-card text-center h-100">
                                <div class="card-img-container">
                                    <img src="@(imageMap.ContainsKey(item.NombreMateria) ? imageMap[item.NombreMateria] : defaultImage)"
                                         class="card-img-top"
                                         alt="@item.NombreMateria" />
                                </div>
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title">@item.NombreMateria | @item.NombreGrupo</h5>
                                    <p class="card-text">Profesor: @item.NombreProfesor</p>
                                    @if (User.IsInRole("Profesores"))
                                    {
                                        <a href="@Url.Action("ListarTareas", "Tareas", new { materiaId = item.MateriaId, grupoId = item.GrupoId })" class="btn btn-primary btn-curso">Ver Curso</a>
                                    }
                                    else if (User.IsInRole("Estudiantes"))
                                    {
                                        <a href="@Url.Action("MisTareas", "Tareas", new { materiaId = item.MateriaId, grupoId = item.GrupoId })" class="btn btn-primary btn-curso">Ver Curso</a>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center py-5">
                        <div class="no-courses-message">
                            <i class="fas fa-book-open mb-3" style="font-size: 3rem; color: #0D126E; opacity: 0.5;"></i>
                            <h4>No tienes cursos asignados</h4>
                            <p class="text-muted">Actualmente no hay cursos disponibles para mostrar.</p>
                        </div>
                    </div>
                }
            </div>
        }
        else if (User.IsInRole("Administradores"))
        {
            <div class="admin-dashboard-wrapper">
                <!-- Header de Bienvenida -->
                <div class="welcome-section mb-4">
                    <div class="welcome-card">
                        <div class="welcome-icon">
                            <i class="fas fa-tachometer-alt"></i>
                        </div>
                        <div class="welcome-content">
                            <h2 class="welcome-title">Panel de Administración</h2>
                            <p class="welcome-subtitle">Bienvenido al sistema de gestión de Santa Ana</p>
                        </div>
                    </div>
                </div>

                <!-- Tarjetas de Métricas -->
                <div class="metrics-section mb-4">
                    <div class="row g-3">
                        <div class="col-12 col-sm-6 col-lg-6">
                            <div class="metric-card metric-students">
                                <div class="metric-icon-wrapper">
                                    <i class="fas fa-user-graduate"></i>
                                </div>
                                <div class="metric-details">
                                    <h3 class="metric-title">Total de Estudiantes</h3>
                                    <p class="metric-value">@(ViewBag.Estudiantes ?? 0)</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-lg-6">
                            <div class="metric-card metric-teachers">
                                <div class="metric-icon-wrapper">
                                    <i class="fas fa-chalkboard-teacher"></i>
                                </div>
                                <div class="metric-details">
                                    <h3 class="metric-title">Total de Profesores</h3>
                                    <p class="metric-value">@(ViewBag.Profesores ?? 0)</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Acciones Principales -->
                <div class="actions-section">
                    <h4 class="section-heading mb-3">
                        <i class="fas fa-bolt me-2"></i>
                        Acciones Rápidas
                    </h4>
                    <div class="row g-3 mb-4">
                        <div class="col-12 col-sm-6 col-lg-3">
                            <a href="@Url.Action("ListarTareas", "Tareas")" class="action-link">
                                <div class="action-card-modern action-primary">
                                    <div class="action-icon-circle">
                                        <i class="fas fa-tasks"></i>
                                    </div>
                                    <h5 class="action-label">Asignar Tarea</h5>
                                    <p class="action-desc">Crear y asignar tareas</p>
                                </div>
                            </a>
                        </div>
                        <div class="col-12 col-sm-6 col-lg-3">
                            <a href="@Url.Action("Index", "Entregas")" class="action-link">
                                <div class="action-card-modern action-info">
                                    <div class="action-icon-circle">
                                        <i class="fas fa-inbox"></i>
                                    </div>
                                    <h5 class="action-label">Tareas Recibidas</h5>
                                    <p class="action-desc">Revisar entregas</p>
                                </div>
                            </a>
                        </div>
                        <div class="col-12 col-sm-6 col-lg-3">
                            <a href="@Url.Action("ListarUsuarios", "Usuarios")" class="action-link">
                                <div class="action-card-modern action-warning">
                                    <div class="action-icon-circle">
                                        <i class="fas fa-users-cog"></i>
                                    </div>
                                    <h5 class="action-label">Gestionar Usuarios</h5>
                                    <p class="action-desc">Administrar usuarios</p>
                                </div>
                            </a>
                        </div>
                        <div class="col-12 col-sm-6 col-lg-3">
                            <a href="@Url.Action("ListarCursos", "Cursos")" class="action-link">
                                <div class="action-card-modern action-success">
                                    <div class="action-icon-circle">
                                        <i class="fas fa-book"></i>
                                    </div>
                                    <h5 class="action-label">Configurar Cursos</h5>
                                    <p class="action-desc">Administrar cursos</p>
                                </div>
                            </a>
                        </div>
                    </div>

                    <!-- Segunda fila de acciones -->
                    <div class="row g-3 justify-content-center">

                        <div class="col-12 col-sm-6 col-lg-3">
                            <a href="@Url.Action("About", "Home")" class="action-link">
                                <div class="action-card-modern action-pink">
                                    <div class="action-icon-circle">
                                        <i class="fas fa-calendar-alt"></i>
                                    </div>
                                    <h5 class="action-label">Calendario</h5>
                                    <p class="action-desc">Eventos y fechas</p>
                                </div>
                            </a>
                        </div>
                        <div class="col-12 col-sm-6 col-lg-3">
                            <a href="@Url.Action("Documentos", "Home")" class="action-link">
                                <div class="action-card-modern action-orange">
                                    <div class="action-icon-circle">
                                        <i class="fas fa-file-alt"></i>
                                    </div>
                                    <h5 class="action-label">Documentos</h5>
                                    <p class="action-desc">Gestionar archivos</p>
                                </div>
                            </a>
                        </div>
                        <div class="col-12 col-sm-6 col-lg-3">
                            <a href="@Url.Action("ListarAnuncios", "Anuncios")" class="action-link">
                                <div class="action-card-modern action-red">
                                    <div class="action-icon-circle">
                                        <i class="fas fa-bullhorn"></i>
                                    </div>
                                    <h5 class="action-label">Anuncios</h5>
                                    <p class="action-desc">Publicar comunicados</p>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</main>

@section scripts{
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
}

<style>
    /* Variables */
    :root {
        --primary: #0D126E;
        --primary-dark: #090d4a;
        --primary-light: #1a237e;
        --white: #ffffff;
        --gray-50: #f8f9fa;
        --gray-100: #f1f3f5;
        --gray-200: #e9ecef;
        --gray-300: #dee2e6;
        --gray-600: #6c757d;
        --gray-800: #343a40;
        --shadow-sm: 0 2px 4px rgba(0,0,0,0.08);
        --shadow-md: 0 4px 8px rgba(0,0,0,0.1);
        --shadow-lg: 0 8px 16px rgba(0,0,0,0.12);
        --shadow-xl: 0 12px 24px rgba(0,0,0,0.15);
    }

    /* Layout Principal */
    .main-content {
        padding: 1.5rem;
        min-height: calc(100vh - 80px);
        background: var(--gray-100);
    }

    .admin-dashboard-wrapper {
        max-width: 1400px;
        margin: 0 auto;
    }

    /* Sección de Bienvenida */
    .welcome-section {
        margin-bottom: 1.5rem;
    }

    .welcome-card {
        background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
        padding: 1.75rem 2rem;
        border-radius: 16px;
        box-shadow: var(--shadow-lg);
        display: flex;
        align-items: center;
        gap: 1.5rem;
    }

    .welcome-icon {
        width: 70px;
        height: 70px;
        background: rgba(255, 255, 255, 0.15);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        color: white;
        flex-shrink: 0;
    }

    .welcome-content {
        flex: 1;
    }

    .welcome-title {
        font-size: 1.75rem;
        font-weight: 700;
        color: white;
        margin: 0 0 0.25rem 0;
    }

    .welcome-subtitle {
        font-size: 1rem;
        color: rgba(255, 255, 255, 0.9);
        margin: 0;
    }

    /* Tarjetas de Métricas */
    .metrics-section {
        margin-bottom: 2rem;
    }

    .metric-card {
        background: white;
        border-radius: 16px;
        padding: 1.75rem;
        box-shadow: var(--shadow-md);
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 1.25rem;
        height: 100%;
        border-left: 4px solid transparent;
    }

        .metric-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-xl);
        }

    .metric-students {
        border-left-color: #667eea;
    }

    .metric-teachers {
        border-left-color: #f093fb;
    }

    .metric-icon-wrapper {
        width: 70px;
        height: 70px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        flex-shrink: 0;
    }

    .metric-students .metric-icon-wrapper {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }

    .metric-teachers .metric-icon-wrapper {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        color: white;
    }

    .metric-details {
        flex: 1;
    }

    .metric-title {
        font-size: 0.95rem;
        color: var(--gray-600);
        margin: 0 0 0.5rem 0;
        font-weight: 500;
    }

    .metric-value {
        font-size: 2.5rem;
        font-weight: 700;
        color: var(--gray-800);
        margin: 0;
        line-height: 1;
    }

    /* Sección de Acciones */
    .actions-section {
        margin-top: 2rem;
    }

    .section-heading {
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--gray-800);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .action-link {
        text-decoration: none;
        display: block;
        height: 100%;
    }

    .action-card-modern {
        background: white;
        border-radius: 16px;
        padding: 1.75rem 1.5rem;
        text-align: center;
        box-shadow: var(--shadow-md);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        height: 100%;
        min-height: 180px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
    }

        .action-card-modern::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: currentColor;
            transform: scaleX(0);
            transition: transform 0.3s ease;
        }

        .action-card-modern:hover {
            transform: translateY(-6px);
            box-shadow: var(--shadow-xl);
        }

            .action-card-modern:hover::before {
                transform: scaleX(1);
            }

    .action-icon-circle {
        width: 70px;
        height: 70px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.75rem;
        margin-bottom: 1rem;
        transition: all 0.3s ease;
    }

    .action-card-modern:hover .action-icon-circle {
        transform: scale(1.1) rotate(5deg);
    }

    .action-primary {
        color: #667eea;
    }

        .action-primary .action-icon-circle {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

    .action-info {
        color: #4facfe;
    }

        .action-info .action-icon-circle {
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
            color: white;
        }

    .action-warning {
        color: #fa709a;
    }

        .action-warning .action-icon-circle {
            background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
            color: white;
        }

    .action-success {
        color: #30cfd0;
    }

        .action-success .action-icon-circle {
            background: linear-gradient(135deg, #30cfd0 0%, #330867 100%);
            color: white;
        }

    .action-purple {
        color: #a8edea;
    }

        .action-purple .action-icon-circle {
            background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
            color: #333;
        }

    .action-pink {
        color: #ff9a9e;
    }

        .action-pink .action-icon-circle {
            background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%);
            color: white;
        }

    .action-orange {
        color: #ffecd2;
    }

        .action-orange .action-icon-circle {
            background: linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%);
            color: #333;
        }

    .action-red {
        color: #ff6e7f;
    }

        .action-red .action-icon-circle {
            background: linear-gradient(135deg, #ff6e7f 0%, #bfe9ff 100%);
            color: white;
        }

    .action-label {
        font-size: 1.05rem;
        font-weight: 600;
        color: var(--gray-800);
        margin: 0 0 0.5rem 0;
    }

    .action-desc {
        font-size: 0.875rem;
        color: var(--gray-600);
        margin: 0;
    }

    /* Cursos (Profesores/Estudiantes) */
    .section-header .lead {
        font-size: 1.5rem;
        font-weight: 600;
        color: var(--gray-800);
        margin-bottom: 1.5rem;
    }

    .curso-card {
        background: white;
        border: none;
        border-radius: 16px;
        box-shadow: var(--shadow-md);
        transition: all 0.3s ease;
    }

        .curso-card:hover {
            transform: translateY(-6px);
            box-shadow: var(--shadow-xl);
        }

    .card-img-container {
        padding: 1.5rem 1.5rem 0;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 160px;
        background: var(--gray-50);
        border-radius: 16px 16px 0 0;
    }

    .card-img-top {
        width: 100px;
        height: 100px;
        object-fit: contain;
        transition: transform 0.3s ease;
    }

    .curso-card:hover .card-img-top {
        transform: scale(1.1);
    }

    .card-body {
        padding: 1.5rem;
    }

    .card-title {
        font-size: 1.05rem;
        font-weight: 600;
        color: var(--gray-800);
        margin-bottom: 0.75rem;
    }

    .card-text {
        color: var(--gray-600);
        font-size: 0.9rem;
        margin-bottom: 1rem;
    }

    .btn-curso {
        background: linear-gradient(135deg, var(--primary), var(--primary-light));
        border: none;
        border-radius: 25px;
        padding: 0.625rem 1.5rem;
        color: white;
        font-weight: 500;
        transition: all 0.3s ease;
        width: 100%;
    }

        .btn-curso:hover {
            background: linear-gradient(135deg, var(--primary-light), #283593);
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(13, 18, 110, 0.3);
            color: white;
        }

    .no-courses-message {
        padding: 3rem 2rem;
    }

    /* Responsivo */
    @@media (max-width: 576px) {
        .main-content {
            padding: 1rem;
        }

        .welcome-card {
            flex-direction: column;
            text-align: center;
            padding: 1.5rem;
        }

        .welcome-title {
            font-size: 1.4rem;
        }

        .welcome-subtitle {
            font-size: 0.9rem;
        }

        .metric-card {
            flex-direction: column;
            text-align: center;
            padding: 1.5rem;
        }

        .metric-icon-wrapper {
            width: 60px;
            height: 60px;
            font-size: 1.75rem;
        }

        .metric-value {
            font-size: 2rem;
        }

        .action-card-modern {
            min-height: 160px;
            padding: 1.5rem 1rem;
        }

        .action-icon-circle {
            width: 60px;
            height: 60px;
            font-size: 1.5rem;
        }

        .section-heading {
            font-size: 1.1rem;
        }
    }

    @@media (min-width: 577px) and (max-width: 768px) {
        .metric-value {
            font-size: 2.2rem;
        }

        .action-card-modern {
            min-height: 170px;
        }
    }

    @@media (min-width: 992px) {
        .main-content {
            padding: 2rem;
        }

        .welcome-card {
            padding: 2rem 2.5rem;
        }

        .metric-value {
            font-size: 2.8rem;
        }

        .action-card-modern {
            min-height: 190px;
        }
    }

    /* Utilidades */
    .g-3 {
        --bs-gutter-x: 1rem;
        --bs-gutter-y: 1rem;
    }

    /* Animaciones */
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .metric-card,
    .action-card-modern {
        animation: fadeInUp 0.5s ease-out backwards;
    }

        .metric-card:nth-child(1) {
            animation-delay: 0.1s;
        }

        .metric-card:nth-child(2) {
            animation-delay: 0.2s;
        }

        .action-card-modern:nth-of-type(1) {
            animation-delay: 0.1s;
        }

        .action-card-modern:nth-of-type(2) {
            animation-delay: 0.15s;
        }

        .action-card-modern:nth-of-type(3) {
            animation-delay: 0.2s;
        }

        .action-card-modern:nth-of-type(4) {
            animation-delay: 0.25s;
        }

        .action-card-modern:nth-of-type(5) {
            animation-delay: 0.3s;
        }

        .action-card-modern:nth-of-type(6) {
            animation-delay: 0.35s;
        }

        .action-card-modern:nth-of-type(7) {
            animation-delay: 0.4s;
        }

        .action-card-modern:nth-of-type(8) {
            animation-delay: 0.45s;
        }
</style>