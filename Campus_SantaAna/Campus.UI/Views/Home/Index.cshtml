@model IEnumerable<Campus.Abstracciones.ModelosUI.CursoDto>
@{
    ViewBag.Title = "Bienvenidos a Santa Ana a un Click";
}
@{
    var imageMap = new Dictionary<string, string>
{
        {"Matemáticas", "https://cdn-icons-png.freepik.com/256/13576/13576532.png"},
        {"Estudios Sociales", "https://cdn-icons-png.freepik.com/256/2436/2436874.png"},
        {"Español", "https://cdn-icons-png.freepik.com/256/2784/2784403.png"},
        {"Ciencias", "https://cdn-icons-png.freepik.com/256/1126/1126012.png"},
        {"Inglés", "https://cdn-icons-png.freepik.com/256/299/299688.png"},
        {"Física", "https://cdn-icons-png.freepik.com/256/4727/4727266.png"}
    };
    string defaultImage = "https://cdn-icons-png.freepik.com/256/13576/13576532.png";
}
<main>
    <section class="row" aria-labelledby="aspnetTitle">
    </section>
    @if (User.Identity.IsAuthenticated)
    {
        if (User.IsInRole("Profesores") || User.IsInRole("Estudiantes"))
        {<p class="lead">Mis Cursos</p>
            <div class="row">
                @foreach (var item in Model)
                {

                    <section class="col-md-4 mb-4" aria-labelledby="gettingStartedTitle">
                        <div class="card text-center">
                            <img src="@(imageMap.ContainsKey(item.NombreMateria) ? imageMap[item.NombreMateria] : defaultImage)"
                                 class="card-img-top mx-auto mt-3"
                                 alt="..."
                                 style="width: 120px; height: 120px; object-fit: contain;" />
                            <div class="card-body">
                                <h5 class="card-title">@item.NombreMateria | @item.NombreGrupo</h5>
                                <p class="card-text">Profesor: @item.NombreProfesor  </p>
                                @if (User.IsInRole("Profesores"))
                                {
                                    <a href="@Url.Action("ListarTareas", "Tareas", new { grupoId = item.GrupoId })" class="btn btn-primary">Ver Curso</a>
                                }
                                else if (User.IsInRole("Estudiantes"))
                                {
                                    <a href="@Url.Action("MisTareas", "Tareas")" class="btn btn-primary">Ver Curso</a>
                                }
                            </div>
                        </div>
                    </section>
                }
            </div>
        }
        else if (User.IsInRole("Administradores"))
        {
            <div class="row justify-content-center">
                <div class="col-md-8">
                    <div class="card">
                        <div class="card-body text-center">
                            <div class="mb-4">
                                <i class="fas fa-user-shield fa-5x text-primary"></i>
                            </div>
                            <h2 class="card-title">Panel de Administración</h2>
                            <p class="card-text lead">
                                Como administrador, tienes acceso a funciones especiales de gestión del sistema.
                            </p>
                            <p class="card-text">
                                Los cursos son gestionados por profesores . Utiliza el panel de administración
                                para gestionar usuarios, configuraciones del sistema y supervisar la plataforma.
                            </p>
                            <div class="row justify-content-center">
                                <a href="@Url.Action("ListarUsuarios", "Usuarios")" class="btn btn-primary btn-lg">
                                    <i class="fas fa-user"></i> Gestionar Usuarios
                                </a>
                                <a href="@Url.Action("ListarCursos", "Cursos")" class="btn btn-outline-secondary btn-lg me-3">
                                    <i class="fas fa-graduation-cap"></i> Administrar Cursos
                                </a>
                                <a href="@Url.Action("ListarGrupos", "Grupos")" class="btn btn-primary btn-lg">
                                    <i class="fas fa-users"></i> Administrar Grupos
                                </a>
                                <a href="@Url.Action("ListarAnuncios", "Anuncios")" class="btn btn-outline-secondary btn-lg">
                                    <i class="fas fa-bell"></i> Administrar Anuncios
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</main>