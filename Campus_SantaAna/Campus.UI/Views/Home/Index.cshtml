@model IEnumerable<Campus.Abstracciones.ModelosUI.CursoDto>
@{
    if (User.Identity.IsAuthenticated)
    {
        if (User.IsInRole("Administradores"))
        {
            Layout = "~/Views/Shared/_AdminLayout.cshtml";
        }
        else
        {
            Layout = "~/Views/Shared/_Layout.cshtml"; // tu layout normal
        }
    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml"; // si no está logueado
    }

    ViewBag.Title = "Bienvenidos a Santa Ana a un Click";
}

@* Diccionario de imágenes de materias *@
@{
    var imageMap = new Dictionary<string, string>
{
        {"Matemáticas", "https://cdn-icons-png.freepik.com/256/13576/13576532.png"},
        {"Estudios Sociales", "https://cdn-icons-png.freepik.com/256/2436/2436874.png"},
        {"Español", "https://cdn-icons-png.freepik.com/256/2784/2784403.png"},
        {"Ciencias", "https://cdn-icons-png.freepik.com/256/1126/1126012.png"},
        {"Inglés", "https://cdn-icons-png.freepik.com/256/299/299688.png"},
        {"Física", "https://cdn-icons-png.freepik.com/256/4727/4727266.png"}
    };
    string defaultImage = "https://cdn-icons-png.freepik.com/256/13576/13576532.png";
}

<main class="main-content">
    @if (User.Identity.IsAuthenticated)
    {
        if (User.IsInRole("Profesores") || User.IsInRole("Estudiantes"))
        {
            <div class="section-header">
                <p class="lead">Mis Cursos</p>
            </div>
            <div class="row cursos-grid">
                @foreach (var item in Model)
                {
                    <div class="col-12 col-sm-6 col-lg-4 col-xl-3 mb-4">
                        <div class="card curso-card text-center h-100">
                            <div class="card-img-container">
                                <img src="@(imageMap.ContainsKey(item.NombreMateria) ? imageMap[item.NombreMateria] : defaultImage)"
                                     class="card-img-top"
                                     alt="@item.NombreMateria" />
                            </div>
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">@item.NombreMateria | @item.NombreGrupo</h5>
                                <p class="card-text">Profesor: @item.NombreProfesor</p>
                                <div class="mt-auto">
                                    @if (User.IsInRole("Profesores"))
                                    {
                                        <a href="@Url.Action("ListarTareas", "Tareas", new { grupoId = item.GrupoId })" class="btn btn-primary btn-curso">Ver Curso</a>
                                    }
                                    else
                                    {
                                        <a href="@Url.Action("MisTareas", "Tareas")" class="btn btn-primary btn-curso">Ver Curso</a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else if (User.IsInRole("Administradores"))
        {
            <div class="admin-dashboard">
                <div class="cards-container">
                    <div class="row g-3 mb-5">
                        <div class="col-12 col-md-6 col-lg-3">
                            <div class="card-info">
                                <h3>Total de Estudiantes</h3>
                                <p class="card-number">150</p>
                            </div>
                        </div>
                        <div class="col-12 col-md-6 col-lg-3">
                            <div class="card-info">
                                <h3>Total de Profesores</h3>
                                <p class="card-number">25</p>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-md-6 col-lg-3">
                            <a href="@Url.Action("ListarTareas", "Tareas")" class="card-info card-link">
                                <div class="card-link-content">
                                    <h3>Asignar Tarea</h3>
                                    <i class="fas fa-tasks card-icon"></i>
                                </div>
                            </a>
                        </div>
                        <div class="col-12 col-md-6 col-lg-3">
                            <a href="@Url.Action("Index", "Entregas")" class="card-info card-link">
                                <div class="card-link-content">
                                    <h3>Tareas Recibidas</h3>
                                    <i class="fas fa-inbox card-icon"></i>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</main>

@section scripts{
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
}

<style>
    /* Estilos base responsivos */
    .main-content {
        padding: 20px;
        min-height: calc(100vh - 120px);
    }

    .section-header {
        margin-bottom: 2rem;
    }

        .section-header .lead {
            font-size: 1.5rem;
            font-weight: 600;
            color: #333;
            margin-bottom: 0;
        }

    /* Grid de cursos responsivo */
    .cursos-grid {
        display: flex;
        flex-wrap: wrap;
        margin: 0 -10px;
    }

    .curso-card {
        border: 1px solid #e0e0e0;
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        height: 100%;
    }

        .curso-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 15px rgba(0, 0, 0, 0.15);
        }

    .card-img-container {
        padding: 20px 20px 0;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 160px;
    }

    .card-img-top {
        width: 120px;
        height: 120px;
        object-fit: contain;
        transition: transform 0.3s ease;
    }

    .curso-card:hover .card-img-top {
        transform: scale(1.05);
    }

    .card-body {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
    }

    .card-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: #333;
        margin-bottom: 0.75rem;
        line-height: 1.3;
    }

    .card-text {
        color: #666;
        font-size: 0.95rem;
        margin-bottom: 1rem;
    }

    .btn-curso {
        background: linear-gradient(135deg, #0D126E, #1a237e);
        border: none;
        border-radius: 25px;
        padding: 0.5rem 1.5rem;
        font-weight: 500;
        transition: all 0.3s ease;
        width: 100%;
        max-width: 200px;
    }

        .btn-curso:hover {
            background: linear-gradient(135deg, #1a237e, #283593);
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(13, 18, 110, 0.3);
        }

    /* Dashboard de administrador responsivo */
    .admin-dashboard {
        padding: 1rem 0;
    }

    .cards-container {
        width: 100%;
    }

    .card-info {
        background: linear-gradient(135deg, #0D126E, #1a237e);
        color: white;
        padding: 2rem 1.5rem;
        border-radius: 16px;
        text-align: center;
        height: 100%;
        min-height: 140px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

        .card-info:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 15px rgba(0, 0, 0, 0.2);
        }

        .card-info h3 {
            font-size: 1.1rem;
            font-weight: 500;
            margin-bottom: 0.75rem;
            line-height: 1.3;
        }

    .card-number {
        font-size: 2rem;
        font-weight: 700;
        margin: 0;
        color: #fff;
    }

    .card-link {
        text-decoration: none;
        display: block;
        height: 100%;
    }

        .card-link:hover {
            text-decoration: none;
            color: white;
        }

    .card-link-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
    }

    .card-icon {
        font-size: 2rem;
        margin-top: 0.5rem;
        opacity: 0.9;
    }

    /* Media Queries para responsividad */
    @@media (max-width: 576px) {
        .main-content {
            padding: 15px 10px;
        }

        .section-header .lead {
            font-size: 1.3rem;
            text-align: center;
        }

        .card-img-container {
            height: 140px;
            padding: 15px 15px 0;
        }

        .card-img-top {
            width: 100px;
            height: 100px;
        }

        .card-body {
            padding: 1.25rem;
        }

        .card-title {
            font-size: 1rem;
        }

        .card-info {
            padding: 1.5rem 1rem;
            min-height: 120px;
        }

            .card-info h3 {
                font-size: 1rem;
            }

        .card-number {
            font-size: 1.75rem;
        }

        .card-icon {
            font-size: 1.75rem;
        }
    }

    @@media (min-width: 577px) and (max-width: 768px) {
        .main-content {
            padding: 20px 15px;
        }

        .card-img-container {
            height: 150px;
        }

        .card-info {
            padding: 1.75rem 1.25rem;
        }
    }

    @@media (min-width: 769px) and (max-width: 992px) {
        .card-title {
            font-size: 1.05rem;
        }
    }

    @@media (min-width: 1200px) {
        .main-content {
            padding: 30px;
        }

        .cursos-grid {
            margin: 0 -15px;
        }
    }

    /* Utilidades responsivas */
    .row.g-3 {
        --bs-gutter-x: 1rem;
        --bs-gutter-y: 1rem;
    }

    /* Asegurar que las tarjetas tengan la misma altura en cada fila */
    .curso-card .card-body {
        flex: 1;
    }

    /* Mejoras de accesibilidad */
    .btn:focus,
    .card-link:focus {
        outline: 2px solid #0D126E;
        outline-offset: 2px;
    }

    /* Animaciones suaves */
    .card-info,
    .curso-card,
    .btn-curso {
        transition: all 0.3s ease-in-out;
    }
</style>