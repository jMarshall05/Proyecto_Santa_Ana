@using Microsoft.AspNet.Identity
@{
    Layout = User.IsInRole("Administradores") ? "~/Views/Shared/_AdminLayout.cshtml" : "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Calendario";
}

<main class="container py-4">
    <h2 class="text-center mb-4">📅 Calendario de Eventos</h2>
    <div class="card shadow-lg p-4">
        <div id="calendar"></div>
    </div>
</main>

<input type="hidden" id="idUsuario" value="@User.Identity.GetUserId()" />

<!-- Modal Crear Evento -->
<div class="modal fade" id="modalCrearEvento" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 shadow">
            <form id="formCrearEvento">
                <div class="modal-header bg-primary text-white rounded-top-4">
                    <h5 class="modal-title">➕ Agregar Evento</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="form-floating mb-3">
                        <input type="text" class="form-control" id="titulo" placeholder="Título del evento" required>
                        <label for="titulo">Título del evento</label>
                    </div>
                    <input type="hidden" id="fecha" />
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success w-100">💾 Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Editar/Eliminar -->
<div class="modal fade" id="modalEditarEliminar" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 shadow">
            <div class="modal-header bg-warning text-dark rounded-top-4">
                <h5 class="modal-title">📝 Editar o 🗑️ Desactivar Evento</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="eventoId">
                <div class="form-floating mb-3">
                    <input type="text" class="form-control" id="nuevoTitulo">
                    <label for="nuevoTitulo">Editar título</label>
                </div>
                <div class="d-flex justify-content-between">
                    <button id="btnGuardarCambios" class="btn btn-success w-50 me-2">💾 Guardar</button>
                    <button id="btnEliminarEvento" class="btn btn-danger w-50 ms-2">🗑️ Desactivar</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const calendarEl = document.getElementById('calendar');
            const modalCrear = new bootstrap.Modal(document.getElementById('modalCrearEvento'));
            const modalEditarEliminar = new bootstrap.Modal(document.getElementById('modalEditarEliminar'));
            const formCrear = document.getElementById('formCrearEvento');
            let eventoSeleccionado = null;

            const calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                height: 'auto',
                headerToolbar: { left: 'prev,next today', center: 'title', right: '' },
                dateClick: function (info) {
                    document.getElementById('fecha').value = info.dateStr;
                    formCrear.reset();
                    modalCrear.show();
                },
                eventClick: function (info) {
                    eventoSeleccionado = info.event;
                    document.getElementById('eventoId').value = info.event.id;
                    document.getElementById('nuevoTitulo').value = info.event.title;
                    modalEditarEliminar.show();
                },
                events: '/Eventos/ObtenerEventos',

              
                eventContent: function (arg) {
                    return { html: '<span>' + arg.event.title + '</span>' };
                }
            });

           
            document.getElementById('modalCrearEvento').addEventListener('shown.bs.modal', function () {
                document.getElementById('titulo').focus();
            });

            // Crear evento
            formCrear.addEventListener('submit', function (e) {
                e.preventDefault();
                const titulo = document.getElementById('titulo').value;
                const fecha = document.getElementById('fecha').value;
                const idUsuario = document.getElementById('idUsuario').value;

                fetch('/Eventos/AgregarEvento', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'titulo=' + encodeURIComponent(titulo) +
                        '&fecha=' + encodeURIComponent(fecha) +
                        '&idUsuario=' + encodeURIComponent(idUsuario)
                })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            modalCrear.hide();
                            calendar.refetchEvents();
                        } else {
                            alert('Error al crear evento: ' + data.message);
                        }
                    });
            });

            // Editar evento
            document.getElementById('btnGuardarCambios').onclick = function () {
                const nuevoTitulo = document.getElementById('nuevoTitulo').value;
                fetch('/Eventos/EditarEvento', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'id=' + encodeURIComponent(eventoSeleccionado.id) +
                        '&titulo=' + encodeURIComponent(nuevoTitulo) +
                        '&fecha=' + encodeURIComponent(eventoSeleccionado.startStr) +
                        '&idUsuario=' + encodeURIComponent(document.getElementById('idUsuario').value)
                })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            eventoSeleccionado.setProp('title', nuevoTitulo);
                            modalEditarEliminar.hide();
                        } else {
                            alert('Error al editar evento: ' + data.message);
                        }
                    });
            };

            // Eliminar evento
            document.getElementById('btnEliminarEvento').onclick = function () {
                if (!eventoSeleccionado) return;
                fetch('/Eventos/EliminarEvento', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'id=' + encodeURIComponent(eventoSeleccionado.id)
                })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            eventoSeleccionado.remove();
                            modalEditarEliminar.hide();
                        } else {
                            alert('Error al eliminar evento: ' + data.message);
                        }
                    });
            };

            calendar.render();
        });
    </script>
}
