@using Microsoft.AspNet.Identity
@{
    Layout = User.IsInRole("Administradores")
        ? "~/Views/Shared/_AdminLayout.cshtml"
        : "~/Views/Shared/_Layout.cshtml";

    ViewBag.Title = "Calendario";
}

<style>
    /* Contenedor general más grande */
    main.container {
        max-width: 1200px;
        animation: fadeIn 0.4s ease-in-out;
    }

    /* Título principal en negro */
    h2.text-center {
        color: #000; /* Negro */
        font-size: 2.3rem;
        font-weight: 800;
        letter-spacing: -0.5px;
    }

    /* --- CALENDARIO MÁS PEQUEÑO --- */
    #calendar {
        max-width: 850px;
        margin: 0 auto;
    }

    /* Tarjeta */
    .card {
        background: rgba(255, 255, 255, 0.9);
        border-radius: 22px;
        border: none;
        padding: 30px !important;
        backdrop-filter: blur(12px);
        box-shadow: 0 10px 30px rgba(0, 40, 120, 0.18);
        transition: 0.3s ease;
    }

        .card:hover {
            transform: translateY(-3px);
            box-shadow: 0 14px 38px rgba(0, 40, 120, 0.28);
        }

    /* FullCalendar */
    .fc .fc-toolbar-title {
        font-size: 2rem;
        font-weight: 900;
        color: #1e3a8a;
        text-transform: capitalize; /* Mes con mayúscula inicial */
    }

    .fc .fc-button {
        background: #1d4ed8 !important;
        border: none !important;
        color: white !important;
        border-radius: 10px !important;
        padding: 8px 14px !important;
        font-size: 1rem !important;
        font-weight: 600;
        transition: 0.2s ease;
    }

        .fc .fc-button:hover {
            background: #1e40af !important;
            transform: scale(1.07);
        }

    .fc .fc-daygrid-day-number {
        font-weight: 700;
        font-size: 1rem;
        color: #1e3a8a;
    }

    .fc-daygrid-day-frame {
        background: #f0f6ff;
    }

    /* Eventos */
    .fc-event {
        padding: 6px 8px !important;
        border-radius: 10px !important;
        font-weight: 700 !important;
        font-size: 0.95rem !important;
        background: linear-gradient(135deg, #1d4ed8, #3b82f6) !important;
        border: none !important;
        color: white !important;
        box-shadow: 0 3px 8px rgba(0, 60, 160, 0.25);
        transition: 0.2s ease;
    }

        .fc-event:hover {
            transform: scale(1.05);
            background: linear-gradient(135deg, #1e40af, #2563eb) !important;
            box-shadow: 0 5px 14px rgba(0, 60, 160, 0.35);
        }

    /* --- MODALES --- */
    .modal-content {
        border-radius: 20px !important;
        border: none;
        background: #fff; /* Fondo blanco por defecto */
        color: #333;
        box-shadow: 0 10px 25px rgba(0, 40, 120, 0.3);
    }

    /* Solo header celeste */
    .modal-header {
        background: #3498db !important;
        color: white !important;
        border-bottom: none;
        border-radius: 20px 20px 0 0;
    }

    .modal-body, .modal-footer {
        background: #fff !important;
        color: #333 !important;
    }

    /* Botón cerrar */
    .btn-close,
    .btn-close-white {
        filter: brightness(10);
    }

    /* Inputs dentro de modales */
    .form-control {
        border-radius: 12px;
        border: 2px solid #93c5fd;
        background-color: #ffffff;
        color: #333;
    }

        .form-control:focus {
            border-color: #1d4ed8;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.3);
            background-color: #fff;
            color: #333;
            outline: none;
        }

    .form-floating > label {
        color: #000; /* Label negro dentro del modal */
    }

    /* Botones dentro de modales */
    .btn-success {
        background: #3498db;
        color: white;
        font-weight: 700;
        border-radius: 12px;
    }

        .btn-success:hover {
            background: #2563eb;
        }

    .btn-danger {
        border-radius: 12px;
        font-weight: 700;
        background-color: #e74c3c;
        color: white;
    }

        .btn-danger:hover {
            background-color: #c0392b;
        }

    /* Animación fadeIn */
    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>


<!-- ⭐ VISTA ⭐ -->
<main class="container py-4">
    <h2 class="text-center mb-4">📅 Calendario de Eventos</h2>

    <div class="card shadow-lg p-4">
        <div id="calendar"></div>
    </div>
</main>

<input type="hidden" id="idUsuario" value="@User.Identity.GetUserId()" />

<!-- Modal Crear Evento -->
<div class="modal fade" id="modalCrearEvento" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 shadow">
            <form id="formCrearEvento">
                <div class="modal-header bg-primary text-white rounded-top-4">
                    <h5 class="modal-title">➕ Agregar Evento</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="form-floating mb-3">
                        <input type="text" class="form-control" id="titulo" placeholder="Título del evento" required>
                        <label for="titulo">Título del evento</label>
                    </div>
                    <input type="hidden" id="fecha" />
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success w-100">💾 Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Editar/Eliminar -->
<div class="modal fade" id="modalEditarEliminar" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 shadow">
            <div class="modal-header bg-warning text-dark rounded-top-4">
                <h5 class="modal-title">📝 Editar / 🗑️ Eliminar</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="eventoId">
                <div class="form-floating mb-3">
                    <input type="text" class="form-control" id="nuevoTitulo">
                    <label for="nuevoTitulo">Editar título</label>
                </div>
                <div class="d-flex justify-content-between">
                    <button id="btnGuardarCambios" class="btn btn-success w-50 me-2">💾 Guardar</button>
                    <button id="btnEliminarEvento" class="btn btn-danger w-50 ms-2">🗑️ Eliminar</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.js"></script>

    <!-- ⭐ FullCalendar en Español ⭐ -->
    <script>
        FullCalendar.globalLocales.push({
            code: "es",
            buttonText: {
                today: "Hoy",
                month: "Mes",
                week: "Semana",
                day: "Día"
            },
            allDayText: "Todo el día"
        });
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const calendarEl = document.getElementById('calendar');
            const modalCrear = new bootstrap.Modal(document.getElementById('modalCrearEvento'));
            const modalEditarEliminar = new bootstrap.Modal(document.getElementById('modalEditarEliminar'));
            const formCrear = document.getElementById('formCrearEvento');
            let eventoSeleccionado = null;

            const calendar = new FullCalendar.Calendar(calendarEl, {
                locale: 'es',
                initialView: 'dayGridMonth',
                height: 'auto',
                headerToolbar: { left: 'prev,next today', center: 'title', right: '' },

                dateClick: function (info) {
                    document.getElementById('fecha').value = info.dateStr;
                    formCrear.reset();
                    modalCrear.show();
                },

                eventClick: function (info) {
                    eventoSeleccionado = info.event;
                    document.getElementById('eventoId').value = info.event.id;
                    document.getElementById('nuevoTitulo').value = info.event.title;
                    modalEditarEliminar.show();
                },

                events: '/Eventos/ObtenerEventos',

                eventContent: function (arg) {
                    return { html: '<span>' + arg.event.title + '</span>' };
                }
            });

            document.getElementById('modalCrearEvento').addEventListener('shown.bs.modal', function () {
                document.getElementById('titulo').focus();
            });

            // Crear evento
            formCrear.addEventListener('submit', function (e) {
                e.preventDefault();
                const titulo = document.getElementById('titulo').value;
                const fecha = document.getElementById('fecha').value;
                const idUsuario = document.getElementById('idUsuario').value;

                fetch('/Eventos/AgregarEvento', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'titulo=' + encodeURIComponent(titulo) +
                        '&fecha=' + encodeURIComponent(fecha) +
                        '&idUsuario=' + encodeURIComponent(idUsuario)
                })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            modalCrear.hide();
                            calendar.refetchEvents();
                        } else {
                            alert('Error al crear evento: ' + data.message);
                        }
                    });
            });

            // Editar evento
            document.getElementById('btnGuardarCambios').onclick = function () {
                const nuevoTitulo = document.getElementById('nuevoTitulo').value;
                fetch('/Eventos/EditarEvento', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'id=' + encodeURIComponent(eventoSeleccionado.id) +
                        '&titulo=' + encodeURIComponent(nuevoTitulo) +
                        '&fecha=' + encodeURIComponent(eventoSeleccionado.startStr) +
                        '&idUsuario=' + encodeURIComponent(document.getElementById('idUsuario').value)
                })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            eventoSeleccionado.setProp('title', nuevoTitulo);
                            modalEditarEliminar.hide();
                        } else {
                            alert('Error al editar evento: ' + data.message);
                        }
                    });
            };

            // Eliminar evento
            document.getElementById('btnEliminarEvento').onclick = function () {
                if (!eventoSeleccionado) return;
                fetch('/Eventos/EliminarEvento', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'id=' + encodeURIComponent(eventoSeleccionado.id)
                })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            eventoSeleccionado.remove();
                            modalEditarEliminar.hide();
                        } else {
                            alert('Error al eliminar evento: ' + data.message);
                        }
                    });
            };

            calendar.render();
        });
    </script>
}
