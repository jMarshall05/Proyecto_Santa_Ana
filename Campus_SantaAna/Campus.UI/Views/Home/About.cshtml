@{
    if (User.Identity.IsAuthenticated)
    {
        if (User.IsInRole("Administradores"))
        {
            Layout = "~/Views/Shared/_AdminLayout.cshtml";
        }
        else
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
        }
    }
    ViewBag.Title = "Calendario";

}

<main aria-labelledby="title" class="container py-4">
    <h2 id="title" class="text-center mb-4">📅 Calendario de Eventos</h2>

    <div class="card shadow-lg p-4">
        <div id="calendar"></div>
    </div>
</main>

<!-- Modal para crear evento -->
<div class="modal fade" id="modalCrearEvento" tabindex="-1" aria-labelledby="modalCrearEventoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 shadow">
            <form id="formCrearEvento">
                <div class="modal-header bg-primary text-white rounded-top-4">
                    <h5 class="modal-title" id="modalCrearEventoLabel">➕ Agregar Evento</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="form-floating mb-3">
                        <input type="text" class="form-control" id="titulo" name="titulo" placeholder="Título del evento" required>
                        <label for="titulo">Título del evento</label>
                    </div>
                    <input type="hidden" id="fecha" name="fecha" />
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success w-100">💾 Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal para editar/eliminar evento -->
<div class="modal fade" id="modalEditarEliminar" tabindex="-1" aria-labelledby="modalEditarEliminarLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 shadow">
            <div class="modal-header bg-warning text-dark rounded-top-4">
                <h5 class="modal-title" id="modalEditarEliminarLabel">📝 Editar o 🗑️ Eliminar Evento</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="eventoId">
                <div class="form-floating mb-3">
                    <input type="text" class="form-control" id="nuevoTitulo" placeholder="Nuevo título del evento">
                    <label for="nuevoTitulo">Editar título</label>
                </div>
                <div class="d-flex justify-content-between">
                    <button id="btnGuardarCambios" class="btn btn-success w-50 me-2">💾 Guardar</button>
                    <button id="btnEliminarEvento" class="btn btn-danger w-50 ms-2">🗑️ Eliminar</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal de confirmación para eliminar evento -->
<div class="modal fade" id="modalConfirmarEliminar" tabindex="-1" aria-labelledby="modalConfirmarEliminarLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 shadow">
            <div class="modal-header bg-danger text-white rounded-top-4">
                <h5 class="modal-title" id="modalConfirmarEliminarLabel">🗑️ Confirmar eliminación</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p>¿Estás seguro de que deseas eliminar este evento?</p>
            </div>
            <div class="modal-footer">
                <button id="btnConfirmarEliminar" class="btn btn-danger">Sí, eliminar</button>
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <!-- FullCalendar y Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const calendarEl = document.getElementById('calendar');
            const modalCrear = new bootstrap.Modal(document.getElementById('modalCrearEvento'));
            const modalEditarEliminar = new bootstrap.Modal(document.getElementById('modalEditarEliminar'));
            const modalConfirmarEliminar = new bootstrap.Modal(document.getElementById('modalConfirmarEliminar'));
            const formCrear = document.getElementById('formCrearEvento');

            let eventoSeleccionado = null; 

            const calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                height: 'auto',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: ''
                },
                dateClick: function (info) {
                    document.getElementById('fecha').value = info.dateStr;
                    formCrear.reset();
                    modalCrear.show();
                },
                eventClick: function (info) {
                    const evento = info.event;
                    eventoSeleccionado = evento;

                    document.getElementById('eventoId').value = evento.id;
                    document.getElementById('nuevoTitulo').value = evento.title;
                    modalEditarEliminar.show();
                },
                events: '/Eventos/ObtenerEventos'
            });

            // Guardar cambios del evento
            document.getElementById('btnGuardarCambios').onclick = function () {
                const nuevoTitulo = document.getElementById('nuevoTitulo').value;

                fetch('/Eventos/EditarEvento', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id: eventoSeleccionado.id, titulo: nuevoTitulo, fecha: eventoSeleccionado.startStr })
                })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            eventoSeleccionado.setProp('title', nuevoTitulo);
                            modalEditarEliminar.hide();
                        }
                    });
            };

            // Abrir modal de confirmación
            document.getElementById('btnEliminarEvento').onclick = function () {
                modalConfirmarEliminar.show();
            };

            // Confirmar eliminación 
            document.getElementById('btnConfirmarEliminar').onclick = function () {
                fetch('/Eventos/EliminarEvento', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'id=' + encodeURIComponent(eventoSeleccionado.id)
                })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            eventoSeleccionado.remove();
                            modalConfirmarEliminar.hide();
                            modalEditarEliminar.hide();
                        } else {
                            alert('Error al eliminar evento.');
                        }
                    });
            };

            // Crear nuevo evento
            formCrear.addEventListener('submit', function (e) {
                e.preventDefault();
                const titulo = document.getElementById('titulo').value;
                const fecha = document.getElementById('fecha').value;

                fetch('/Eventos/AgregarEvento', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ titulo: titulo, fecha: fecha })
                })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            modalCrear.hide();
                            calendar.refetchEvents(); 
                        }
                    });
            });


            calendar.render();
        });
    </script>
}
