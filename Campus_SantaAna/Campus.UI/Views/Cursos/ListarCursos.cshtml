@model IEnumerable<Campus.Abstracciones.ModelosUI.CursoDto>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="card shadow-lg border-0 rounded-3">
    <!-- Header estilizado -->
    <div class="card-header bg-gradient bg-primary text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="fas fa-book-open me-2"></i>Lista de Cursos</h5>
        <div>
            <button class="btn btn-sm btn-light btn-Agregar-Curso mx-1" data-bs-toggle="tooltip" title="Agregar nuevo curso">
                <i class="fas fa-plus me-1"></i> Agregar Curso
            </button>
            <button class="btn btn-sm btn-outline-light btn-GenerarReporte mx-1" data-bs-toggle="tooltip" title="Generar reporte">
                <i class="fas fa-file-alt me-1"></i> Generar Reporte
            </button>
        </div>
    </div>

    <div class="card-body">
        <!-- Tabla con estilo -->
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-primary">
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.IdCurso)</th>
                        <th>@Html.DisplayNameFor(model => model.MateriaId)</th>
                        <th>@Html.DisplayNameFor(model => model.GrupoId)</th>
                        <th>@Html.DisplayNameFor(model => model.ProfesorId)</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.IdCurso)</td>
                            <td>@Html.DisplayFor(modelItem => item.NombreMateria)</td>
                            <td>@Html.DisplayFor(modelItem => item.NombreGrupo)</td>
                            <td>@Html.DisplayFor(modelItem => item.NombreProfesor)</td>
                            <td class="text-center">
                                @using (Html.BeginForm("EliminarCurso", "Cursos", new { id = item.IdCurso }, FormMethod.Post, new { style = "display:inline;" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger"
                                            onclick="return confirm('¿Está seguro que desea eliminar este curso?')">
                                        <i class="fas fa-trash me-1"></i> Borrar
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="CursosModal" tabindex="-1" aria-labelledby="CursosModalTittleLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content shadow-lg border-0 rounded-3">
            <div class="modal-header bg-primary text-white">
                <h1 class="modal-title fs-5" id="UCursosModalTittleLabel">Agregar</h1>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body"></div>
            <div class="modal-footer"></div>
        </div>
    </div>
</div>

@section scripts{
    <script src="~/Scripts/Cursos/ScriptDeCursos.js"></script>
}
